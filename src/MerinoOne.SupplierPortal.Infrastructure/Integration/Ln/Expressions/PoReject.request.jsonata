/* R12 — LN PO_Update contract. Header-only like PoAccept.request.jsonata — see that file for the
   2026-08-06 Lines[] removal rationale (LN now rejects the un-quantified line node; header-only proven
   live) and the D7 "[object Object]" hazard.

   Remarks — the portal-typed rejection reason (RejectPoCommand.Body.Reason, mandatory ≤1000, folded into
   the document as responseContext.reason). Mapped since 2026-08-06, mirroring the live row's edit; this
   retires the old "reason is NOT on the wire" note (R12 §5). */
{
    "PurchaseOrderDetail": {
        "CompanyCode": companyCode,
        "OrderNo": poNumber,
        "PlannedDeliveryDate": headerDeliveryDate != null ? headerDeliveryDate,
        "ConfirmedReceiptDate": headerDeliveryDate != null ? headerDeliveryDate,
        "POStatus": "Rejected",
        "Remarks": responseContext.reason
    }
}
