/* R16.1 (2026-08-11) — the fresh ASN mapping, replacing the R11.2 INTERIM stub. The id trio the user
   confirmed against IDM: id1 = the SUPPLIER ERP code (BUS…), id2 = the portal ASN number, id3 = the LN
   ASNNo written back by /inbound/erp-ack (asn.erpCode). Company slots keep the portal company code
   (== what LN acks as erpCompany, user-confirmed identical); MDS_AccountingEntity keeps its company suffix. */
{
  "headers": {
    "Content-Type": "application/json",
    "X-Infor-LnCompany": asn.logisticCompany
  },
  "body": {
    "item": {
      "attrs": { "attr": [
        { "name": "MDS_EntityType",       "value": entityType },
        { "name": "MDS_AccountingEntity", "value": "infor.ln." & asn.financialCompany },
        { "name": "MDS_id1",              "value": asn.supplier.erpCode },
        { "name": "MDS_id2",              "value": asn.asnNumber },
        { "name": "MDS_id3",              "value": asn.erpCode }
      ]},
      "resrs": { "res": [ { "filename": attachment.filename, "base64": attachment.base64 } ] },
      "acl": { "name": "Public" },
      "entityName": "MDS_GenericDocument",
      "pid": pid
    }
  }
}
