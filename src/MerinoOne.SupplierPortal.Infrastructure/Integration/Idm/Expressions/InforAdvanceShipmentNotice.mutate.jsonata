/* R16.1 (2026-08-11) — mirrors .create exactly; only the runtime `pid` differs (an Update carries the real
   IDM pid). Kept in lockstep on purpose: ASN documents DO get Update ops enqueued after the Create — both
   /inbound/erp-ack (UpsertErpAckCommand) and the LN dispatcher call EnqueueOwnerUpdatesAsync for Asn — so a
   Mutate on an older attr shape would rewrite the attrs of the pushed item and drop MDS_id2/MDS_id3. */
{
  "headers": {
    "Content-Type": "application/json",
    "X-Infor-LnCompany": asn.logisticCompany
  },
  "body": {
    "item": {
      "attrs": { "attr": [
        { "name": "MDS_EntityType",       "value": entityType },
        { "name": "MDS_AccountingEntity", "value": "infor.ln." & asn.financialCompany },
        { "name": "MDS_id1",              "value": asn.supplier.erpCode },
        { "name": "MDS_id2",              "value": asn.asnNumber },
        { "name": "MDS_id3",              "value": asn.erpCode }
      ]},
      "resrs": { "res": [ { "filename": attachment.filename, "base64": attachment.base64 } ] },
      "acl": { "name": "Public" },
      "entityName": "MDS_GenericDocument",
      "pid": pid
    }
  }
}
