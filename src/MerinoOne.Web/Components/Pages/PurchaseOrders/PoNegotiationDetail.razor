@code {
    private const string BuyerRoute = "po-negotiation-review";
    private const string SupplierRoute = "po-negotiations";

    [Parameter] public Guid Id { get; set; }

    private PoNegotiationDto? detail;
    private bool loading = true;
    private bool busy;

    // R18 (2026-11-04) — the Id the current `detail` was loaded for, and the route base (BuyerRoute / SupplierRoute) the
    // page was opened on, which every round link and the post-counter navigation stay on.
    private Guid loadedId;
    private string routeBase = SupplierRoute;

    private bool showApprove;
    private bool showReject;
    private bool showAccept;
    private bool showDecline;
    private string reasonText = string.Empty;
    private string actionError = string.Empty;

    // R18 (2026-11-04) — counter editor state. `edits` is keyed by PurchaseOrderLineId and seeded from THIS round's
    // effective values when the editor opens; on submit only the lines that differ from them are sent.
    private bool countering;
    private string counterNotes = string.Empty;
    private string counterError = string.Empty;
    private Dictionary<Guid, CounterEdit> edits = new();

    private bool CanReview => Token.HasPermission("PurchaseOrder.ApproveNegotiation");
    private bool CanNegotiate => Token.HasPermission("PurchaseOrder.Negotiate");

    // R18 (2026-11-04) — whose move it is: the buyer answers an open SUPPLIER round, the supplier an open BUYER round, so
    // the two are mutually exclusive even for a user holding both permissions.
    private bool CanBuyerAct => detail is not null && CanReview && PoNegotiationStatus.IsBuyerActionable(detail.NegotiationStatus, detail.ProposedBy);
    private bool CanSupplierAct => detail is not null && CanNegotiate && PoNegotiationStatus.IsSupplierActionable(detail.NegotiationStatus, detail.ProposedBy);

    // The header actions stay disabled while a request is in flight and while the counter editor is open.
    private bool ActionsLocked => busy || countering;

    // The DTO lists EVERY PO line (so the grid shows the whole order); only the ones the round actually changed from the
    // PO are IsChanged. ChangedCount (IsChanged = differs from the PO) feeds the header's "N lines proposed", never
    // Lines.Count; the lines card's "N changed" is MovedCount below, which follows the round's own baseline.
    private int ChangedCount => detail?.Lines.Count(l => l.IsChanged) ?? 0;

    // A reviewer arrives from the review queue; a supplier (no ApproveNegotiation) from its own change-request list.
    private string BackHref => CanReview ? BuyerRoute : SupplierRoute;
    private string BackLabel => CanReview ? "Back to PO negotiations" : "Back to PO change requests";

    // R18 (2026-11-04) — round 1 is diffed against the live PO line (Original*); a counter round against the round it
    // answered (PreviousRound*, the parent round's effective values), with the PO kept for reference. The change
    // highlight, the row tint / chip and the "changed" count all read the same baseline.
    private bool IsCounterRound => detail is { RoundNo: >= 2 };
    private decimal BaselineQty(PoNegotiationLineDto ln) => IsCounterRound ? (ln.PreviousRoundQty ?? ln.OriginalQty) : ln.OriginalQty;
    private DateTime? BaselineDate(PoNegotiationLineDto ln) => IsCounterRound ? ln.PreviousRoundDeliveryDate : ln.OriginalDeliveryDate;
    private bool QtyMoved(PoNegotiationLineDto ln) => ln.NegotiatedQty != BaselineQty(ln);
    private bool DateMoved(PoNegotiationLineDto ln) => ln.NegotiatedDeliveryDate != BaselineDate(ln);

    // Round 1 keeps the server's IsChanged (it also covers a stored line whose only difference is the retired price).
    private bool RowMoved(PoNegotiationLineDto ln) => IsCounterRound ? QtyMoved(ln) || DateMoved(ln) : ln.IsChanged;
    private int MovedCount => detail?.Lines.Count(RowMoved) ?? 0;

    // The RoundNo of the chain's latest round, found in the history by HeadNegotiationId; null when the history is absent.
    private int? LatestRoundNo => detail is { HeadNegotiationId: { } head } ? detail.Rounds?.FirstOrDefault(r => r.Id == head)?.RoundNo : null;

    // Relative to <base href>, like BackHref: another round of this negotiation on the route base the page was opened on.
    private string RoundHref(Guid roundId) => $"{routeBase}/{roundId}";

    // "Submitted 2026-11-04 03:34 PM by buyer@x" — the "by" part is dropped when the audit name is blank.
    private static string Audit(string verb, DateTime? at, string? by)
        => string.IsNullOrWhiteSpace(by) ? $"{verb} {AppTime.Stamp(at)}" : $"{verb} {AppTime.Stamp(at)} by {by}";

    // Quantity at the line's unit precision (mdm.Unit.decimalPlaces, carried on the line), trailing zeros trimmed. Never
    // fewer than the 3 places this grid always showed: with a 4-6 dp unit, two different quantities would otherwise print
    // identically beside a "changed" highlight (which compares the raw decimals).
    private static string FormatQty(decimal qty, int unitDecimalPlaces)
        => qty.ToString("0." + new string('#', Math.Max(unitDecimalPlaces, 3)));

    // Why a viewer sees no action buttons on a round. Only Submitted acts (and only for the party that did not propose it);
    // a Submitted round that reaches here is waiting on the other side.
    private static string ActionHint(string status, string proposedBy) => status switch
    {
        "Approved"  => "Already approved — negotiated terms have been pushed to ERP.",
        "Rejected"  => "Already rejected — no further review actions.",
        "Cancelled" => "Cancelled by the supplier — no further review actions.",
        "Countered" => "Countered — open the latest round.",
        "Submitted" => proposedBy == "Buyer"
                           ? "Awaiting the supplier's response to your counter-offer."
                           : "Awaiting the buyer's review.",
        _           => "No review actions available for this status.",
    };

    // R18 (2026-11-04) — the page is re-used when a round link (or a submitted counter) navigates to another round of the
    // same route, so the load is keyed on Id: OnInitializedAsync would not run again. A new round also drops any open
    // dialog / editor, which belonged to the round just left.
    protected override async Task OnParametersSetAsync()
    {
        if (Id == loadedId) return;
        loadedId = Id;
        routeBase = Nav.ToBaseRelativePath(Nav.Uri).StartsWith(BuyerRoute, StringComparison.OrdinalIgnoreCase) ? BuyerRoute : SupplierRoute;
        showApprove = showReject = showAccept = showDecline = false;
        reasonText = actionError = string.Empty;
        CancelCounter();
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        // Keyed on the id this request is for: Blazor does not queue SetParametersAsync, so two round links followed back to
        // back run two loads at once, and an earlier round's slow response must not overwrite the round the page moved to.
        var id = Id;
        var resp = await Api.GetAsync<PoNegotiationDto>($"api/purchase-orders/negotiations/{id}");
        if (id != Id) return;
        detail = resp?.Data;
        loading = false;
    }

    // ---------------- Review actions ----------------
    private void OpenApprove() { actionError = string.Empty; showApprove = true; }
    private void OpenReject() { reasonText = string.Empty; actionError = string.Empty; showReject = true; }
    private void OpenAccept() { actionError = string.Empty; showAccept = true; }
    private void OpenDecline() { reasonText = string.Empty; actionError = string.Empty; showDecline = true; }

    private async Task DoApprove()
    {
        busy = true; actionError = string.Empty;
        var resp = await Api.PostAsync<object?>($"api/purchase-orders/negotiations/{Id}/approve", new { });
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Approved", Detail = "PO approved and negotiated terms queued for ERP push." });
            showApprove = false;
            await Load();
        }
        else
        {
            // 409 (wrong state / concurrent approve) and 403 (guard denial) arrive as Success=false with the
            // server's typed title in Errors. Surface via toast AND inline, then refresh so the now-stale
            // status + disabled actions reflect reality.
            actionError = FirstError(resp?.Errors, "Approval failed.");
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Could not approve", Detail = actionError, Duration = 6000 });
            await Load();
        }
        busy = false;
    }

    private async Task DoReject()
    {
        if (string.IsNullOrWhiteSpace(reasonText)) { actionError = "A reason is required."; return; }
        busy = true; actionError = string.Empty;
        var resp = await Api.PostAsync($"api/purchase-orders/negotiations/{Id}/reject", new RejectPoNegotiationRequest(reasonText.Trim()));
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Rejected", Detail = "PO reverted to its previous status." });
            showReject = false;
            await Load();
        }
        else
        {
            actionError = FirstError(resp?.Errors, "Rejection failed.");
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Could not reject", Detail = actionError, Duration = 6000 });
            await Load();
        }
        busy = false;
    }

    // R18 (2026-11-04) — the supplier's answers to a buyer's counter-offer, handled exactly like DoApprove / DoReject.
    private async Task DoAccept()
    {
        busy = true; actionError = string.Empty;
        var resp = await Api.PostAsync<object?>($"api/purchase-orders/negotiations/{Id}/accept", new { });
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Accepted", Detail = "Counter-offer accepted — PO approved and the terms queued for ERP push." });
            showAccept = false;
            await Load();
        }
        else
        {
            actionError = FirstError(resp?.Errors, "Accepting failed.");
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Could not accept", Detail = actionError, Duration = 6000 });
            await Load();
        }
        busy = false;
    }

    private async Task DoDecline()
    {
        if (string.IsNullOrWhiteSpace(reasonText)) { actionError = "A reason is required."; return; }
        busy = true; actionError = string.Empty;
        var resp = await Api.PostAsync($"api/purchase-orders/negotiations/{Id}/decline", new DeclinePoNegotiationRequest(reasonText.Trim()));
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Declined", Detail = "Counter-offer declined — PO reverted to its previous status." });
            showDecline = false;
            await Load();
        }
        else
        {
            actionError = FirstError(resp?.Errors, "Decline failed.");
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Could not decline", Detail = actionError, Duration = 6000 });
            await Load();
        }
        busy = false;
    }

    // ---------------- Counter editor (R18, 2026-11-04) ----------------
    // One row per PO line, seeded from THIS round's effective values. Mirrors PurchaseOrderDetail's LineEdit: the date is held
    // as a wall-clock time in the display zone for the picker and converted back (AppTime.ToUtc) for the wire, and an
    // untouched date is re-sent as the stored instant verbatim.
    private sealed class CounterEdit
    {
        /// <summary>This round's own qty — the baseline a counter line is compared with (<see cref="Changed"/>).</summary>
        public decimal CurrentQty;

        /// <summary>This round's stored (UTC) delivery instant, kept verbatim so an untouched date is re-sent to the
        /// byte, not as the minute-truncated value the picker would hand back.</summary>
        public DateTime? CurrentDate;

        /// <summary>Carried through unchanged — a counter never changes price (the server ignores it) but the request
        /// contract still takes it, so the round's own value rides along.</summary>
        public decimal Price;

        public decimal Qty;

        /// <summary>The unit decimal places (3 when unknown): the most fractional digits a quantity may carry.</summary>
        public int UnitDecimalPlaces;

        /// <summary>What the picker was seeded with, already minute-truncated. The change test compares against THIS
        /// rather than against <see cref="CurrentDate"/>: the picker works to the minute, so a stored 11:00:30 would
        /// come back as 11:00 and read as an edit nobody made.</summary>
        public DateTime? SeededLocalDate;

        /// <summary>Bound to the picker — a WALL-CLOCK time in the display zone, never persisted in this form.</summary>
        public DateTime? LocalDeliveryDate { get; set; }

        public bool DateChanged => LocalDeliveryDate != SeededLocalDate;

        /// <summary>The value for the wire. An untouched date returns the round's instant untouched.</summary>
        public DateTime? DeliveryDateUtc => DateChanged ? AppTime.ToUtc(LocalDeliveryDate) : CurrentDate;

        public bool Changed => Qty != CurrentQty || DateChanged;
    }

    private void EnterCounter()
    {
        if (detail is null) return;
        counterError = string.Empty;
        counterNotes = string.Empty;
        edits = detail.Lines.ToDictionary(
            l => l.PurchaseOrderLineId,
            l =>
            {
                // The picker speaks wall-clock in the display zone; storage and the wire stay UTC.
                var seeded = TruncateToMinute(AppTime.ToLocal(l.NegotiatedDeliveryDate));
                return new CounterEdit
                {
                    CurrentQty = l.NegotiatedQty,
                    CurrentDate = l.NegotiatedDeliveryDate,
                    Price = l.NegotiatedPrice,
                    // The input opens at the quantity's natural scale ("14", not "14.0000"). CurrentQty stays verbatim:
                    // Changed compares decimals by value, so an untouched line is still not sent.
                    Qty = TrimScale(l.NegotiatedQty),
                    UnitDecimalPlaces = l.UnitDecimalPlaces,
                    SeededLocalDate = seeded,
                    LocalDeliveryDate = seeded,
                };
            });
        countering = true;
    }

    // Discard local edits, no API call. Also the reset when the page moves to another round.
    private void CancelCounter()
    {
        countering = false;
        edits = new();
        counterNotes = string.Empty;
        counterError = string.Empty;
    }

    // The buyer counters an open supplier round (/counter), the supplier an open buyer round (/supplier-counter). Unlike the
    // answers above, a failure keeps the editor open with the server's message so the edits are not lost; it still reloads
    // like they do, and the editor closes only if the reloaded round is no longer the viewer's to answer.
    private async Task SubmitCounter()
    {
        if (detail is null || busy) return;
        var changed = edits.Where(kv => kv.Value.Changed).ToList();
        if (changed.Count == 0) { counterError = "Change at least one line, or accept the round instead."; return; }

        var notPositive = changed.Where(kv => kv.Value.Qty <= 0).Select(kv => LineLabel(kv.Key)).ToList();
        if (notPositive.Count > 0)
        {
            counterError = $"Quantity must be greater than zero. {CheckLines(notPositive)}";
            return;
        }

        // The spinner step does not stop a typed value, so a quantity is judged against the unit's decimal places here
        // (only lines whose quantity CHANGED, as QtyTooPrecise) and the offending lines are named. The server judges the
        // delivery against the PO date, which this page does not carry, and reports it in the same inline slot.
        var tooPrecise = changed.Where(kv => QtyTooPrecise(kv.Value)).Select(kv => LineLabel(kv.Key)).ToList();
        if (tooPrecise.Count > 0)
        {
            counterError = $"Quantity has more decimals than the unit allows. {CheckLines(tooPrecise)}";
            return;
        }

        var buyer = CanBuyerAct;
        busy = true; counterError = string.Empty;
        var req = new CounterPoNegotiationRequest(
            string.IsNullOrWhiteSpace(counterNotes) ? null : counterNotes.Trim(),
            changed.Select(kv => new PoNegotiationLineInput(kv.Key, kv.Value.Qty, kv.Value.DeliveryDateUtc, kv.Value.Price)).ToList());
        var resp = await Api.PostAsync<PoNegotiationDto, CounterPoNegotiationRequest>(
            $"api/purchase-orders/negotiations/{Id}/{(buyer ? "counter" : "supplier-counter")}", req);
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Counter-offer sent",
                Detail = buyer ? "The supplier will respond to your counter-offer." : "The buyer will review your counter-offer.",
            });
            CancelCounter();   // also closes the editor, so the submit button cannot be hit twice while the navigation lands
            // Land on the round just opened; success without a body stays here and shows this round as Countered.
            if (resp.Data is { } next) Nav.NavigateToRoute($"/{routeBase}/{next.Id}");
            else await Load();
        }
        else
        {
            counterError = FirstError(resp?.Errors, "Counter-offer failed.");
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Could not send counter-offer", Detail = counterError, Duration = 6000 });
            // A 409 means the round was answered or withdrawn meanwhile: refresh so the header reflects reality, and drop an
            // editor that would only fail the same way again. `countering` / `edits` are otherwise left as they are.
            await Load();
            if (!CanBuyerAct && !CanSupplierAct) CancelCounter();
        }
        busy = false;
    }

    // "PO position/sequence" of a line, for naming the rows an inline error is about.
    private string LineLabel(Guid purchaseOrderLineId)
        => detail?.Lines.FirstOrDefault(l => l.PurchaseOrderLineId == purchaseOrderLineId) is { } l
            ? $"{l.PositionNo}/{l.SequenceNo}"
            : purchaseOrderLineId.ToString();

    private static string CheckLines(List<string> labels)
        => $"Check line{(labels.Count == 1 ? "" : "s")} {string.Join(", ", labels)}.";

    /// <summary>
    /// Reads the picker back. It already hands over a <c>DateTime?</c>, so there is nothing to parse; what matters is the
    /// minute precision and the null. The picker keeps the SECONDS of whatever it was given (a typed value), and
    /// <see cref="CounterEdit.DateChanged"/> compares against the minute-truncated seed, so the value is cut to the minute
    /// here or an untouched date would read as an edit. NULL is meaningful (the date is being removed) and passes through.
    /// </summary>
    private static void OnDeliveryPicked(CounterEdit edit, DateTime? picked) =>
        edit.LocalDeliveryDate = TruncateToMinute(picked);

    /// <summary>Drops seconds so the seeded value and whatever the picker returns are comparable.</summary>
    private static DateTime? TruncateToMinute(DateTime? value) => value is { } d
        ? new DateTime(d.Year, d.Month, d.Day, d.Hour, d.Minute, 0, d.Kind)
        : null;

    /// <summary>
    /// True when a quantity was TYPED with more decimals than the line's unit allows. Gated on the quantity having changed:
    /// a line carrying the round's quantity verbatim proposes nothing, and flagging it would block a date-only edit over a
    /// figure that was never touched.
    /// </summary>
    private static bool QtyTooPrecise(CounterEdit edit) =>
        edit.Qty != edit.CurrentQty
        && edit.Qty != decimal.Round(edit.Qty, Math.Clamp(edit.UnitDecimalPlaces, 0, 28));

    /// <summary>The number input step for a unit that allows <paramref name="places"/> decimals: 1, 0.1, 0.01…
    /// An HTML attribute, so always dot-decimal whatever the culture of the server.</summary>
    private static string QtyStep(int places) => places <= 0 ? "1" : "0." + new string('0', places - 1) + "1";

    /// <summary>
    /// A stored quantity is decimal(18,4) and the value binding renders a decimal at its own scale, so a quantity of 14
    /// opened as "14.0000". Dividing by a 1 that carries many trailing zeros is the standard way to normalise a decimal's
    /// scale (14.0000 → 14, 12.5000 → 12.5). It never changes the VALUE, only its representation.
    /// </summary>
    private static decimal TrimScale(decimal v) => v / 1.000000000000000000000000000000m;

    private static string FirstError(List<string>? errors, string fallback)
        => errors is { Count: > 0 } ? errors[0] : fallback;
}
