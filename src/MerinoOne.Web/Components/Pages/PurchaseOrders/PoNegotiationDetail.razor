@page "/po-negotiation-review/{Id:guid}"
@page "/po-negotiations/{Id:guid}"
@inject ApiClient Api
@inject TokenAccessor Token
@inject NavigationManager Nav
@inject NotificationService Notif

@* ------------------------------------------------------------------------------------------------
   Buyer review detail, also opened by the supplier (alias route /po-negotiations/{id}, linked from My PO
   change requests). Header + a per-line "original → negotiated" diff. The API returns ONE line per PO
   line: the lines the round changed carry the stored original → negotiated values (IsChanged: differs from the
   PO), every other line repeats the live PO line on both sides — so the header's "proposed" count filters
   IsChanged, never Lines.Count. On round 1 the unchanged lines render muted; a later round mutes the lines that
   did not move against the round it answered (see the R18 note below). The negotiated values live only on this
   record until ERP re-syncs (ERP stays the line master). Changed cells are highlighted. 409 (concurrent answer /
   wrong state) + 403 surface via toast, then reload so the now-stale actions reflect reality. Mirrors
   SupplierChangeRequestDetail.

   R18 (2026-11-04) — rounds. A negotiation is a chain of rounds: the supplier opens round 1 and each side may
   answer the other's OPEN round (Submitted) instead of ending it. This page shows ONE round (Id may be any
   round of the chain; the DTO carries the chain's history and the latest round's id):
     - Buyer, on an open SUPPLIER round (PurchaseOrder.ApproveNegotiation): Reject (reason) / Counter / Approve.
     - Supplier, on an open BUYER round (PurchaseOrder.Negotiate): Decline (reason) / Counter / Accept.
     - Anyone else sees an info hint (awaiting the other side, or why the round is closed).
   Counter turns the lines table into an editor seeded with THIS round's values; submitting opens a NEW round
   (the answered one becomes Countered) and lands on it. Round 1 is diffed against the PO; a later round is
   diffed against the round it answered (PreviousRound*) with the PO kept for reference. A Countered round shows
   a banner linking to the latest round; the round-history card links every round of the chain. Round links stay
   on the route base the page was opened with, and are followed in place (this component is re-used, so the
   load is keyed on Id).
------------------------------------------------------------------------------------------------ *@

<PageTitle>@(detail is null ? "PO negotiation" : $"Negotiation · {detail.PoNumber}")</PageTitle>

@* Per-row treatment for the diff grid: a changed row gets a tint + a "Changed" chip, an unchanged one is muted.
   A <style> block because the state sits on the <tr> and its cells read --ponego-ink from it. Prefixed
   ponego- (PO negotiation) so nothing can collide with merino.css. *@
<style>
    .ponego-row--changed { background:var(--mer-blue-50); --ponego-ink:var(--mer-ink-700); }
    .ponego-row--same { color:var(--mer-ink-500); --ponego-ink:var(--mer-ink-500); }
    .ponego-desc { min-width:160px; overflow-wrap:anywhere; }
    .ponego-chip { display:inline-block; margin-left:8px; padding:1px 7px; border-radius:999px; vertical-align:middle;
                   background:var(--mer-surface); color:var(--mer-blue-700); border:1px solid var(--mer-blue);
                   font:700 10.5px/1.5 'Plus Jakarta Sans', sans-serif; }

    /* R18 (2026-11-04) — rounds. The "Round N · Party" pill beside the status badge, and the superseded banner. */
    .ponego-round { display:inline-block; padding:2px 8px; border-radius:999px; background:var(--mer-surface);
                    color:var(--mer-ink-700); border:1px solid var(--mer-ink-300);
                    font:600 11px/1.6 'Plus Jakarta Sans', sans-serif; }
    .ponego-banner { display:flex; align-items:flex-start; gap:8px; margin-bottom:16px; padding:10px 14px;
                     border-radius:var(--mer-radius); background:var(--mer-blue-50); color:var(--mer-blue-700);
                     font-size:12.5px; }
    .ponego-banner a { margin-left:6px; color:var(--mer-blue); font-weight:700; }

    /* Round history: one grid row per round (R-no · party · status · audit + notes). The round being viewed is tinted
       and has no href; every other row is a link to its own page. */
    .ponego-hist__row { display:grid; grid-template-columns:44px 84px 110px 1fr; gap:10px; align-items:start;
                        padding:8px 10px; border-bottom:1px solid var(--mer-line-soft); border-radius:var(--mer-radius);
                        font-size:12.5px; color:var(--mer-ink-900); text-decoration:none; }
    .ponego-hist__row:last-child { border-bottom:0; }
    a.ponego-hist__row[href]:hover { background:var(--mer-ink-50); }
    .ponego-hist__row--current { background:var(--mer-blue-50); }
    .ponego-hist__no { font-family:Inter, monospace; font-weight:700; }
    .ponego-hist__body { display:flex; flex-direction:column; gap:2px; min-width:0; }
    .ponego-hist__meta { font-family:Inter, monospace; font-size:12px; color:var(--mer-ink-600); }
    .ponego-hist__note { overflow-wrap:anywhere; white-space:pre-wrap; }
    .ponego-hist__note--reason { color:var(--mer-red); }

    /* Counter editor: the "was" caption under an edited cell, and the delivery picker (RadzenDatePicker) dressed to match
       the .rz-textbox qty input beside it. The picker rules follow PurchaseOrderDetail's podt-dt (page-scoped styles do
       not travel between pages): merino.css boxes the .rz-datepicker WRAPPER too, which doubles up with the border Radzen
       draws on the input inside; its .rz-button rule turns the calendar trigger into a boxed button; and that trigger
       then overlaps the clear icon. The popup is appended to the page body, out of this page's reach, so merino.css
       themes it globally (the .rz-datepicker-popup-container block). */
    .ponego-was { margin:3px 0 0 auto; max-width:190px; font-size:10.5px; line-height:1.3; color:var(--mer-ink-500); }
    .ponego-dt { width:216px; border:0; background:transparent; box-shadow:none; }
    .ponego-dt:focus-within { border:0; box-shadow:none; }
    .ponego-dt > .rz-inputtext { border:1px solid var(--mer-ink-300); border-radius:var(--mer-radius);
                                 padding:4px 56px 4px 10px; font-family:Inter, monospace; }
    .ponego-dt:focus-within > .rz-inputtext { border-color:var(--mer-blue); box-shadow:var(--mer-focus-ring); }
    .ponego-dt .rz-datepicker-trigger { border:0; background:transparent; padding:0; width:24px; height:24px;
                                        inset-inline-end:8px; }
    .ponego-dt .rz-dropdown-clear-icon { inset-inline-end:32px; }
</style>

@if (loading)
{
    <div class="tl-empty">Loading…</div>
}
else if (detail == null)
{
    <div class="tl-empty">PO negotiation not found.</div>
}
else
{
    <div class="tl-page">
        <a href="@BackHref" class="mer-back-link">
            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;">arrow_back</span>
            @BackLabel
        </a>
        <header class="tl-header">
            <div>
                <div class="tl-title-row">
                    <h1 class="tl-title">@detail.PoNumber</h1>
                    <span class="tlg-status @PoNegotiationStatus.CssClass(detail.NegotiationStatus)">@PoNegotiationStatus.Label(detail.NegotiationStatus)</span>
                    <span class="ponego-round">Round @detail.RoundNo · @detail.ProposedBy</span>
                </div>
                <p class="tl-sub">
                    <a href="purchase-orders/@detail.PurchaseOrderId" style="color:var(--mer-blue);text-decoration:none;">@(string.IsNullOrWhiteSpace(detail.SupplierName) ? "View purchase order" : detail.SupplierName)</a>
                    · @ChangedCount line@(ChangedCount == 1 ? "" : "s") proposed
                </p>
            </div>
            @* R18 (2026-11-04) — the action set follows the round's ProposedBy, not just the viewer's permissions: only
               the party that did NOT propose an open round may answer it, so a user holding both permissions gets
               whichever set the round calls for. *@
            @if (CanBuyerAct)
            {
                <div class="tl-header__actions">
                    <button class="mbtn mbtn--danger" @onclick="OpenReject" disabled="@ActionsLocked">
                        <span class="material-symbols-outlined">block</span> Reject
                    </button>
                    <button class="mbtn mbtn--accent" @onclick="EnterCounter" disabled="@ActionsLocked">
                        <span class="material-symbols-outlined">swap_horiz</span> Counter
                    </button>
                    <button class="mbtn mbtn--primary" @onclick="OpenApprove" disabled="@ActionsLocked">
                        <span class="material-symbols-outlined">task_alt</span> Approve
                    </button>
                </div>
            }
            else if (CanSupplierAct)
            {
                <div class="tl-header__actions">
                    <button class="mbtn mbtn--danger" @onclick="OpenDecline" disabled="@ActionsLocked">
                        <span class="material-symbols-outlined">block</span> Decline
                    </button>
                    <button class="mbtn mbtn--accent" @onclick="EnterCounter" disabled="@ActionsLocked">
                        <span class="material-symbols-outlined">swap_horiz</span> Counter
                    </button>
                    <button class="mbtn mbtn--primary" @onclick="OpenAccept" disabled="@ActionsLocked">
                        <span class="material-symbols-outlined">task_alt</span> Accept
                    </button>
                </div>
            }
            else if (CanReview || CanNegotiate)
            {
                @* The viewer is on a negotiation but has no action on this round — explain WHY there are no actions
                   (already approved / rejected / cancelled, countered, or waiting on the other side). *@
                <div class="tl-header__actions">
                    <span class="tlg-status tlg-status--info" style="display:inline-flex;align-items:center;gap:6px;padding:8px 14px;max-width:420px;line-height:1.3;white-space:normal;">
                        <span class="material-symbols-outlined" style="font-size:16px;">info</span> @ActionHint(detail.NegotiationStatus, detail.ProposedBy)
                    </span>
                </div>
            }
        </header>

        @* R18 (2026-11-04) — a countered round is history: point at the round that replaced it. *@
        @if (detail.NegotiationStatus == "Countered")
        {
            <div class="ponego-banner">
                <span class="material-symbols-outlined" style="font-size:18px;">info</span>
                <span>
                    This round was countered — @(LatestRoundNo is { } latest ? $"round {latest}" : "a later round") is the latest.
                    @if (detail.HeadNegotiationId is { } headId && headId != detail.Id)
                    {
                        <a href="@RoundHref(headId)">Open the latest round</a>
                    }
                </span>
            </div>
        }

        @* ---------------- Header meta ---------------- *@
        <div class="rz-card" style="padding:20px;margin-bottom:16px;">
            <dl style="display:grid;grid-template-columns:150px 1fr 150px 1fr;gap:6px 16px;font-size:13px;">
                <dt style="color:var(--mer-ink-500);">Supplier</dt><dd>@(string.IsNullOrWhiteSpace(detail.SupplierName) ? "—" : detail.SupplierName)</dd>
                <dt style="color:var(--mer-ink-500);">PO previous status</dt><dd>@PoStatusLabels.Label(detail.PreviousPoStatus)</dd>
                <dt style="color:var(--mer-ink-500);">Submitted</dt><dd style="font-family:Inter,monospace;">@AppTime.Stamp(detail.SubmittedAt)</dd>
                <dt style="color:var(--mer-ink-500);">Reviewed by</dt><dd>@(string.IsNullOrWhiteSpace(detail.ReviewedBy) ? "—" : detail.ReviewedBy)</dd>
                <dt style="color:var(--mer-ink-500);">Reviewed at</dt><dd style="font-family:Inter,monospace;">@AppTime.Stamp(detail.ReviewedAt)</dd>
                <dt style="color:var(--mer-ink-500);">Notes</dt>
                <dd style="grid-column:2 / span 3;">@(string.IsNullOrWhiteSpace(detail.Notes) ? "—" : detail.Notes)</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(detail.RejectionReason))
            {
                <div style="background:var(--mer-red-50);color:var(--mer-red);padding:10px 14px;border-radius:6px;font-size:12.5px;margin-top:12px;display:flex;gap:8px;align-items:flex-start;">
                    <span class="material-symbols-outlined" style="font-size:16px;">report</span>
                    <span><b>Reviewer note:</b> @detail.RejectionReason</span>
                </div>
            }
        </div>

        @* ---------------- Round history (R18, 2026-11-04) — only once the chain has a second round ---------------- *@
        @if (detail.Rounds is { Count: >= 2 } rounds)
        {
            <div class="rz-card" style="padding:20px;margin-bottom:16px;">
                <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--mer-blue-darker);">Round history (@rounds.Count)</h3>
                @foreach (var round in rounds)
                {
                    var current = round.Id == detail.Id;
                    <a class="@("ponego-hist__row" + (current ? " ponego-hist__row--current" : ""))" href="@(current ? null : RoundHref(round.Id))" aria-current="@(current ? "true" : null)">
                        <span class="ponego-hist__no">@($"R{round.RoundNo}")</span>
                        <span>@round.ProposedBy</span>
                        <span><span class="tlg-status @PoNegotiationStatus.CssClass(round.NegotiationStatus)">@PoNegotiationStatus.Label(round.NegotiationStatus)</span></span>
                        <span class="ponego-hist__body">
                            <span class="ponego-hist__meta">@Audit("Submitted", round.SubmittedAt, round.SubmittedBy)</span>
                            @if (round.ReviewedAt is not null)
                            {
                                <span class="ponego-hist__meta">@Audit("Reviewed", round.ReviewedAt, round.ReviewedBy)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(round.Notes))
                            {
                                <span class="ponego-hist__note"><b>Notes:</b> @round.Notes</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(round.RejectionReason))
                            {
                                <span class="ponego-hist__note ponego-hist__note--reason"><b>Reason:</b> @round.RejectionReason</span>
                            }
                        </span>
                    </a>
                }
            </div>
        }

        @* ---------------- Counter editor bar (R18, 2026-11-04) ---------------- *@
        @if (countering)
        {
            <div class="rz-card" style="padding:16px 20px;margin-bottom:16px;border:1px solid var(--mer-blue);background:var(--mer-blue-50);">
                <div style="display:flex;align-items:flex-start;gap:10px;">
                    <span class="material-symbols-outlined" style="font-size:20px;color:var(--mer-blue);">swap_horiz</span>
                    <div style="flex:1;">
                        <div style="font-size:13px;font-weight:700;color:var(--mer-blue-darker);">Counter-offer</div>
                        <p style="font-size:12px;color:var(--mer-ink-700);margin:2px 0 10px;">Edit the <b>Qty</b> and <b>Delivery date &amp; time</b> on the lines you want to change from round @detail.RoundNo. Only changed lines are sent. Times are @AppTime.OffsetLabel.</p>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);display:block;margin-bottom:4px;">Notes for the @(CanBuyerAct ? "supplier" : "buyer") (optional)</label>
                        <textarea class="rz-textbox" rows="2" style="width:100%;max-width:560px;padding:8px 10px;font-family:inherit;" @bind="counterNotes"></textarea>
                        @if (!string.IsNullOrEmpty(counterError))
                        {
                            <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:8px;max-width:560px;">@counterError</div>
                        }
                    </div>
                    <div style="display:flex;gap:8px;flex-shrink:0;">
                        <button class="mbtn mbtn--outline" @onclick="CancelCounter" disabled="@busy">Cancel</button>
                        <button class="mbtn mbtn--primary" @onclick="SubmitCounter" disabled="@busy">
                            <span class="material-symbols-outlined">send</span> @(busy ? "Sending…" : "Submit counter-offer")
                        </button>
                    </div>
                </div>
            </div>
        }

        @* ---------------- Diff table (one row per PO line; RowMoved marks the ones that move against the round's baseline) ---------------- *@
        <div class="rz-card" style="padding:20px;overflow-x:auto;">
            <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--mer-blue-darker);">Lines (@detail.Lines.Count)<span style="font-weight:500;color:var(--mer-ink-500);"> · @MovedCount changed@(IsCounterRound ? $" since round {detail.RoundNo - 1}" : "")</span></h3>
            @if (detail.Lines.Count == 0)
            {
                <div class="tl-empty"><span class="material-symbols-outlined" style="font-size:32px;">difference</span><div>No lines on this negotiation.</div></div>
            }
            else
            {
                <table style="width:100%;font-size:12.5px;border-collapse:collapse;">
                    <thead>
                        <tr style="border-bottom:1px solid var(--mer-line);">
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Pos</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Seq</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Item</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Item Description</th>
                            @* Price columns removed 2026-08-12 (feedback (2)): price is no longer negotiable, so a
                               diff of it is always a no-op. The DTO still carries Original/NegotiatedPrice and the
                               stored history is intact — this is a display change only. *@
                            @* R18 (2026-11-04) — a counter round compares against the round it answered: PO | Prev. round |
                               Proposed. Round 1 has no parent round and keeps its Original | Negotiated pair. *@
                            @if (IsCounterRound)
                            {
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">PO qty</th>
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Prev. round qty</th>
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Proposed qty</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">PO delivery</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Prev. round delivery</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Proposed delivery</th>
                            }
                            else
                            {
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Original Qty</th>
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Negotiated Qty</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Original Delivery</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Negotiated Delivery</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ln in detail.Lines.OrderBy(l => l.PositionNo).ThenBy(l => l.SequenceNo))
                    {
                        var qtyChanged = QtyMoved(ln);
                        var dateChanged = DateMoved(ln);
                        var edit = countering ? edits.GetValueOrDefault(ln.PurchaseOrderLineId) : null;
                        <tr class="@(RowMoved(ln) ? "ponego-row--changed" : "ponego-row--same")" style="border-bottom:1px solid var(--mer-line-soft);">
                            <td style="padding:6px 4px;font-family:Inter,monospace;">@ln.PositionNo</td>
                            <td style="padding:6px 4px;font-family:Inter,monospace;">@ln.SequenceNo</td>
                            <td style="padding:6px 4px;font-family:Inter,monospace;white-space:nowrap;">
                                @ln.ItemCode
                                @if (RowMoved(ln))
                                {
                                    <span class="ponego-chip">Changed</span>
                                }
                            </td>
                            <td class="ponego-desc" style="padding:6px 4px;">@(string.IsNullOrWhiteSpace(ln.ItemDescription) ? "—" : ln.ItemDescription)</td>
                            @* The PO column is struck through only where it is the baseline (round 1); on a counter round the
                               replaced value is the previous round's, so that column carries the strike instead. *@
                            <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;color:var(--mer-ink-500);@(qtyChanged && !IsCounterRound ? "text-decoration:line-through;" : "")">@FormatQty(ln.OriginalQty, ln.UnitDecimalPlaces)</td>
                            @if (IsCounterRound)
                            {
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;color:var(--mer-ink-500);@(qtyChanged ? "text-decoration:line-through;" : "")">@(ln.PreviousRoundQty is { } prevQty ? FormatQty(prevQty, ln.UnitDecimalPlaces) : "—")</td>
                            }
                            @if (edit is not null)
                            {
                                @* Editable Qty: the step follows the unit of the line (1, 0.1, 0.01…) but a step is only a
                                   spinner hint, so QtyTooPrecise flags a typed value as soon as @bind commits it (blur /
                                   Enter), and SubmitCounter refuses it too. *@
                                var tooPreciseHere = QtyTooPrecise(edit);
                                <td style="padding:6px 4px;text-align:right;">
                                    <input type="number" step="@QtyStep(edit.UnitDecimalPlaces)" min="0" class="rz-textbox"
                                           style="width:90px;padding:4px 6px;text-align:right;font-family:Inter,monospace;@(tooPreciseHere ? "border:1px solid var(--mer-red);background:var(--mer-red-50);" : "")"
                                           @bind="edit.Qty" />
                                    @if (tooPreciseHere)
                                    {
                                        <div style="font-size:10.5px;color:var(--mer-red);margin:3px 0 0 auto;max-width:110px;line-height:1.3;">
                                            Allows at most @edit.UnitDecimalPlaces decimal@(edit.UnitDecimalPlaces == 1 ? "" : "s")@(string.IsNullOrWhiteSpace(ln.OrderUnit) ? "" : $" ({ln.OrderUnit})")
                                        </div>
                                    }
                                    else if (edit.Qty != edit.CurrentQty)
                                    {
                                        <div class="ponego-was">Round @detail.RoundNo: @FormatQty(edit.CurrentQty, ln.UnitDecimalPlaces)</div>
                                    }
                                </td>
                            }
                            else
                            {
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;font-weight:@(qtyChanged ? "700" : "400");color:@(qtyChanged ? "var(--mer-green-dark)" : "var(--ponego-ink)");background:@(qtyChanged ? "var(--mer-green-50)" : "transparent");">@FormatQty(ln.NegotiatedQty, ln.UnitDecimalPlaces)</td>
                            }
                            @* To the minute: the supplier can now propose a TIME, and a date-only cell would show
                               an 09:00 → 17:00 move as two identical values. *@
                            <td style="padding:6px 4px;font-family:Inter,monospace;color:var(--mer-ink-500);@(dateChanged && !IsCounterRound ? "text-decoration:line-through;" : "")">@AppTime.Stamp(ln.OriginalDeliveryDate)</td>
                            @if (IsCounterRound)
                            {
                                <td style="padding:6px 4px;font-family:Inter,monospace;color:var(--mer-ink-500);@(dateChanged ? "text-decoration:line-through;" : "")">@AppTime.Stamp(ln.PreviousRoundDeliveryDate)</td>
                            }
                            @if (edit is not null)
                            {
                                @* Editable Delivery date AND time, the PurchaseOrderDetail negotiation editor's picker: a WALL-CLOCK
                                   time in the display zone (CounterEdit.DeliveryDateUtc converts it back for the wire). Bound
                                   one-way (Value + Change), NOT @bind-Value: Change goes through OnDeliveryPicked, which cuts the
                                   value to the minute, since the picker keeps the seconds of a typed value and DateChanged compares
                                   against the minute-truncated seed. Culture is pinned to Invariant, as AppTime does, so a server
                                   locale cannot change the box text; OnDemand builds the popup only when opened (Initial would put
                                   ~47KB of hidden calendar markup behind every row). No `Min`: a floor would make the picker refuse
                                   the value outright, while the PO-date rule is the server's to judge and report (the DTO does not
                                   carry the PO date). AllowClear is on because removing the date is meaningful. *@
                                <td style="padding:6px 4px;">
                                    <RadzenDatePicker TValue="DateTime?" ShowTime="true" ShowSeconds="false" HourFormat="24"
                                                      DateFormat="yyyy-MM-dd HH:mm" AllowClear="true"
                                                      Culture="System.Globalization.CultureInfo.InvariantCulture"
                                                      PopupRenderMode="PopupRenderMode.OnDemand"
                                                      class="ponego-dt"
                                                      title="@($"Delivery date and time, in {AppTime.OffsetLabel}")"
                                                      Value="@edit.LocalDeliveryDate"
                                                      Change="@(v => OnDeliveryPicked(edit, v))" />
                                    @if (edit.DateChanged)
                                    {
                                        <div class="ponego-was" style="margin-left:0;">Round @detail.RoundNo: @AppTime.Stamp(ln.NegotiatedDeliveryDate)</div>
                                    }
                                </td>
                            }
                            else
                            {
