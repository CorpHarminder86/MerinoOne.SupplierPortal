@code {
    [Parameter] public Guid? Id { get; set; }
    // R15 — the delivery-schedules page deep-links here with ?supplier=<id>&schedules=id1,id2: the named supplier
    // is chosen, the listed schedule lines are pre-checked (warehouse auto-locked) and the wizard lands on
    // Quantities. NO server draft exists until Save — the instant-draft dialog on that page was retired.
    // (The dead R4 ?pos= PO-preselect path was removed with the PO-picker step.)
    [SupplyParameterFromQuery(Name = "supplier")] public Guid? PreselectSupplier { get; set; }
    [SupplyParameterFromQuery(Name = "schedules")] public string? PreselectSchedules { get; set; }
    // R5 (§9.2) — the delivery-schedule flow lands on /asns/{id}?step=2 so the supplier opens directly on Lines.
    // Also used by the save-draft create path (?step=4) to keep the supplier on Review after the save re-navigation.
    // Applied ONCE, only for an existing ASN with lines already present; a brand-new ASN always starts at step 1.
    [SupplyParameterFromQuery(Name = "step")] public int? StartStep { get; set; }
    private AsnDetailDto? detail;
    private bool loading = true;
    private bool busy = false;
    private bool savingDraft = false;
    private int currentStep = 1;

    // ===================== Design 2a — read-only ASN view helpers (2026-08-11) =====================

    /// <summary>Lines whose serial/lot detail is expanded. Collapsed is the default: a serialized ASN can carry
    /// hundreds of chips, which is what made this page run for screens.</summary>
    private readonly HashSet<Guid> expandedLines = new();

    private void ToggleLine(Guid lineId, bool expandable)
    {
        if (!expandable) return;
        if (!expandedLines.Remove(lineId)) expandedLines.Add(lineId);
    }

    private static string Dash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    /// <summary>First 8 / last 6 of the sync id — enough to match against a log line; the full value copies.</summary>
    private static string ShortSyncId(string id) => id.Length <= 18 ? id : $"{id[..8]}…{id[^6..]}";

    private async Task CopySyncIdAsync(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", id);
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "ERP sync id copied" });
        }
        catch
        {
            // Clipboard access is origin- and permission-gated; a failure is not worth an error toast.
        }
    }

    private sealed record StripStyle(string Icon, string Bg, string Border, string Fg, string Text);

    /// <summary>
    /// The one-line verdict strip at the top of the read-only view. The locked branch covers more than
    /// Submitted (PendingApproval / Approved-after-post / InTransit / Delivered / Cancelled), so the strip
    /// states whichever fact that status actually has — never an empty green bar.
    /// </summary>
    private static StripStyle LockedStrip(AsnDetailDto d, int draftInvoiceCount)
    {
        // R16 — a PartialFailure carries an ERP header but refused ≥1 line, so "posted" is true and "accepted"
        // is not. It reads amber with the verdict named, rather than green with the failure hidden.
        var erpBad = !string.IsNullOrEmpty(d.ErpStatus) && d.ErpStatus != "Success";

        if (d.PostedAt.HasValue)
        {
            var by = string.IsNullOrEmpty(d.PostedBy) ? "" : $" by <b>{d.PostedBy}</b>";
            var erp = !string.IsNullOrEmpty(d.ErpCode)
                ? $" · ERP <b>{d.ErpCode}</b> {(erpBad ? d.ErpStatus : "accepted")}"
                : erpBad ? $" · ERP {d.ErpStatus}" : " · awaiting ERP acknowledgement";
            var text = $"Posted{by} · {d.PostedAt.Value:yyyy-MM-dd HH:mm}{erp}";
            return erpBad
                ? new StripStyle("warning", "var(--mer-amber-50, #fff8e6)", "var(--mer-amber-200, #ffe2a8)", "var(--mer-amber-800)", text)
                : new StripStyle("verified", "var(--mer-green-50, #f3f9ec)", "var(--mer-green)", "var(--mer-green-darker, #3b6d11)", text);
        }

        return d.AsnStatus switch
        {
            "PendingApproval" => new StripStyle("hourglass_top", "var(--mer-blue-50)", "var(--mer-blue)", "var(--mer-blue-darker)",
                "Sent for approval — awaiting the buyer's confirmation. The shipment is locked while it is reviewed."),
            "Cancelled" => new StripStyle("block", "var(--mer-ink-50)", "var(--mer-line)", "var(--mer-ink-600)",
                "Cancelled — this ASN was withdrawn and never posted to the ERP."),
            _ => new StripStyle("lock", "var(--mer-ink-50)", "var(--mer-line)", "var(--mer-ink-600)",
                $"{d.AsnStatus} — read-only."),
        };
    }
    private string submitError = string.Empty;

    // Supplier-first (chooser hidden at 1 supplier) — unchanged; what follows the supplier changed in R15.
    private List<SupplierListItemDto> suppliers = new();
    private Guid? selectedSupplierId;
    private string? selectedSupplierName;

    // R15 (Design 1a) — step 1 is a flat grid of the supplier's APPROVED delivery-schedule lines (hard filter, D2).
    // scheduleRows caches one status=Approved sweep per supplier; the grid filters it client-side. Selection is
    // keyed by DeliverySchedule.Id; the FIRST pick locks the warehouse (§9.1) and rows for other warehouses are
    // disabled until Clear — the server AsnWarehouseRules invariant stays the authoritative fallback.
    private List<DeliveryScheduleDto> scheduleRows = new();
    private bool schedulesLoading;
    private readonly Dictionary<Guid, DeliveryScheduleDto> selectedSchedules = new();
    private string lineSearch = string.Empty;
    private string gridWarehouseFilter = string.Empty;
    // 2026-08-11 — the grid opens on the CURRENT MONTH (1st → last day) rather than unbounded. The upper bound is
    // month-END, not today: delivery dates are typically FORWARD-dated, so a "to today" default would hide the very
    // lines a supplier is preparing to ship.
    private DateTime? gridDateFrom = MonthStart();
    private DateTime? gridDateTo = MonthEnd();

    private static DateTime MonthStart() { var t = DateTime.Today; return new DateTime(t.Year, t.Month, 1); }
    private static DateTime MonthEnd() { var s = MonthStart(); return s.AddMonths(1).AddDays(-1); }
    // Per-supplier PO-detail cache for line enrichment (serial/lot flags + over-ship allowance come off the PO
    // line, not the schedule row). One fetch per covered PO, reused across selection changes.
    private readonly Dictionary<Guid, PurchaseOrderDetailDto> poDetailCache = new();

    private List<LineRow> lines = new();
    private bool linesLoading = false;
    private DateTime? expectedDeliveryDate;
    private string? timeWindow;
    private string? carrierName;
    private string? trackingNumber;
    private string? vehicleNumber;
    private string? driverName;
    private string? driverPhone;
    private string? notes;

    // R11 (D6) — supplier-entered shipment references. Optional to SAVE a draft, MANDATORY to send it for
    // approval (the server is the authority; ShipmentRefsMissing mirrors the rule so the button can explain
    // itself before the round-trip). Editable in Draft/Rejected only, like the rest of the header.
    private string? invoiceNo;
    private string? billOfLading;
    private string? packingList;

    // R11 (D4/D12) — derived, read-only. Warehouse is snapshotted from the covered PO; created/shipment dates
    // come off the ASN itself (shipment date is the buyer-approval instant, so it is null until approved).
    private string? asnWarehouse;
    private DateTime? asnCreatedOn;
    private DateTime? asnShipmentDate;

    // Attachments — R5 (§13): the reusable AttachmentPanel now OWNS upload/list/remove (slots from the policy
    // read-model, files via /api/document-uploads/attach + DELETE). The page keeps only a lightweight count of the
    // ASN's attachments (for the step-4 review summary), refreshed from the by-asn list endpoint on panel changes.
    private readonly List<DocumentAttachmentDto> attachments = new();
    private Guid attachSupplierId;

    // ---- R7 (§2) — document-rail state (shared by the pill in the header and the rail in either branch) ----
    // §2.3 default is host-derived: starts closed; the FIRST panel summary flips it open when this is the
    // editable host AND any Mandatory slot is empty. A manual toggle (pill / Escape / close / backdrop) wins
    // permanently — the auto-default never fights the user.
    private bool railOpen;
    private bool _railUserToggled;
    private AttachmentPanelSummary? railSummary;

    private void OnRailOpenChanged(bool open)
    {
        railOpen = open;
        _railUserToggled = true;
    }

    private void OnRailSummary(AttachmentPanelSummary summary)
    {
        railSummary = summary;
        // No policy slots (no master requirement) => no control: keep the rail collapsed; the header pill hides too.
        if (summary.TotalSlots == 0) { railOpen = false; return; }
        if (!_railUserToggled && !railOpen && !IsLocked && CanWrite && summary.AnyMandatoryEmpty)
            railOpen = true;
    }
    // R4 (2026-06-23) — deferred-upload staging key for create-mode attachments (rebound onto the ASN by CreateAsn).
    private Guid _stagingKey = Guid.NewGuid();

    private bool showCancel = false;
    private string dialogError = string.Empty;

    // R4 (2026-06-26) — §6.5 / UC-PO-09: PO confirmation-gate block + admin override. When create/submit returns the
    // gate message, surface it; a caller with PurchaseOrder.OverrideGate can supply a reason to re-submit past it.
    private bool showGateOverride = false;
    private string gateBlockMessage = string.Empty;
    private bool showOverShip = false;
    private string gateOverrideReason = string.Empty;
    private string gateOverrideError = string.Empty;

    // R4 (2026-06-26) — §8.3 / UC-ATT-03: missing-Warning-attachment confirm. The first submit returns a 200 with
    // ConfirmationRequired=true; on confirm we re-submit with AcknowledgeMissingAttachments=true.
    private bool showAttachConfirm = false;
    private string attachConfirmMessage = string.Empty;
    private List<string> attachMissing = new();
    // R14 — which action raised the two-step dialogs, so the confirm retries the right endpoint.
    private bool confirmingPost = false;
    private bool gateOverrideForPost = false;

    // R5 (§10.2) — buyer Approve / Reject dialog state.
    private bool showApprove = false;
    private bool showReject = false;
    private string rejectReason = string.Empty;
    private string approveError = string.Empty;
    private string rejectError = string.Empty;

    // R6 — Retry generation for a Blocked ASN (POST api/invoices/from-asn; idempotent). A still-blocked
    // generator returns 400 with the reason — surfaced inline in the Blocked banner, not a dialog.
    private bool invoiceRetryBusy = false;
    private string invoiceRetryError = string.Empty;

    private async Task RetryInvoiceGeneration()
    {
        if (detail == null) return;
        invoiceRetryBusy = true; invoiceRetryError = string.Empty;
        var resp = await Api.PostAsync<InvoiceDetailDto, CreateInvoiceFromAsnRequest>(
            "api/invoices/from-asn", new CreateInvoiceFromAsnRequest(detail.Id));
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Draft invoice(s) generated" });
            await Reload();
        }
        else
        {
            invoiceRetryError = resp?.Errors?.FirstOrDefault() ?? "Generation is still blocked.";
        }
        invoiceRetryBusy = false;
    }

    private bool IsNew => !Id.HasValue;
    private bool IsLocked => detail?.IsLocked == true;
    private bool CanWrite => Token.IsSupplier || Token.HasPermission("Asn.Write");
    private bool CanOverrideGate => Token.HasPermission("PurchaseOrder.OverrideGate");
    // R5 (§10.2) — buyer decision permission. Asn.Approve is seeded to SuperAdmin/Admin/Buyer (not Supplier). The
    // server AsnApprovalGate additionally asserts the caller is a MAPPED PO buyer; we only gate the affordance here.
    private bool CanApprove => Token.HasPermission("Asn.Approve");
    // Cancel is supplier-side and valid on any of the supplier's active states.
    // R14 — Approved joins them: a confirmed-but-unposted ASN has consumed nothing and dispatched nothing, so the
    // supplier must still be able to withdraw it (mirrors AsnLifecycle.Cancellable).
    // Submitted/InTransit/Delivered/Cancelled are terminal-for-cancel here (the read-only view hides it via this flag).
    private bool CanCancel => detail?.AsnStatus is "Draft" or "Rejected" or "PendingApproval" or "Approved";

    // The gate block message names the required action; the API stamps it under the "poStatus" error key. Match the
    // stable prefix so we route it to the override dialog rather than the generic error banner.
    private static bool IsGateBlock(string? msg) =>
        !string.IsNullOrEmpty(msg) && msg.Contains("before shipments can be created", StringComparison.OrdinalIgnoreCase);

    // R15 — the covered-PO summary derives from the working line set (there is no PO picker anymore).
    private IEnumerable<string> SelectedPoNumbers =>
        lines.Select(l => l.PoNumber).Distinct().OrderBy(x => x);

    private string PoSummaryText =>
        detail == null ? "" :
        detail.PurchaseOrders.Count > 0 ? string.Join(", ", detail.PurchaseOrders.Select(p => p.PoNumber))
        : (detail.PoNumber ?? "—");

    private string HeaderSubtitle =>
        IsNew ? "Submit a shipping notice for one or more purchase orders"
        : detail == null ? ""
        : $"ASN for PO {PoSummaryText}";

    // R15 — step-1 helper (Design 1a): pick approved schedule lines; the first pick locks the warehouse.
    private string Step1HelperText =>
        (suppliers.Count > 1 ? "Choose the supplier, then pick" : "Pick")
        + " the approved delivery-schedule lines to ship — one warehouse per ASN; the first line you pick locks it. Lines may span multiple POs.";

    // R11 (D6/D7) — true while any of the three shipment refs is blank. The SERVER is the authority (it hard-
    // blocks Send-For-Approval); this only lets the UI say so before the round-trip. Deliberately NOT wired into
    // CanProceed — a draft with blanks is still saveable, which is the whole point of D7.
    private bool ShipmentRefsMissing =>
        string.IsNullOrWhiteSpace(invoiceNo)
        || string.IsNullOrWhiteSpace(billOfLading)
        || string.IsNullOrWhiteSpace(packingList);

    // ======================= R15 (Design 1a) — step-1 schedule-grid derived state =======================

    // §9.1 warehouse lock — the first selected schedule fixes the warehouse; null address ids participate as a
    // legitimate lock value (legacy lines), so the lock is "has a selection", not "has a non-null id".
    private Guid? lockedWarehouseId => selectedSchedules.Values.Select(s => s.WarehouseAddressId).FirstOrDefault();
    private string? lockedWarehouseLabel
    {
        get
        {
            var s = selectedSchedules.Values.FirstOrDefault();
            if (s is null) return null;
            return string.IsNullOrWhiteSpace(s.WarehouseAddressName)
                ? (string.IsNullOrWhiteSpace(s.Warehouse) ? "—" : s.Warehouse)
                : $"{s.Warehouse} · {s.WarehouseAddressName}";
        }
    }

    // The selectable universe inside the locked warehouse (balance left + shippable), across the WHOLE cached
    // sweep — "Select all in this warehouse" deliberately ignores the client-side filters.
    private IEnumerable<DeliveryScheduleDto> LockedWarehousePool =>
        selectedSchedules.Count == 0
            ? Enumerable.Empty<DeliveryScheduleDto>()
            : scheduleRows.Where(r => r.WarehouseAddressId == lockedWarehouseId && r.RemainingToShip > 0 && r.IsShippable);

    private bool AllLockedSelected =>
        LockedWarehousePool.Any() && LockedWarehousePool.All(r => selectedSchedules.ContainsKey(r.Id));

    // Grid rows after the client-side filters, sorted PO → position → delivery date so the PO banding groups.
    //
    // 2026-08-11 — a SELECTED row is never filtered out, by anything. Two of the filters now hide rows the
    // supplier did not ask to hide: the fully-shipped rule, and the current-month date window the grid opens
    // with. Either could swallow a row that is already picked — a saved draft whose delivery date falls in
    // another month, or a line whose balance a concurrent ASN consumed after the pick — leaving the footer
    // count, the warehouse lock and the saved ASN referring to something invisible.
    private IEnumerable<DeliveryScheduleDto> VisibleScheduleRows =>
        scheduleRows
            .Where(r => selectedSchedules.ContainsKey(r.Id) || PassesGridFilters(r))
            .OrderBy(r => r.PoNumber).ThenBy(r => r.PositionNo).ThenBy(r => r.DeliveryDate);

    private bool PassesGridFilters(DeliveryScheduleDto r)
    {
        // Nothing left to ship — the row can never be picked, so it is pure noise on a picker.
        if (r.RemainingToShip <= 0) return false;
        if (!string.IsNullOrEmpty(gridWarehouseFilter) && Guid.TryParse(gridWarehouseFilter, out var wid)
            && r.WarehouseAddressId != wid) return false;
        if (!string.IsNullOrWhiteSpace(lineSearch))
        {
            var t = lineSearch.Trim();
            var hit = r.PoNumber.Contains(t, StringComparison.OrdinalIgnoreCase)
                      || r.ItemCode.Contains(t, StringComparison.OrdinalIgnoreCase)
                      || (r.ItemDescription?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false);
            if (!hit) return false;
        }
        if (gridDateFrom.HasValue && r.DeliveryDate < gridDateFrom.Value.Date) return false;
        if (gridDateTo.HasValue && r.DeliveryDate >= gridDateTo.Value.Date.AddDays(1)) return false;
        return true;
    }

    private sealed record GridWarehouseOption(Guid Id, string Name);
    private List<GridWarehouseOption> GridWarehouseOptions =>
        scheduleRows.Where(r => r.WarehouseAddressId.HasValue)
            .Select(r => new GridWarehouseOption(r.WarehouseAddressId!.Value,
                string.IsNullOrWhiteSpace(r.WarehouseAddressName) ? (r.Warehouse ?? "—") : r.WarehouseAddressName!))
            .DistinctBy(o => o.Id)
            .OrderBy(o => o.Name)
            .ToList();

    // ======================= 2026-08-11 — which wizard steps a status may show =======================
    // The internal step ids never move (1 Lines · 2 Quantities · 3 Shipment · 4 Review), so every existing
    // reference — CanProceed, the SaveDraft error routing, the ?step= deep link — keeps its meaning. What varies
    // is WHICH ids render, and the stepper numbers them by position.
    //
    // An ASN is editable in three states (AsnDtoBuilder.IsLocked): Draft, Rejected, Approved. Approved means the
    // BUYER already confirmed this exact line set and these exact quantities, so changing either behind their
    // back is the defect; R14 (D5) kept Approved editable for a narrower reason — the supplier still has to fill
    // in the shipment references and upload the Packing List / Invoice before posting. That is Shipment + Review.
    private bool CanEditLines => IsNew || detail is null || detail.AsnStatus is "Draft" or "Rejected";

    private List<int> VisibleSteps => CanEditLines
        ? new List<int> { 1, 2, 3, 4 }
        : new List<int> { 3, 4 };

    private int FirstStep => VisibleSteps[0];
    private int LastStep => VisibleSteps[^1];
    /// <summary>Position of a step in the visible sequence, 1-based — what the stepper actually prints.</summary>
    private int StepOrdinal(int step) => VisibleSteps.IndexOf(step) + 1;
    /// <summary>Clamps a step id onto the visible set (a hidden id lands on the first visible step).</summary>
    private int ClampStep(int step) => VisibleSteps.Contains(step) ? step : FirstStep;

    private bool CanProceed => currentStep switch
    {
        // Step 1 (R15) — ≥1 schedule line picked. Edit mode also passes on legacy lines that have no matching
        // schedule row (they live only in `lines`) so a pre-R15 draft is never stranded.
        1 => selectedSchedules.Count > 0 || lines.Count > 0,
        // Step 2 also gates on serial/lot capture: every serialized line must have N serials and every lot line
        // must have Σqty == ShippedQty (no dupes). The backend SubmitAsnCommand re-enforces; this blocks early.
        2 => lines.Any(l => l.ShippedQty > 0) && SerialLotCaptureValid,
        3 => expectedDeliveryDate.HasValue,
        _ => true
    };

    // R4 (2026-06-27) — client-side over-ship UX: restrict the supplier as soon as the entered ship qty exceeds the
    // order qty + over-ship tolerance ceiling (OverShipAllowance), instead of only failing at submit; and lock a row
    // that has no remaining ship capacity. The server atomic guard (behind Fulfilment.EnforceOverShipGuard) remains
    // the authoritative check.
    private static bool OverAllowance(LineRow l) => l.ShippedQty > l.OverShipAllowance;
    private static bool FullyShipped(LineRow l) => l.OverShipAllowance <= 0;

    // Surface the over-ship dialog the moment the Ship Qty field loses focus (not only on Next).
    private void OnShipQtyBlur(LineRow l) { if (OverAllowance(l)) showOverShip = true; }

    // Reload whenever the route id changes — Blazor REUSES this component across /asns/new -> /asns/{id}
    // (the save-draft navigation), so OnInitializedAsync (once-only) would leave detail=null => "ASN not found".
    private Guid? _loadedId;
    private bool _loadedNew;
    // R5 (§9.2) — one-shot guard so ?step= is honored on the FIRST existing-ASN load only (not on the save-draft
    // re-navigation or later re-renders). Once applied it stays true for the component's lifetime.
    private bool _startStepApplied;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Id || (IsNew && !_loadedNew))
        {
            _loadedId = Id;
            _loadedNew = IsNew;
            currentStep = 1;
            await Reload();
        }
    }

    // R5 (§13) — the AttachmentPanel raises this after every upload/remove. Refresh the lightweight count the
    // step-4 review summary shows from the by-asn list endpoint (the panel owns the actual files + their display).
    private async Task OnPanelChanged()
    {
        if (!Id.HasValue) return;
        var resp = await Api.GetAsync<List<DocumentAttachmentDto>>($"api/document-uploads/by-asn/{Id.Value}");
        attachments.Clear();
        if (resp?.Data is { } docs) attachments.AddRange(docs);
        StateHasChanged();
    }

    private async Task Reload()
    {
        loading = true;
        if (IsNew)
        {
            // Suppliers the signed-in user can act for (seccode-scoped). Supplier-first picker when >1.
            var sup = await Api.GetAsync<List<SupplierListItemDto>>("api/suppliers");
            suppliers = sup?.Data ?? new();
            if (!string.IsNullOrWhiteSpace(PreselectSchedules))
                await ApplySchedulePreselectAsync();
            else if (suppliers.Count == 1)
                await ChooseSupplierAsync(suppliers[0].Id);
            loading = false;
        }
        else
        {
            var resp = await Api.GetAsync<AsnDetailDto>($"api/asns/{Id}");
            detail = resp?.Data;
            if (detail != null)
            {
                attachSupplierId = detail.SupplierId;
                expectedDeliveryDate = detail.ExpectedDeliveryDate;
                timeWindow = detail.TimeWindow;
                carrierName = detail.CarrierName;
                trackingNumber = detail.TrackingNumber;
                vehicleNumber = detail.VehicleNumber;
                driverName = detail.DriverName;
                driverPhone = detail.DriverPhone;
                notes = detail.Notes;
                invoiceNo = detail.InvoiceNo;
                billOfLading = detail.BillOfLading;
                packingList = detail.PackingList;
                asnWarehouse = detail.Warehouse;
                asnCreatedOn = detail.CreatedOn;
                // R14 — the shipping date is the post date.
                asnShipmentDate = detail.PostedAt;

                attachments.Clear();
                attachments.AddRange(detail.Attachments);

                // R15 — reset the schedule-grid state for this ASN's supplier.
                selectedSchedules.Clear();
                scheduleRows = new();
                poDetailCache.Clear();
                selectedSupplierId = detail.SupplierId;
                selectedSupplierName = detail.SupplierName;
                // The supplier on an edited Draft is fixed to the ASN's supplier (single-entry list → no chooser).
                suppliers = new List<SupplierListItemDto> { new(detail.SupplierId, 0, "", detail.SupplierName, null, null, null, "", false, DateTime.UtcNow) };

                lines = detail.Lines.Select(l => new LineRow
                {
                    PurchaseOrderLineId = l.PurchaseOrderLineId,
                    PurchaseOrderId = l.PurchaseOrderId,
                    PoNumber = l.PoNumber,
                    PositionNo = l.PositionNo ?? l.PoPositionNo,
                    SequenceNo = l.SequenceNo,
                    ItemCode = l.ItemCode,
                    OrderQty = l.OrderQty,
                    ShippedQty = l.ShippedQty,
                    BatchNumber = l.BatchNumber,
                    ExpiryDate = l.ExpiryDate,
                    // R15 — schedule provenance (null on legacy PO-picked lines): drives the step-1 pre-check and
                    // the Quantities Delivery column.
                    DeliveryScheduleId = l.DeliveryScheduleId,
                    DeliveryDate = l.ScheduleDeliveryDate,
                    // AsnLineDto carries no Item flag — infer the line type from which capture collection is
                    // populated (serialized XOR lot-controlled). Re-merged with PO flags below for empty lines.
                    IsSerialized = l.Serials is { Count: > 0 },
                    IsLotControlled = l.Lots is { Count: > 0 },
                    Serials = l.Serials?.Select(s => new SerialRow { Serial = s.SerialNumber, Expiry = s.ExpiryDate }).ToList() ?? new(),
                    Lots = l.Lots?.Select(x => new LotRow { LotNo = x.LotNo, Qty = x.Qty, ExpiryDate = x.ExpiryDate }).ToList() ?? new(),
                    // R4 (2026-06-26) — §7.3 / DI-04: ship-tracking from the ASN line (EnrichLinesAsync re-merges the
                    // PO line's authoritative figures for editable drafts; the locked read-only view uses these).
                    ShippedQtyToDate = l.ShippedQtyToDate,
                    Balance = l.Balance,
                    OverShipAllowance = l.OverShipAllowance
                }).ToList();

                // R15 — an editable ASN shows ONLY its own lines (the old ReloadLines() PO sweep — which merged in
                // EVERY line of every covered PO — is gone; that was the "from-schedule ASN shows all PO lines" bug).
                // Load the supplier's approved schedule grid, pre-check the rows behind this ASN's lines so step 1
                // reflects the saved selection, then enrich only these lines with the PO-line flags/allowance.
                if (!IsLocked)
                {
                    await LoadSchedulesAsync();
                    PrecheckSchedulesFromLines();
                    await EnrichLinesAsync();
                }

                // R5 (§9.2) — honor ?step= ONCE: the delivery-schedule flow lands on /asns/{id}?step=2 to open
                // directly on Lines. Only for an EXISTING ASN that already has lines, and only on the first load
                // (guarded so the save-draft re-navigation / later re-renders never re-jump the wizard). An
                // IsLocked ASN renders the read-only view (no wizard) so the clamp is harmless there.
                if (!_startStepApplied && StartStep.HasValue && lines.Count > 0)
                {
                    currentStep = Math.Clamp(StartStep.Value, 1, 4);
                }
                _startStepApplied = true;

                // 2026-08-11 — the status is only known NOW (OnParametersSetAsync reset the step before the fetch),
                // so land the wizard on a step this status actually shows: an Approved ASN has no Lines/Quantities
                // step, and leaving currentStep on a hidden id would render an empty wizard body.
                currentStep = ClampStep(currentStep);
            }
            loading = false;
        }
    }

    private async Task OnSupplierSelect(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id)) { await ChooseSupplierAsync(id); }
        else
        {
            selectedSupplierId = null; selectedSupplierName = null;
            // Clearing the supplier also clears the schedule grid + selection.
            selectedSchedules.Clear(); lines.Clear(); scheduleRows = new(); poDetailCache.Clear();
        }
    }

    private async Task ChooseSupplierAsync(Guid supplierId)
    {
        selectedSupplierId = supplierId;
        attachSupplierId = supplierId;   // create-mode staging uploads stamp this supplier's seccode
        selectedSupplierName = suppliers.FirstOrDefault(s => s.Id == supplierId)?.LegalName;
        // Switching supplier resets the grid (an ASN ships from a single supplier).
        selectedSchedules.Clear(); lines.Clear(); poDetailCache.Clear();
        lineSearch = string.Empty; gridWarehouseFilter = string.Empty;
        gridDateFrom = MonthStart(); gridDateTo = MonthEnd();   // back to the default window, not to unbounded
        await LoadSchedulesAsync();
    }

    // R15 (D1/D2) — ONE Approved-only sweep per supplier (hard gate; pageSize 500 mirrors the delivery-schedules
    // page option sweep). The step-1 grid filters this cache client-side.
    private async Task LoadSchedulesAsync()
    {
        if (!selectedSupplierId.HasValue) { scheduleRows = new(); return; }
        schedulesLoading = true; StateHasChanged();
        var url = $"api/delivery-schedules?page=1&pageSize=500&supplierId={selectedSupplierId}&status=Approved";
        var resp = await Api.GetAsync<DeliveryScheduleGridDto>(url);
        scheduleRows = resp?.Data?.Page.Items.ToList() ?? new();
        schedulesLoading = false;
    }

    // Edit mode — reflect the ASN's saved lines in the step-1 grid: check each line's schedule row (by the
    // persisted back-link), and ASSOCIATE legacy lines (null back-link) with the first free schedule row of the
    // same PO line so re-saving starts carrying the provenance. A line with no schedule row at all stays only in
    // `lines` (still editable/shippable — never silently dropped).
    private void PrecheckSchedulesFromLines()
    {
        var byId = scheduleRows.ToDictionary(r => r.Id);
        foreach (var line in lines)
        {
            if (line.DeliveryScheduleId is { } sid && byId.TryGetValue(sid, out var row))
            {
                selectedSchedules[row.Id] = row;
                line.DeliveryDate ??= row.DeliveryDate;
                line.ScheduledQty = row.ScheduledQty;
                continue;
            }
            var fallback = scheduleRows.FirstOrDefault(r =>
                r.PurchaseOrderLineId == line.PurchaseOrderLineId && !selectedSchedules.ContainsKey(r.Id));
            if (fallback is not null)
            {
                line.DeliveryScheduleId = fallback.Id;
                line.DeliveryDate ??= fallback.DeliveryDate;
                line.ScheduledQty = fallback.ScheduledQty;
                selectedSchedules[fallback.Id] = fallback;
            }
        }
    }

    // R15 — ?supplier&schedules deep link from the delivery-schedules page: choose the supplier, load its grid,
    // check the listed schedule rows (ids not in the Approved sweep are skipped), and land on Quantities.
    private async Task ApplySchedulePreselectAsync()
    {
        var ids = (PreselectSchedules ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => Guid.TryParse(s, out var g) ? g : Guid.Empty).Where(g => g != Guid.Empty).Distinct().ToHashSet();
        if (ids.Count == 0) return;

        var supplierId = PreselectSupplier
            ?? (suppliers.Count == 1 ? suppliers[0].Id : (Guid?)null);
        if (!supplierId.HasValue || suppliers.All(s => s.Id != supplierId.Value)) return;

        await ChooseSupplierAsync(supplierId.Value);
        foreach (var row in scheduleRows.Where(r => ids.Contains(r.Id)))
        {
            // Respect the same rules as a manual pick (balance, shippable, single warehouse).
            if (row.RemainingToShip <= 0 || !row.IsShippable) continue;
            if (selectedSchedules.Count > 0 && row.WarehouseAddressId != lockedWarehouseId) continue;
            selectedSchedules[row.Id] = row;
        }
        if (selectedSchedules.Count > 0)
        {
            RebuildLinesFromSelection();
            await EnrichLinesAsync();
            currentStep = ClampStep(2);   // land on Quantities — the selection is already made
        }
    }

    // ---- Step-1 selection ops (mirror the delivery-schedules page §9.1 rules) ----

    private async Task ToggleScheduleRow(DeliveryScheduleDto row)
    {
        if (!selectedSchedules.Remove(row.Id))
        {
            if (row.RemainingToShip <= 0 || !row.IsShippable) return;
            if (selectedSchedules.Count > 0 && row.WarehouseAddressId != lockedWarehouseId) return;   // cross-warehouse guard
            selectedSchedules[row.Id] = row;
        }
        RebuildLinesFromSelection();
        await EnrichLinesAsync();
    }

    private async Task SelectAllInLockedWarehouse()
    {
        foreach (var r in LockedWarehousePool) selectedSchedules[r.Id] = r;
        RebuildLinesFromSelection();
        await EnrichLinesAsync();
    }

    private async Task ToggleAllInLockedWarehouse()
    {
        if (selectedSchedules.Count == 0) return;
        if (AllLockedSelected)
        {
            ClearScheduleSelection();
            return;
        }
        await SelectAllInLockedWarehouse();
    }

    private void ClearScheduleSelection()
    {
        selectedSchedules.Clear();
        RebuildLinesFromSelection();
    }

    // Rebuild the working line set from the schedule selection. Rows keep their entered qty/batch/capture across
    // select/deselect (keyed by schedule id); LEGACY rows (no schedule link — pre-R15 drafts) are always kept.
    // D4 — a NEW row's ship qty defaults to min(ScheduledQty, remaining balance).
    private void RebuildLinesFromSelection()
    {
        var byScheduleId = lines.Where(l => l.DeliveryScheduleId.HasValue)
            .ToDictionary(l => l.DeliveryScheduleId!.Value);
        var keep = lines.Where(l => !l.DeliveryScheduleId.HasValue).ToList();

        foreach (var s in selectedSchedules.Values)
        {
            if (byScheduleId.TryGetValue(s.Id, out var prev)) { keep.Add(prev); continue; }
            keep.Add(new LineRow
            {
                DeliveryScheduleId = s.Id,
                PurchaseOrderLineId = s.PurchaseOrderLineId,
                PurchaseOrderId = s.PurchaseOrderId,
                PoNumber = s.PoNumber,
                PositionNo = s.PositionNo,
                ItemCode = s.ItemCode,
                OrderQty = s.OrderQty,
                DeliveryDate = s.DeliveryDate,
                ScheduledQty = s.ScheduledQty,
                ShippedQty = Math.Max(0m, Math.Min(s.ScheduledQty, s.RemainingToShip)),
                ShippedQtyToDate = s.ShippedQtyToDate,
                Balance = s.RemainingToShip,
                // Provisional until EnrichLinesAsync merges the tolerance-adjusted ceiling off the PO line.
                OverShipAllowance = s.RemainingToShip,
            });
        }

        lines = keep
            .OrderBy(l => l.PoNumber).ThenBy(l => l.PositionNo)
            .ThenBy(l => l.DeliveryDate ?? DateTime.MaxValue)
            .ToList();
    }

    // Enrich the working rows with the PO-LINE figures the schedule row doesn't carry: serial/lot capture flags,
    // the tolerance-adjusted OverShipAllowance, live Balance/ShippedQtyToDate and SequenceNo. One PO-detail fetch
    // per covered PO (cached per supplier session); merges onto the SELECTED rows only — never adds rows.
    private async Task EnrichLinesAsync()
    {
        if (lines.Count == 0) return;
        linesLoading = true;
        StateHasChanged();
        foreach (var poId in lines.Select(l => l.PurchaseOrderId).Distinct().ToList())
        {
            if (poDetailCache.ContainsKey(poId)) continue;
            var resp = await Api.GetAsync<PurchaseOrderDetailDto>($"api/purchase-orders/{poId}");
            if (resp?.Data != null) poDetailCache[poId] = resp.Data;
        }
        foreach (var line in lines)
        {
            if (!poDetailCache.TryGetValue(line.PurchaseOrderId, out var po)) continue;
            var pol = po.Lines.FirstOrDefault(x => x.Id == line.PurchaseOrderLineId);
            if (pol == null) continue;
            line.SequenceNo = pol.SequenceNo;
            line.OrderQty = pol.OrderQty;
            line.IsSerialized = pol.IsSerialized;
            line.IsLotControlled = pol.IsLotControlled;
            line.ShippedQtyToDate = pol.ShippedQtyToDate;
            line.Balance = pol.Balance;
            line.OverShipAllowance = pol.OverShipAllowance;
            line.IsOverShippedQtyReduced = pol.IsOverShippedQtyReduced;
        }
        linesLoading = false;
        StateHasChanged();
    }

    // Navigation walks VisibleSteps by position, so a hidden step is never landed on (2026-08-11).
    private void GoStep(int s) { if (VisibleSteps.Contains(s) && s <= currentStep) currentStep = s; }
    private void PrevStep()
    {
        var i = VisibleSteps.IndexOf(currentStep);
        if (i > 0) currentStep = VisibleSteps[i - 1];
    }
    private void NextStep()
    {
        // Over-ship: surface a dialog naming the offending lines rather than silently disabling Next (§7 guard).
        if (currentStep == 2 && lines.Any(OverAllowance)) { showOverShip = true; return; }
        var i = VisibleSteps.IndexOf(currentStep);
        if (i >= 0 && i < VisibleSteps.Count - 1 && CanProceed) currentStep = VisibleSteps[i + 1];
    }
    private string StepLabel(int s) => s switch { 1 => "Lines", 2 => "Quantities", 3 => "Shipment", 4 => "Review", _ => "" };

    // ---- Save draft (create or update) ----
    private async Task SaveDraft()
    {
        if (lines.Count == 0 || !expectedDeliveryDate.HasValue) { submitError = "Select at least one line and an expected delivery date."; currentStep = ClampStep(lines.Count == 0 ? 1 : 3); return; }
        busy = true; savingDraft = true; submitError = string.Empty;

        var lineReqs = BuildLineRequests();
        if (lineReqs.Count == 0) { submitError = "Enter a ship quantity on at least one line."; busy = false; savingDraft = false; currentStep = ClampStep(2); return; }

        if (IsNew)
        {
            await CreateDraftAsync(lineReqs, overrideReason: null);
        }
        else
        {
            var req = new UpdateAsnRequest(expectedDeliveryDate.Value, timeWindow, carrierName, trackingNumber, vehicleNumber, driverName, driverPhone, notes, lineReqs,
                InvoiceNo: invoiceNo, BillOfLading: billOfLading, PackingList: packingList);
            var resp = await Api.PutAsync<AsnDetailDto, UpdateAsnRequest>($"api/asns/{Id}", req);
            if (resp?.Success == true) { Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Draft saved" }); await Reload(); }
            else { submitError = resp?.Errors?.FirstOrDefault() ?? "Failed to save (the ASN may no longer be Draft)."; }
        }
        busy = false; savingDraft = false;
    }

    // ---- R5 (§10.2) Send for approval (Draft/Rejected -> PendingApproval) ----
    // R14 — the attachment-requirement check and the mandatory shipment references BOTH moved off this path to
    // Post, so a supplier can obtain buyer confirmation before the documents exist. This call now only has to get
    // past the PO ship gate.
    private async Task SendForApproval()
    {
        if (IsNew) { await SaveDraft(); return; }
        busy = true; savingDraft = false; submitError = string.Empty;

        // Block the obvious serial/lot failures before the round-trip (the backend re-enforces at Post).
        if (!SerialLotCaptureValid)
        {
            submitError = "Fix the serial/lot capture before sending: every serialized line needs one serial per unit, and every lot line's quantities must sum to the shipped quantity (no duplicates).";
            busy = false; currentStep = ClampStep(2); return;
        }

        if (!await SavePendingEditsAsync("sending for approval")) { busy = false; return; }

        await SendForApprovalAsync(acknowledgeMissingAttachments: false);
        busy = false;
    }

    // ---- R14 Post (Approved -> Submitted, or Draft -> Submitted when the supplier needs no confirmation) ----
    // The ERP dispatch. Everything deferred from send-for-approval lands here server-side: the three mandatory
    // shipment references, the attachment policy (Mandatory blocks / Warning two-step), the PO confirmation gate
    // (with the §6.5 admin override), the over-ship balance guard, draft-invoice generation and the LN outbox.
    private async Task PostAsn()
    {
        if (IsNew) { await SaveDraft(); return; }
        busy = true; savingDraft = false; submitError = string.Empty;

        if (!SerialLotCaptureValid)
        {
            submitError = "Fix the serial/lot capture before posting: every serialized line needs one serial per unit, and every lot line's quantities must sum to the shipped quantity (no duplicates).";
            busy = false; currentStep = ClampStep(2); return;
        }

        // Client-side pre-check on the three references so the supplier is sent straight to the field that is
        // missing rather than bouncing off a 400. The server enforces them regardless.
        var missingRefs = new List<string>();
        if (string.IsNullOrWhiteSpace(invoiceNo)) missingRefs.Add("invoice no.");
        if (string.IsNullOrWhiteSpace(billOfLading)) missingRefs.Add("bill of lading");
        if (string.IsNullOrWhiteSpace(packingList)) missingRefs.Add("packing list");
        if (missingRefs.Count > 0)
        {
            submitError = $"Fill in {string.Join(", ", missingRefs)} before posting the ASN.";
            busy = false; currentStep = 3; return;
        }

        if (!await SavePendingEditsAsync("posting")) { busy = false; return; }

        await PostAsnAsync(acknowledgeMissingAttachments: false, overrideReason: null);
        busy = false;
    }

    // Persist pending header/line edits before a final action. Both final actions validate the STORED ASN, and an
    // edit on a Rejected ASN flips it back to Draft server-side (an Approved one stays Approved).
    private async Task<bool> SavePendingEditsAsync(string actionLabel)
    {
        var lineReqs = BuildLineRequests();
        var upd = new UpdateAsnRequest(expectedDeliveryDate!.Value, timeWindow, carrierName, trackingNumber, vehicleNumber, driverName, driverPhone, notes, lineReqs,
                InvoiceNo: invoiceNo, BillOfLading: billOfLading, PackingList: packingList);
        var saveResp = await Api.PutAsync<AsnDetailDto, UpdateAsnRequest>($"api/asns/{Id}", upd);
        if (saveResp?.Success == true) return true;
        submitError = saveResp?.Errors?.FirstOrDefault() ?? $"Could not save before {actionLabel}.";
        return false;
    }

    // ---- Create draft (with optional gate override). On a gate block, route to the override dialog. ----
    private async Task CreateDraftAsync(List<CreateAsnLineRequest> lineReqs, string? overrideReason)
    {
        // R15 — the PO set derives from the lines actually being shipped (there is no PO picker anymore).
        var poList = lines.Where(l => l.ShippedQty > 0).Select(l => l.PurchaseOrderId).Distinct().ToList();
        var req = new CreateAsnRequest(
            poList.Count == 1 ? poList[0] : (Guid?)null,
            poList.Count > 1 ? poList : null,
            expectedDeliveryDate!.Value, timeWindow, carrierName, trackingNumber, vehicleNumber, driverName, driverPhone, notes, lineReqs,
            StagingKey: _stagingKey,
            OverrideReason: string.IsNullOrWhiteSpace(overrideReason) ? null : overrideReason.Trim(),
            InvoiceNo: invoiceNo, BillOfLading: billOfLading, PackingList: packingList);
        var resp = await Api.PostAsync<AsnDetailDto, CreateAsnRequest>("api/asns", req);
        if (resp?.Success == true && resp.Data != null)
        {
            showGateOverride = false;
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Draft ASN created" });
            // Navigate to the saved draft so attachments (ownerEntityType='Asn') become available + submit is enabled.
            // ?step=4 keeps the reused component on Review instead of resetting to step 1 (PO select) — it reuses the
            // one-shot StartStep machinery, so saving a draft leaves the supplier on the review page.
            NavMgr.NavigateToRoute($"/asns/{resp.Data.Id}?step=4");
            return;
        }
        var err = resp?.Errors?.FirstOrDefault();
        if (IsGateBlock(err)) { OpenGateOverride(err!); }
        else { submitError = err ?? "Failed to create ASN."; }
    }

    // ---- R5 (§10.2) Send-for-approval. ----
    // R14 — with the attachment guard moved to Post, this path can no longer return ConfirmationRequired and can
    // no longer be blocked by a missing document. Only the PO ship gate can stop it.
    private async Task SendForApprovalAsync(bool acknowledgeMissingAttachments)
    {
        var body = new SendForApprovalRequest(acknowledgeMissingAttachments);
        var resp = await Api.PostAsync<AsnDetailDto, SendForApprovalRequest>($"api/asns/{Id}/send-for-approval", body);

        // (1) Success — now PendingApproval.
        if (resp?.Success == true && resp.Data != null)
        {
            showAttachConfirm = false;
            detail = resp.Data;
            attachments.Clear();
            attachments.AddRange(resp.Data.Attachments);
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sent for approval", Detail = "The buyer will review and confirm this ASN. You can upload the shipping documents once it is confirmed." });
            await Reload();   // re-render in the locked/read-only PendingApproval view
            return;
        }

        // (2) Blocking error — PO gate, wrong state, or a supplier that needs no confirmation at all.
        submitError = resp?.Errors?.FirstOrDefault()
            ?? "Could not send for approval (the ASN may no longer be Draft/Rejected).";
    }

    // ---- R14 Post — carries BOTH two-steps: the Warning-attachment confirm and the §6.5 PO gate override. ----
    private async Task PostAsnAsync(bool acknowledgeMissingAttachments, string? overrideReason)
    {
        var body = new PostAsnRequest(acknowledgeMissingAttachments,
            string.IsNullOrWhiteSpace(overrideReason) ? null : overrideReason.Trim());
        var resp = await Api.PostAsync<AsnDetailDto, PostAsnRequest>($"api/asns/{Id}/post", body);

        // (1) Success — Submitted, dispatched to the ERP, shipping date stamped.
        if (resp?.Success == true && resp.Data != null)
        {
            showAttachConfirm = false;
            showGateOverride = false;
            detail = resp.Data;
            attachments.Clear();
            attachments.AddRange(resp.Data.Attachments);
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "ASN posted",
                Detail = resp.Data.PostedAt is { } p
                    ? $"Sent to the ERP. Shipping date recorded as {p:dd MMM yyyy}."
                    : "Sent to the ERP.",
            });
            await Reload();   // re-render read-only (Submitted)
            return;
        }

        // (2) Warning attachments missing — 200 ConfirmationRequired, nothing committed.
        if (resp?.ConfirmationRequired == true)
        {
            attachConfirmMessage = string.IsNullOrEmpty(resp.ConfirmationMessage)
                ? "One or more required attachments were not uploaded, do you wish to proceed?"
                : resp.ConfirmationMessage!;
            attachMissing = resp.MissingAttachments ?? new();
            confirmingPost = true;
            showAttachConfirm = true;
            return;
        }

        // (3) PO confirmation gate — offer the §6.5 override to a caller who holds PurchaseOrder.OverrideGate.
        var err = resp?.Errors?.FirstOrDefault();
        if (IsGateBlock(err)) { gateOverrideForPost = true; OpenGateOverride(err!); return; }

        // (4) Blocking error — mandatory attachment, missing refs, over-ship, wrong state.
        submitError = err ?? "Could not post the ASN (a mandatory attachment or shipment reference may be missing).";
    }

    // The PO confirmation-gate override dialog fires on CREATE and — R14 — on POST, which is where the submit-time
    // gate now lives. gateOverrideForPost records which one so ConfirmGateOverride retries the right call.
    private void OpenGateOverride(string message)
    {
        gateBlockMessage = message;
        gateOverrideReason = string.Empty;
        gateOverrideError = string.Empty;
        showAttachConfirm = false;
        showGateOverride = true;
    }

    private async Task ConfirmGateOverride()
    {
        if (string.IsNullOrWhiteSpace(gateOverrideReason)) { gateOverrideError = "A reason is required to override the gate."; return; }
        busy = true; gateOverrideError = string.Empty; submitError = string.Empty;
        // R14 — two paths can reach the gate: CREATE (§6.5) and POST (the submit-time gate, moved here from the
        // buyer's Approve). Retry whichever one raised it.
        if (gateOverrideForPost)
        {
            await PostAsnAsync(acknowledgeMissingAttachments: false, overrideReason: gateOverrideReason);
        }
        else
        {
            var lineReqs = BuildLineRequests();
            await CreateDraftAsync(lineReqs, gateOverrideReason);
        }
        busy = false;
    }

    // Re-send acknowledging the missing Warning attachments (§13.6 two-step).
    // R14 — only the Post path can raise this now, but the flag keeps the dialog honest if that ever changes.
    private async Task ConfirmSubmitWithMissingAttachments()
    {
        busy = true; submitError = string.Empty;
        if (confirmingPost)
            await PostAsnAsync(acknowledgeMissingAttachments: true, overrideReason: null);
        else
            await SendForApprovalAsync(acknowledgeMissingAttachments: true);
        busy = false;
    }

    // ============================ R5 (§10.2) buyer Approve / Reject ============================
    private void OpenApproveDialog() { approveError = string.Empty; showApprove = true; }
    private void OpenRejectDialog() { rejectReason = string.Empty; rejectError = string.Empty; showReject = true; }

    // Approve runs the SUBMIT path server-side: the over-ship atomic guard consumes balance, the ASN flips to
    // Submitted and a draft invoice is created. If the balance was lost after approval (UC-AP-05) Submit fails and the
    // ASN stays PendingApproval — we surface that message in the dialog.
    private async Task DoApprove()
    {
        busy = true; approveError = string.Empty;
        var resp = await Api.PostAsync<AsnDetailDto, ApproveAsnRequest>($"api/asns/{Id}/approve", new ApproveAsnRequest());
        if (resp?.Success == true && resp.Data != null)
        {
            showApprove = false;
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "ASN approved", Detail = resp.Data.DraftInvoiceId.HasValue ? "The shipment was submitted and a draft invoice created." : "The shipment was submitted." });
            await Reload();
        }
        else
        {
            approveError = resp?.Errors?.FirstOrDefault() ?? "Could not approve (the shipment balance may have changed, or you are not a mapped buyer for this ASN).";
        }
        busy = false;
    }

    // Reject needs a mandatory reason; no balance was consumed so there is no reversal. The ASN returns to Rejected and
    // the supplier is notified (best-effort, server-side).
    private async Task DoReject()
    {
        if (string.IsNullOrWhiteSpace(rejectReason)) { rejectError = "A reason is required to reject."; return; }
        busy = true; rejectError = string.Empty;
        var resp = await Api.PostAsync<AsnDetailDto, RejectAsnRequest>($"api/asns/{Id}/reject", new RejectAsnRequest(rejectReason.Trim()));
        if (resp?.Success == true)
        {
            showReject = false;
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "ASN rejected", Detail = "The supplier can edit and re-send it for approval." });
            await Reload();
        }
        else
        {
            rejectError = resp?.Errors?.FirstOrDefault() ?? "Could not reject (it may no longer be PendingApproval, or you are not a mapped buyer).";
        }
        busy = false;
    }

    // ---- Cancel ----
    private void OpenCancelDialog() { dialogError = string.Empty; showCancel = true; }

    private async Task DoCancel()
    {
        busy = true; dialogError = string.Empty;
        var resp = await Api.PostAsync<object>($"api/asns/{Id}/cancel", new { });
        if (resp?.Success == true) { Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "ASN cancelled" }); showCancel = false; await Reload(); }
        else { dialogError = resp?.Errors?.FirstOrDefault() ?? "Could not cancel (it may already be Cancelled)."; }
        busy = false;
    }

    // R5 (§13) — attachment upload/list/remove moved into the reusable AttachmentPanel (Components/Shared).
    // OnPanelChanged (above) keeps the page's review-summary count in sync; the panel handles the rest.

    // R4 (2026-06-26) — §7.3 / §5.3 / DI-04: render the nominal balance + the over-ship allowance SEPARATELY, plus
    // the "qty reduced below shipped" exception flag. Shared shape for the wizard (LineRow) and the locked view
    // (AsnLineDto) via the two thin wrappers below.
    private static RenderFragment RenderBalance(decimal balance, decimal overShipAllowance, bool overShippedReduced) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style", "display:flex;flex-direction:column;gap:2px;font-family:Inter,monospace;");

        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, $"Balance {balance.ToString("0.###")}");
        builder.CloseElement();

        if (overShipAllowance - balance > 0)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "font-size:10.5px;color:var(--mer-ink-500);");
            builder.AddContent(seq++, $"over-ship allowance up to {overShipAllowance.ToString("0.###")}");
            builder.CloseElement();
        }

        if (overShippedReduced)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "tlg-status tlg-status--danger");
            builder.AddAttribute(seq++, "title", "Order qty was revised below the quantity already shipped");
            builder.AddAttribute(seq++, "style", "font-family:'Plus Jakarta Sans',sans-serif;width:fit-content;margin-top:2px;");
            builder.AddContent(seq++, "qty reduced below shipped");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment BalanceCell(LineRow l) => RenderBalance(l.Balance, l.OverShipAllowance, l.IsOverShippedQtyReduced);
    // AsnLineDto carries no IsOverShippedQtyReduced (it's a PO-line concept) — pass false in the locked view.
    private RenderFragment DetailBalanceCell(AsnLineDto l) => RenderBalance(l.Balance, l.OverShipAllowance, false);

    private void BackToList() => NavMgr.NavigateToRoute("/asns");

    private string StatusClass(string status) => status switch
    {
        // R14 — Approved reads as a positive milestone (the buyer confirmed), distinct from the in-flight
        // "waiting on someone" states; it still needs the supplier's Post to become Submitted.
        "Delivered" or "Approved" => "tlg-status--active",
        // R5 (§10.1) — PendingApproval sits between Draft and Approved; treated like the other in-flight states.
        "Submitted" or "InTransit" or "PendingApproval" => "tlg-status--pending",
        "Cancelled" or "Rejected" => "tlg-status--danger",
        _ => "tlg-status--info"
    };

    // Build the line request set from the grid, mapping captured serials/lots onto each line. Only the
    // collection matching the line's type is populated (serialized XOR lot-controlled); the other stays null.
    private List<CreateAsnLineRequest> BuildLineRequests() =>
        lines.Where(l => l.ShippedQty > 0).Select(l =>
        {
            List<AsnLineSerialInput>? serials = null;
            List<AsnLineLotInput>? lots = null;
            if (l.IsSerialized)
                serials = l.Serials.Where(s => !string.IsNullOrWhiteSpace(s.Serial))
                    .Select(s => new AsnLineSerialInput(s.Serial.Trim(), s.Expiry)).ToList();
            else if (l.IsLotControlled)
                lots = l.Lots.Where(x => !string.IsNullOrWhiteSpace(x.LotNo) && (x.Qty ?? 0) > 0)
                    .Select(x => new AsnLineLotInput(x.LotNo.Trim(), x.Qty ?? 0, x.ExpiryDate)).ToList();
            // R15 — carry the schedule back-link so create AND update preserve provenance (null for legacy lines).
            return new CreateAsnLineRequest(l.PurchaseOrderLineId, l.ShippedQty, l.BatchNumber, l.ExpiryDate, serials, lots, l.DeliveryScheduleId);
        }).ToList();

    // ---- Serial / lot capture helpers (R4 2026-06-23) ----
    // Don't render thousands of textboxes for huge qty: render up to this many; the paste box still fills the rest.
    private const int SerialBoxCap = 200;

    // The step-2 capture sections render only for VALID shipped lines — qty within the over-ship allowance. An
    // over-shipped line generates NO serial/lot boxes (capturing N serials against an invalid qty makes no sense);
    // it shows the red border + over-ship dialog, and NextStep blocks advancing until the qty is corrected.
    private List<LineRow> SerialLines => lines.Where(l => l.IsSerialized && l.ShippedQty > 0 && !OverAllowance(l)).ToList();
    private List<LineRow> LotLines => lines.Where(l => l.IsLotControlled && l.ShippedQty > 0 && !OverAllowance(l)).ToList();

    // Grow the per-line serial slot list to N so the indexed @bind targets exist. New rows inherit the line's bulk
    // expiry (so "set expiry for all" then grow, or grow then "apply to all", both land the shared date).
    private static void EnsureSerialSlots(LineRow line, int need)
    {
        while (line.Serials.Count < need) line.Serials.Add(new SerialRow { Expiry = line._bulkExpiry });
        // Trim trailing extras only if the user reduced ShippedQty (keep what fits N).
        if (line.Serials.Count > need) line.Serials.RemoveRange(need, line.Serials.Count - need);
    }

    // R4 (2026-06-30) — bulk expiry: copy the line's _bulkExpiry onto every serial row (overwrites per-row edits —
    // the common case is one shared expiry). "Clear" nulls them all.
    private static void ApplyBulkExpiry(LineRow line)
    {
        EnsureSerialSlots(line, (int)line.ShippedQty);
        foreach (var s in line.Serials) s.Expiry = line._bulkExpiry;
    }

    private static void ClearExpiries(LineRow line)
    {
        line._bulkExpiry = null;
        foreach (var s in line.Serials) s.Expiry = null;
    }

    private static bool DuplicateSerial(LineRow line, int idx)
    {
        var v = line.Serials[idx].Serial?.Trim();
        if (string.IsNullOrEmpty(v)) return false;
        for (int j = 0; j < line.Serials.Count; j++)
            if (j != idx && string.Equals(line.Serials[j].Serial?.Trim(), v, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private static bool DuplicateLot(LineRow line, LotRow lot)
    {
        var v = lot.LotNo?.Trim();
        if (string.IsNullOrEmpty(v)) return false;
        return line.Lots.Count(x => string.Equals(x.LotNo?.Trim(), v, StringComparison.OrdinalIgnoreCase)) > 1;
    }

    // Paste → split on newline/comma → fill exactly N boxes; extras are ignored (warned). Cleaned non-empty.
    private static void ApplyPaste(LineRow line)
    {
        var need = (int)line.ShippedQty;
        var tokens = (line._pasteBuffer ?? string.Empty)
            .Split(new[] { '\n', '\r', ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        EnsureSerialSlots(line, need);
        var take = Math.Min(tokens.Count, need);
        for (int i = 0; i < take; i++) line.Serials[i].Serial = tokens[i];
        line._pasteWarn = tokens.Count > need ? $"{tokens.Count - need} extra serial(s) ignored (need {need})." : null;
        line._pasteBuffer = string.Empty;
    }

    // A serialized line is valid when exactly N non-empty serials are captured with no case-insensitive dupes.
    private static bool SerialLineValid(LineRow line, out string message)
    {
        var need = (int)line.ShippedQty;
        var vals = line.Serials.Select(s => s.Serial?.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
        if (vals.Count != need) { message = $"Captured {vals.Count} of {need} required serial(s)."; return false; }
        var distinct = vals.Select(s => s!.ToLowerInvariant()).Distinct().Count();
        if (distinct != vals.Count) { message = "Duplicate serial numbers on this line."; return false; }
        message = string.Empty; return true;
    }

    // A lot line is valid when Σqty == ShippedQty, every lot has a non-empty unique lotNo and a qty > 0.
    private static bool LotLineValid(LineRow line, out string message)
    {
        if (line.Lots.Count == 0) { message = "Add at least one lot."; return false; }
        if (line.Lots.Any(l => string.IsNullOrWhiteSpace(l.LotNo))) { message = "Every lot needs a lot number."; return false; }
        if (line.Lots.Any(l => (l.Qty ?? 0) <= 0)) { message = "Every lot needs a quantity greater than zero."; return false; }
        var dupes = line.Lots.GroupBy(l => l.LotNo!.Trim().ToLowerInvariant()).Any(g => g.Count() > 1);
        if (dupes) { message = "Duplicate lot numbers on this line."; return false; }
        if (line.Lots.Sum(l => l.Qty ?? 0) != line.ShippedQty) { message = $"Lot quantities must sum to {line.ShippedQty:0.###}."; return false; }
        message = string.Empty; return true;
    }

    // True only if EVERY serialized/lot line currently passes — gates Next on step 2 and the final submit.
    private bool SerialLotCaptureValid =>
        SerialLines.All(l => SerialLineValid(l, out _))
        && LotLines.All(l => LotLineValid(l, out _));

    private class LineRow
    {
        public Guid PurchaseOrderLineId { get; set; }
        public Guid PurchaseOrderId { get; set; }
        public string PoNumber { get; set; } = string.Empty;
        public int PositionNo { get; set; }
        public int? SequenceNo { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public decimal OrderQty { get; set; }
        public decimal ShippedQty { get; set; }
        public string? BatchNumber { get; set; }
        public DateTime? ExpiryDate { get; set; }

        // R15 — schedule provenance: the originating delivery schedule (null for legacy PO-picked lines), its
        // delivery date (Quantities column) and its scheduled qty (the D4 default: min(scheduled, balance)).
        public Guid? DeliveryScheduleId { get; set; }
        public DateTime? DeliveryDate { get; set; }
        public decimal ScheduledQty { get; set; }

        // R4 (2026-06-23) — Serial/Lot capture. Item flags (serialized XOR lot-controlled) drive which capture
        // section the line gets; Serials/Lots hold the captured values. ShippedQty is the required count/Σ.
        public bool IsSerialized { get; set; }
        public bool IsLotControlled { get; set; }
        public List<SerialRow> Serials { get; set; } = new();
        public List<LotRow> Lots { get; set; } = new();
        // R4 (2026-06-30) — bulk "expiry for all units" picker value (transient; copied onto each SerialRow.Expiry).
        public DateOnly? _bulkExpiry { get; set; }

        // R4 (2026-06-26) — §7.3 / §5.3 / DI-04: the PO-line ship-tracking figures shown on the ASN wizard. Balance
        // is nominal (MAX(0, orderQty − shippedQtyToDate)); OverShipAllowance is the tolerance-adjusted ceiling
        // headroom — shown SEPARATELY. IsOverShippedQtyReduced flags a line whose orderQty was revised below the
        // already-shipped cumulative (UC-ASN-10).
        public decimal ShippedQtyToDate { get; set; }
        public decimal Balance { get; set; }
        public decimal OverShipAllowance { get; set; }
        public bool IsOverShippedQtyReduced { get; set; }

        // Transient UI state (not persisted): the paste textarea buffer + the last paste warning for this line.
        public string? _pasteBuffer { get; set; }
        public string? _pasteWarn { get; set; }
    }

    // One captured serial row (serialized line): one physical unit = one serial + optional expiry. (R4 2026-06-30)
    private class SerialRow
    {
        public string Serial { get; set; } = string.Empty;
        public DateOnly? Expiry { get; set; }
    }

    // One captured lot row (lot-controlled line): lotNo + qty + optional expiry.
    private class LotRow
    {
        public string LotNo { get; set; } = string.Empty;
        public decimal? Qty { get; set; }
        public DateOnly? ExpiryDate { get; set; }
    }
}
