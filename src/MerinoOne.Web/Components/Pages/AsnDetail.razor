@page "/asns/new"
@page "/asns/{Id:guid}"
@inject ApiClient Api
@inject NavigationManager NavMgr
@inject TokenAccessor Token
@inject NotificationService Notif

<PageTitle>@(IsNew ? "New ASN" : detail?.AsnNumber)</PageTitle>

<div class="tl-page">
    <a href="asns" class="mer-back-link">
        <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;">arrow_back</span>
        Back to list
    </a>
    <header class="tl-header">
        <div>
            <div class="tl-title-row">
                <h1 class="tl-title">@(IsNew ? "Create ASN" : detail?.AsnNumber)</h1>
                @if (!IsNew && detail != null)
                {
                    <span class="tlg-status @StatusClass(detail.AsnStatus)">@detail.AsnStatus</span>
                    @if (IsLocked)
                    {
                        <span class="tl-count-chip" style="background:var(--mer-ink-100);color:var(--mer-ink-600);">
                            <span class="material-symbols-outlined" style="font-size:14px;vertical-align:middle;">lock</span> Read-only
                        </span>
                    }
                }
                else
                {
                    <span class="tl-count-chip">Step @currentStep of 4</span>
                }
            </div>
            <p class="tl-sub">@HeaderSubtitle</p>
        </div>
        <div class="tl-header__actions">
            @* R7 (§2.2) — document-rail toggle pill with the live fulfilment count. Rendered whenever the rail is
               (both the locked view and the wizard host one); the two-way Open state is shared with the rail.
               Hidden entirely when the entity has NO attachment-policy slots (no master requirement → no control):
               railSummary is null until the mounted rail's panel first reports, and TotalSlots>0 gates it on. *@
            @if (!loading && (IsNew || detail != null) && railSummary is { TotalSlots: > 0 })
            {
                <DocumentRailPill Open="@railOpen" OpenChanged="OnRailOpenChanged"
                                  Satisfied="@(railSummary?.SatisfiedSlots ?? 0)"
                                  Total="@(railSummary?.TotalSlots ?? 0)" />
            }
            @* R5 (§10.2) — buyer decision actions on a PendingApproval ASN. Any mapped PO buyer may decide (Phase 1);
               the server gate (AsnApprovalGate) is authoritative, so we only gate the affordance on Asn.Approve. *@
            @if (!IsNew && detail != null && CanApprove && detail.AsnStatus == "PendingApproval")
            {
                @* §6.2 — a buyer cannot approve OR reject while the ASN's PO is not shippable (e.g. reset to Released
                   by an ERP Modify); both actions are disabled with the reason until the PO is re-confirmed. *@
                <button class="mbtn mbtn--danger" @onclick="OpenRejectDialog" disabled="@(busy || detail.ShipBlocked)" title="@(detail.ShipBlocked ? detail.ShipBlockReason : null)">
                    <span class="material-symbols-outlined">cancel</span> Reject…
                </button>
                <button class="mbtn mbtn--primary-success" @onclick="OpenApproveDialog" disabled="@(busy || detail.ShipBlocked)" title="@(detail.ShipBlocked ? detail.ShipBlockReason : "Confirms the shipment details; the supplier posts it to the ERP afterwards")">
                    <span class="material-symbols-outlined">task_alt</span> Confirm
                </button>
            }
            @* Cancel — supplier-side, available on any of the supplier's active states (Draft / Rejected / PendingApproval).
               A Rejected ASN renders the editable wizard (IsLocked=false); a PendingApproval ASN renders the read-only
               view (IsLocked=true) but the supplier can still withdraw it via Cancel, so this is gated on status, not IsLocked. *@
            @if (!IsNew && detail != null && CanWrite && CanCancel)
            {
                <button class="mbtn mbtn--danger" @onclick="OpenCancelDialog" disabled="@busy">
                    <span class="material-symbols-outlined">block</span> Cancel ASN
                </button>
            }
            <button class="mbtn mbtn--outline" @onclick="BackToList">Close</button>
        </div>
    </header>

    @* ---------------- R5 (§10.2) approval-session banners (shown in BOTH the editable + read-only branches) ---------------- *@
    @if (!IsNew && detail != null && !loading)
    {
        @* Rejection banner — a Rejected ASN renders the editable wizard; the supplier needs the buyer's reason in view
           while they fix it. Saving an edit returns the ASN to Draft (server flips Rejected→Draft). *@
        @if (detail.AsnStatus == "Rejected")
        {
            <div class="rz-card" style="padding:14px 18px;margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;background:var(--mer-red-50);border:1px solid var(--mer-red);">
                <span class="material-symbols-outlined" style="font-size:22px;color:var(--mer-red);">gpp_bad</span>
                <div style="flex:1;">
                    <div style="font-size:13px;font-weight:700;color:var(--mer-red);">Returned by the buyer</div>
                    <div style="font-size:12.5px;color:var(--mer-ink-700);white-space:pre-wrap;margin-top:2px;">@(string.IsNullOrWhiteSpace(detail.Approval?.Reason) ? "No reason was recorded." : detail.Approval!.Reason)</div>
                    @if (detail.Approval is { } ra)
                    {
                        <div style="font-size:11px;color:var(--mer-ink-500);font-family:Inter,monospace;margin-top:6px;">
                            @(string.IsNullOrEmpty(ra.DecisionBy) ? "" : $"by {ra.DecisionBy} ")@(ra.DecisionOn?.ToString("· yyyy-MM-dd HH:mm"))
                        </div>
                    }
                    <div style="font-size:12px;color:var(--mer-ink-600);margin-top:8px;">Edit the lines / details below and send it for approval again. Saving any change returns the ASN to <b>Draft</b>.</div>
                </div>
            </div>
        }
        @* PendingApproval banner — visible to supplier (status, read-only) and buyer (deciding). Shows the submitted-by/on. *@
        else if (detail.AsnStatus == "PendingApproval" && detail.Approval is { } pa)
        {
            <div class="rz-card" style="padding:14px 18px;margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;background:var(--mer-amber-50);border:1px solid var(--mer-amber-800);">
                <span class="material-symbols-outlined" style="font-size:22px;color:var(--mer-amber-800);">hourglass_top</span>
                <div style="flex:1;">
                    <div style="font-size:13px;font-weight:700;color:var(--mer-amber-800);">Awaiting buyer approval</div>
                    <div style="font-size:12px;color:var(--mer-ink-700);font-family:Inter,monospace;margin-top:2px;">
                        Sent by @(string.IsNullOrEmpty(pa.SubmittedBy) ? "—" : pa.SubmittedBy) · @pa.SubmittedOn.ToString("yyyy-MM-dd HH:mm")
                    </div>
                    @if (CanApprove)
                    {
                        @if (detail.ShipBlocked)
                        {
                            @* §6.2 — the PO is no longer shippable (e.g. re-Released by an ERP Modify): the buyer can
                               neither approve (would ship) nor reject until the PO is re-confirmed. *@
                            <div style="font-size:12px;color:var(--mer-amber-800);font-weight:600;margin-top:8px;">
                                <span class="material-symbols-outlined" style="font-size:15px;vertical-align:middle;">block</span>
                                @detail.ShipBlockReason Approve and Reject are disabled until the PO is re-confirmed.
                            </div>
                        }
                        else
                        {
                            <div style="font-size:12px;color:var(--mer-ink-600);margin-top:8px;">Review the lines and shipment details below, then <b>Confirm</b> or <b>Reject</b> with a reason. Confirming does not ship anything — the supplier completes the documents and posts it afterwards.</div>
                        }
                    }
                    else
                    {
                        <div style="font-size:12px;color:var(--mer-ink-600);margin-top:8px;">The ASN is read-only until the buyer decides. You can cancel it if it was sent in error.</div>
                    }
                </div>
            </div>
        }
        @* R14 — Confirmed-but-not-yet-posted. This is the supplier's working state: the ASN is editable again and
           the document rail is live, and nothing has reached the ERP yet. *@
        else if (detail.AsnStatus == "Approved")
        {
            <div class="rz-card" style="padding:14px 18px;margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;background:var(--mer-green-50);border:1px solid var(--mer-green);">
                <span class="material-symbols-outlined" style="font-size:22px;color:var(--mer-green-dark);">verified</span>
                <div style="flex:1;">
                    <div style="font-size:13px;font-weight:700;color:var(--mer-green-dark);">Confirmed by the buyer</div>
                    @if (detail.Approval is { } cap)
                    {
                        <div style="font-size:12px;color:var(--mer-ink-700);font-family:Inter,monospace;margin-top:2px;">
                            Confirmed@(string.IsNullOrEmpty(cap.DecisionBy) ? "" : $" by {cap.DecisionBy}")@(cap.DecisionOn?.ToString(" · yyyy-MM-dd HH:mm"))
                        </div>
                    }
                    <div style="font-size:12px;color:var(--mer-ink-600);margin-top:8px;">
                        Upload the remaining shipment documents (Packing List, Commercial Invoice and any others required),
                        complete the shipment references, then click <b>Post</b>. Nothing has been sent to the ERP yet —
                        the shipping date will be the date you post.
                    </div>
                </div>
            </div>
        }
        @* Posted note — provenance for a shipment that has reached the ERP. The confirmation half only renders when
           there WAS a confirmation (a No-confirmation supplier's ASN has no approval session at all). *@
        else if (detail.AsnStatus is "Submitted" or "InTransit" or "Delivered")
        {
            <div class="rz-card" style="padding:10px 16px;margin-bottom:16px;display:flex;align-items:center;gap:10px;background:var(--mer-green-50);border:1px solid var(--mer-green);">
                <span class="material-symbols-outlined" style="font-size:18px;color:var(--mer-green-dark);">verified</span>
                <div style="font-size:12px;color:var(--mer-ink-700);font-family:Inter,monospace;">
                    @if (detail.Approval is { Status: "Approved" } ap)
                    {
                        <text>Confirmed@(string.IsNullOrEmpty(ap.DecisionBy) ? "" : $" by {ap.DecisionBy}")@(ap.DecisionOn?.ToString(" · yyyy-MM-dd HH:mm")) · sent by @(string.IsNullOrEmpty(ap.SubmittedBy) ? "—" : ap.SubmittedBy) · </text>
                    }
                    <text>Posted@(string.IsNullOrEmpty(detail.PostedBy) ? "" : $" by {detail.PostedBy}")@(detail.PostedAt?.ToString(" · yyyy-MM-dd HH:mm"))</text>
                </div>
            </div>
        }
    }

    @if (loading)
    {
        <div class="tl-empty">Loading…</div>
    }
    else if (!IsNew && detail == null)
    {
        <div class="tl-empty">ASN not found.</div>
    }
    else if (IsLocked && detail != null)
    {
        @* ---------------- Read-only (Submitted/Cancelled) view ---------------- *@
        @* R6 — grouped draft-invoice generation surface. "Blocked" (a PO-line tax has no resolvable rate) shows
           the note + a Retry (POST api/invoices/from-asn — the same idempotent generator); "Generated" lists ALL
           the drafts (one per PO currency/payment-term group). Legacy rows predating InvoiceGenerationStatus fall
           back to the scalar DraftInvoiceId. *@
        var draftInvoiceIds = detail.DraftInvoiceIds is { Count: > 0 } genIds
            ? genIds.ToList()
            : (detail.DraftInvoiceId.HasValue ? new List<Guid> { detail.DraftInvoiceId.Value } : new List<Guid>());

        @* ---- R7 (§2) — document-rail push row: main column (banners + cards) beside the 360px rail. The
              min-width:0 on the main flex child lets it shrink so the rail pushes, never overlays/overflows.
              The read-only host defaults the rail CLOSED (§2.3 — the Mandatory check already passed at
              Send-for-Approval); the header pill still shows the live count. ---- *@
        <div style="display:flex;align-items:stretch;">
        <div style="flex:1;min-width:0;">

        @if (detail.InvoiceGenerationStatus == "Blocked")
        {
            <div class="rz-card" style="padding:14px 18px;margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;background:var(--mer-red-50);border:1px solid var(--mer-red);">
                <span class="material-symbols-outlined" style="font-size:22px;color:var(--mer-red);">report</span>
                <div style="flex:1;">
                    <div style="font-size:13px;font-weight:700;color:var(--mer-red);">Invoice generation blocked</div>
                    <div style="font-size:12.5px;color:var(--mer-ink-700);white-space:pre-wrap;margin-top:2px;">@(string.IsNullOrWhiteSpace(detail.InvoiceGenerationNote) ? "Draft invoice generation could not run for this ASN." : detail.InvoiceGenerationNote)</div>
                    @if (!string.IsNullOrEmpty(invoiceRetryError))
                    {
                        <div style="font-size:12px;color:var(--mer-red);font-weight:600;margin-top:6px;">@invoiceRetryError</div>
                    }
                    <div style="font-size:12px;color:var(--mer-ink-600);margin-top:6px;">Once the named tax code has a rate in the tax master, retry the generation.</div>
                </div>
                @if (Token.IsSupplier || Token.HasPermission("Invoice.Submit"))
                {
                    <button class="rz-button" style="padding:8px 14px;border-radius:6px;border:1px solid var(--mer-red);background:var(--mer-surface);color:var(--mer-red);cursor:pointer;flex:none;" @onclick="RetryInvoiceGeneration" disabled="@invoiceRetryBusy">
                        <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;">refresh</span> @(invoiceRetryBusy ? "Retrying…" : "Retry generation")
                    </button>
                }
            </div>
        }
        else if (draftInvoiceIds.Count > 0)
        {
            <div class="rz-card" style="padding:14px 18px;margin-bottom:16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:var(--mer-green-50);border:1px solid var(--mer-green);">
                <span class="material-symbols-outlined" style="font-size:22px;color:var(--mer-green-dark);">receipt_long</span>
                <div style="flex:1;min-width:240px;">
                    <div style="font-size:13px;font-weight:700;color:var(--mer-blue-darker);">@(draftInvoiceIds.Count == 1 ? "Draft invoice created" : $"{draftInvoiceIds.Count} draft invoices created")</div>
                    <div style="font-size:12px;color:var(--mer-ink-600);">@(draftInvoiceIds.Count == 1 ? "A draft invoice spanning this ASN's PO(s) was generated on approval." : "One draft invoice per PO currency / payment-term group was generated on approval.")</div>
                </div>
                @for (var i = 0; i < draftInvoiceIds.Count; i++)
                {
                    var draftId = draftInvoiceIds[i];
                    var draftLabel = draftInvoiceIds.Count == 1 ? "Open draft invoice" : $"Draft invoice #{i + 1}";
                    <a href="invoices/@draftId" class="rz-button rz-primary" style="padding:8px 14px;border-radius:6px;border:0;color:#fff;text-decoration:none;flex:none;">@draftLabel</a>
                }
            </div>
        }

        @* R7 (§2/§3.2) — the old 1.4fr/1fr grid (Shipment beside the always-expanded panel) is gone: the document
           surface moved into the right rail, and the Shipment card spans the full main column. *@
        <div class="rz-card" style="padding:20px;">
                <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--mer-blue-darker);">Shipment</h3>
                <dl style="display:grid;grid-template-columns:160px 1fr;gap:6px 16px;font-size:13px;">
                    <dt style="color:var(--mer-ink-500);">Purchase order(s)</dt><dd>@PoSummaryText</dd>
                    <dt style="color:var(--mer-ink-500);">Expected delivery</dt><dd style="font-family:Inter,monospace;">@detail.ExpectedDeliveryDate.ToString("yyyy-MM-dd")</dd>
                    @if (!string.IsNullOrEmpty(detail.TimeWindow)) { <dt style="color:var(--mer-ink-500);">Time window</dt><dd>@detail.TimeWindow</dd> }
                    @if (!string.IsNullOrEmpty(detail.CarrierName)) { <dt style="color:var(--mer-ink-500);">Carrier</dt><dd>@detail.CarrierName</dd> }
                    @if (!string.IsNullOrEmpty(detail.TrackingNumber)) { <dt style="color:var(--mer-ink-500);">Tracking</dt><dd style="font-family:Inter,monospace;">@detail.TrackingNumber</dd> }
                    @if (!string.IsNullOrEmpty(detail.VehicleNumber)) { <dt style="color:var(--mer-ink-500);">Vehicle</dt><dd style="font-family:Inter,monospace;">@detail.VehicleNumber</dd> }
                    @if (!string.IsNullOrEmpty(detail.DriverName)) { <dt style="color:var(--mer-ink-500);">Driver</dt><dd>@detail.DriverName @(string.IsNullOrEmpty(detail.DriverPhone) ? "" : $"· {detail.DriverPhone}")</dd> }
                    @* R11 (D12) — warehouse + the three shipment refs, read-only. Warehouse is the D4 grouping key
                       (derived from the covered PO); the refs are what the supplier entered before sending. *@
                    @if (!string.IsNullOrEmpty(detail.Warehouse)) { <dt style="color:var(--mer-ink-500);">Warehouse</dt><dd style="font-family:Inter,monospace;">@detail.Warehouse</dd> }
                    @if (!string.IsNullOrEmpty(detail.InvoiceNo)) { <dt style="color:var(--mer-ink-500);">Invoice no.</dt><dd style="font-family:Inter,monospace;">@detail.InvoiceNo</dd> }
                    @if (!string.IsNullOrEmpty(detail.BillOfLading)) { <dt style="color:var(--mer-ink-500);">Bill of lading</dt><dd style="font-family:Inter,monospace;">@detail.BillOfLading</dd> }
                    @if (!string.IsNullOrEmpty(detail.PackingList)) { <dt style="color:var(--mer-ink-500);">Packing list</dt><dd style="font-family:Inter,monospace;">@detail.PackingList</dd> }
                    @if (detail.CreatedOn.HasValue) { <dt style="color:var(--mer-ink-500);">Created</dt><dd style="font-family:Inter,monospace;">@detail.CreatedOn.Value.ToString("yyyy-MM-dd HH:mm")</dd> }
                    @* R14 — the shipping date IS the POST date (postedAt), not the confirmation date. It equals the
                       submittedAt the LN payload carries as ShipmentDate, because both are stamped at post. *@
                    <dt style="color:var(--mer-ink-500);">Shipping date</dt><dd style="font-family:Inter,monospace;">@(detail.PostedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                    @if (detail.PostedAt.HasValue) { <dt style="color:var(--mer-ink-500);">Posted</dt><dd style="font-family:Inter,monospace;">@detail.PostedAt.Value.ToString("yyyy-MM-dd HH:mm") @(string.IsNullOrEmpty(detail.PostedBy) ? "" : $"by {detail.PostedBy}")</dd> }
                    @if (!string.IsNullOrEmpty(detail.ErpSyncId)) { <dt style="color:var(--mer-ink-500);">ERP sync id</dt><dd style="font-family:Inter,monospace;font-size:11px;">@detail.ErpSyncId</dd> }
                    @if (!string.IsNullOrEmpty(detail.ErpCode)) { <dt style="color:var(--mer-ink-500);">ERP code</dt><dd style="font-family:Inter,monospace;">@detail.ErpCode</dd> }
                    @* R16 — the LN verdict. PartialFailure is the one state where "no ERP code" ≠ "not in LN":
                       LN holds an ASN header for this record but refused ≥1 line, so it renders as a warning. *@
                    @if (!string.IsNullOrEmpty(detail.ErpStatus))
                    {
                        <dt style="color:var(--mer-ink-500);">ERP status</dt>
                        <dd>
                            <span style="font-family:Inter,monospace;font-size:11px;border-radius:4px;padding:2px 6px;border:1px solid @(detail.ErpStatus == "Success" ? "var(--mer-green)" : "var(--mer-amber-800)");background:@(detail.ErpStatus == "Success" ? "var(--mer-green-soft)" : "var(--mer-amber-50)");color:@(detail.ErpStatus == "Success" ? "inherit" : "var(--mer-amber-800)");">@detail.ErpStatus</span>
                        </dd>
                    }
                </dl>
                @if (!string.IsNullOrEmpty(detail.Notes))
                {
                    <h4 style="font-size:12px;font-weight:700;margin:16px 0 6px;color:var(--mer-ink-700);">Notes</h4>
                    <p style="font-size:13px;color:var(--mer-ink-700);white-space:pre-wrap;">@detail.Notes</p>
                }
        </div>

        <div class="rz-card" style="padding:20px;margin-top:16px;">
            <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--mer-blue-darker);">Lines (@detail.Lines.Count)</h3>
            <table style="width:100%;font-size:12.5px;border-collapse:collapse;">
                <thead>
                    <tr style="border-bottom:1px solid var(--mer-line);">
                        <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">PO</th>
                        <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Pos</th>
                        <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Seq</th>
                        <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Item</th>
                        <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Order Qty</th>
                        <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Ship Qty</th>
                        <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Balance / allowance</th>
                        <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Batch</th>
                        <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Expiry</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var ln in detail.Lines)
                {
                    var line = ln;
                    var hasSerials = line.Serials is { Count: > 0 };
                    var hasLots = line.Lots is { Count: > 0 };
                    <tr style="border-bottom:1px solid var(--mer-line-soft);">
                        <td style="padding:6px 4px;font-family:Inter,monospace;">@line.PoNumber</td>
                        <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@(line.PositionNo ?? line.PoPositionNo)</td>
                        <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@(line.SequenceNo?.ToString() ?? "—")</td>
                        <td style="padding:6px 4px;font-family:Inter,monospace;">@line.ItemCode</td>
                        <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@line.OrderQty.ToString("0.###")</td>
                        <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@line.ShippedQty.ToString("0.###")</td>
                        <td style="padding:6px 4px;">@DetailBalanceCell(line)</td>
                        <td style="padding:6px 4px;">@(string.IsNullOrEmpty(line.BatchNumber) ? "—" : line.BatchNumber)</td>
                        <td style="padding:6px 4px;font-family:Inter,monospace;">@(line.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    </tr>
                    @if (hasSerials)
                    {
                        <tr style="border-bottom:1px solid var(--mer-line-soft);">
                            <td colspan="9" style="padding:4px 4px 10px 16px;">
                                <div style="font-size:11px;font-weight:700;color:var(--mer-ink-600);margin-bottom:4px;">Serials (@line.Serials!.Count)</div>
                                <div style="display:flex;flex-wrap:wrap;gap:4px;">
                                    @foreach (var s in line.Serials!)
                                    {
                                        <span style="font-family:Inter,monospace;font-size:11px;background:var(--mer-ink-50);border:1px solid var(--mer-line);border-radius:4px;padding:2px 6px;">@s.SerialNumber@(s.ExpiryDate is { } ex ? $" · exp {ex:yyyy-MM-dd}" : "")</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (hasLots)
                    {
                        <tr style="border-bottom:1px solid var(--mer-line-soft);">
                            <td colspan="9" style="padding:4px 4px 10px 16px;">
                                <div style="font-size:11px;font-weight:700;color:var(--mer-ink-600);margin-bottom:4px;">Lots (@line.Lots!.Count)</div>
                                <div style="display:flex;flex-wrap:wrap;gap:6px;">
                                    @foreach (var lot in line.Lots!)
                                    {
                                        <span style="font-family:Inter,monospace;font-size:11px;background:var(--mer-green-soft);border:1px solid var(--mer-green);border-radius:4px;padding:2px 6px;">@lot.LotNo · @lot.Qty.ToString("0.###")@(lot.ExpiryDate.HasValue ? $" · exp {lot.ExpiryDate:yyyy-MM-dd}" : "")@(string.IsNullOrEmpty(lot.ErpCode) ? "" : $" · {lot.ErpCode}")</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        </div>
        @* R7 (§13.5 semantics unchanged) — the read-only document surface for the locked view (PendingApproval:
           supplier read-only + deciding buyer; Submitted+: view-only for everyone) now lives in the rail. The
           panel inside still renders nothing when no policy rows exist; Editable=false ⇒ no upload/remove. *@
        <DocumentRail EntityCode="Asn"
                      EntityId="@detail.Id"
                      Editable="false"
                      SupplierId="@detail.SupplierId"
                      Open="@railOpen"
                      OpenChanged="OnRailOpenChanged"
                      OnSummaryChanged="OnRailSummary" />
        </div>
    }
    else
    {
        @* ---------------- Draft wizard (editable) ---------------- *@
        @* R7 (§2) — the wizard adopts the document rail too: PERSISTENT across all four steps (the old step-3
           embedded panel is removed). Same push-row plumbing as the locked view; the editable host defaults the
           rail OPEN when any Mandatory slot is empty (§2.3, learned from the panel's first summary). *@
        <div style="display:flex;align-items:stretch;">
        <div style="flex:1;min-width:0;">
        <div class="rz-card" style="padding:20px;">
            <!-- Stepper -->
            <div style="display:flex;gap:0;margin-bottom:24px;border-bottom:1px solid var(--mer-line);">
                @for (int i = 1; i <= 4; i++)
                {
                    var step = i;
                    var active = currentStep == step;
                    var done = currentStep > step;
                    <div style="padding:10px 16px;font-size:13px;font-weight:600;border-bottom:3px solid @(active ? "var(--mer-blue)" : done ? "var(--mer-green)" : "transparent");color:@(active ? "var(--mer-blue)" : done ? "var(--mer-green)" : "var(--mer-ink-500)");cursor:pointer;" @onclick="@(() => GoStep(step))">
                        @step. @StepLabel(step)
                    </div>
                }
            </div>

            @if (currentStep == 1)
            {
                @* R15 (Design 1a) — the PO-picker step is gone: step 1 is a flat grid of the supplier's APPROVED
                   delivery-schedule lines (hard filter — no toggle). Picking the first line locks the warehouse
                   (one warehouse per ASN, §9.1); rows for other warehouses stay disabled until Clear. *@
                <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--mer-blue-darker);">Select lines to ship</h3>
                <p style="font-size:12px;color:var(--mer-ink-500);margin-bottom:12px;">@Step1HelperText</p>

                @* Supplier-first chooser — shown when the signed-in user can act for more than one supplier. *@
                @if (suppliers.Count > 1)
                {
                    <div style="margin-bottom:14px;">
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);display:block;margin-bottom:4px;">Supplier *</label>
                        <select class="rz-dropdown" style="width:100%;max-width:420px;padding:8px 10px;border:1px solid var(--mer-ink-300);border-radius:6px;background:var(--mer-surface);" value="@selectedSupplierId" @onchange="OnSupplierSelect">
                            <option value="">— Select supplier —</option>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id" selected="@(selectedSupplierId == s.Id)">@s.LegalName (@s.SupplierCode)</option>
                            }
                        </select>
                    </div>
                }
                else if (suppliers.Count == 1)
                {
                    <div style="font-size:12.5px;color:var(--mer-ink-700);margin-bottom:12px;">Supplier: <b>@selectedSupplierName</b></div>
                }
                else
                {
                    <div class="tl-empty" style="padding:24px;text-align:left;"><div style="font-size:13px;color:var(--mer-ink-600);">No suppliers available to you.</div></div>
                }

                @if (selectedSupplierId.HasValue)
                {
                    @if (schedulesLoading)
                    {
                        <p style="color:var(--mer-ink-500);font-size:13px;">Loading approved delivery schedules…</p>
                    }
                    else if (scheduleRows.Count == 0)
                    {
                        <div class="tl-empty" style="padding:24px;text-align:left;">
                            <div style="font-size:13px;color:var(--mer-ink-600);">No approved delivery schedules ready to ship for this supplier.</div>
                        </div>
                    }
                    else
                    {
                        @* Filter row — warehouse (hidden when ≤1 distinct), PO/item search, delivery-date range,
                           and the static hard-gate chip (Design 1a; D2 locked it to Approved with no toggle). *@
                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px;">
                            @if (GridWarehouseOptions.Count > 1)
                            {
                                <select class="rz-dropdown" style="padding:7px 10px;border:1px solid var(--mer-ink-300);border-radius:6px;background:var(--mer-surface);min-width:180px;" @bind="gridWarehouseFilter">
                                    <option value="">All warehouses</option>
                                    @foreach (var wh in GridWarehouseOptions)
                                    {
                                        <option value="@wh.Id">@wh.Name</option>
                                    }
                                </select>
                            }
                            <input class="rz-textbox" placeholder="PO or item…" style="padding:7px 10px;width:190px;" @bind="lineSearch" @bind:event="oninput" />
                            <label style="font-size:12px;color:var(--mer-ink-600);display:inline-flex;align-items:center;gap:6px;">
                                From
                                <input type="date" class="rz-textbox" style="padding:6px 8px;" @bind="gridDateFrom" />
                            </label>
                            <label style="font-size:12px;color:var(--mer-ink-600);display:inline-flex;align-items:center;gap:6px;">
                                To
                                <input type="date" class="rz-textbox" style="padding:6px 8px;" @bind="gridDateTo" />
                            </label>
                            <span style="display:inline-flex;align-items:center;gap:5px;padding:6px 10px;border-radius:6px;border:1px solid var(--mer-green);background:var(--mer-green-50, #f3f9ec);color:var(--mer-green-darker, #3b6d11);font-size:12px;font-weight:600;"
                                  title="Only lines whose delivery schedule is Approved can be shipped">
                                <span class="material-symbols-outlined" style="font-size:15px;">event</span> Schedule: Approved
                            </span>
                        </div>

                        @* §9.1 warehouse-lock banner — appears on the first pick (Design 1a lock strip). *@
                        @if (selectedSchedules.Count > 0)
                        {
                            <div style="padding:9px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px;background:var(--mer-blue-50);border:1px solid var(--mer-blue);border-radius:6px;">
                                <span class="material-symbols-outlined" style="font-size:18px;color:var(--mer-blue);">lock</span>
                                <div style="flex:1;font-size:12.5px;color:var(--mer-blue-darker);">
                                    Warehouse locked to <b>@(lockedWarehouseLabel ?? "—")</b>
                                    <span style="color:var(--mer-ink-500);"> — lines in other warehouses stay unselectable until you clear.</span>
                                </div>
                                <button type="button" @onclick="SelectAllInLockedWarehouse"
                                        style="display:inline-flex;align-items:center;gap:5px;background:var(--mer-surface);border:1px solid var(--mer-blue);border-radius:6px;padding:5px 10px;color:var(--mer-blue);cursor:pointer;font-size:12px;font-weight:600;">
                                    Select all @LockedWarehousePool.Count() in this warehouse
                                </button>
                                <button type="button" @onclick="ClearScheduleSelection"
                                        style="display:inline-flex;align-items:center;gap:5px;background:transparent;border:1px solid var(--mer-blue);border-radius:6px;padding:5px 10px;color:var(--mer-blue);cursor:pointer;font-size:12px;">
                                    <span class="material-symbols-outlined" style="font-size:14px;">close</span> Clear
                                </button>
                            </div>
                        }

                        <div style="border:1px solid var(--mer-line);border-radius:8px;overflow:hidden;">
                            <div style="max-height:420px;overflow:auto;">
                                <table style="width:100%;font-size:12.5px;border-collapse:collapse;min-width:1080px;">
                                    <thead>
                                        <tr style="border-bottom:1px solid var(--mer-line);background:var(--mer-ink-50);position:sticky;top:0;z-index:1;">
                                            <th style="width:36px;padding:8px 4px;text-align:center;">
                                                <input type="checkbox" checked="@AllLockedSelected" disabled="@(selectedSchedules.Count == 0)"
                                                       title="@(selectedSchedules.Count == 0 ? "Pick one line first — that fixes the warehouse" : AllLockedSelected ? "Clear all lines in this warehouse" : "Select all lines in this warehouse")"
                                                       @onchange="ToggleAllInLockedWarehouse" />
                                            </th>
                                            <th style="text-align:left;padding:8px 4px;color:var(--mer-ink-700);">PO #</th>
                                            <th style="text-align:right;padding:8px 4px;color:var(--mer-ink-700);">Ln</th>
                                            <th style="text-align:left;padding:8px 10px;color:var(--mer-ink-700);">Item</th>
                                            <th style="text-align:right;padding:8px 4px;color:var(--mer-ink-700);">Order qty</th>
                                            <th style="text-align:right;padding:8px 4px;color:var(--mer-ink-700);">Shipped</th>
                                            <th style="text-align:right;padding:8px 4px;color:var(--mer-ink-700);">Remaining</th>
                                            <th style="text-align:left;padding:8px 10px;color:var(--mer-ink-700);">Warehouse</th>
                                            <th style="text-align:left;padding:8px 4px;color:var(--mer-ink-700);">Delivery</th>
                                            <th style="text-align:left;padding:8px 4px;color:var(--mer-ink-700);">Schedule</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @{
                                        // Design 1a PO banding: alternate tint per PO block; the PO number renders
                                        // emphasized on the first row of each block and muted on the rest.
                                        var _prevPo = (string?)null;
                                        var _poIdx = -1;
                                    }
                                    @foreach (var row in VisibleScheduleRows)
                                    {
                                        var r = row;
                                        var first = r.PoNumber != _prevPo;
                                        if (first) { _poIdx++; _prevPo = r.PoNumber; }
                                        var band = _poIdx % 2 == 1;
                                        var isSelected = selectedSchedules.ContainsKey(r.Id);
                                        var warehouseBlocked = selectedSchedules.Count > 0 && r.WarehouseAddressId != lockedWarehouseId;
                                        var noBalance = r.RemainingToShip <= 0;
                                        var selectable = !noBalance && !warehouseBlocked && r.IsShippable;
                                        var rowBg = isSelected ? "var(--mer-blue-50)" : band ? "var(--mer-ink-50)" : "var(--mer-surface)";
                                        <tr style="border-bottom:1px solid var(--mer-line-soft);@(first && _poIdx > 0 ? "border-top:1px solid var(--mer-line);" : "")background:@rowBg;@(!selectable && !isSelected ? "opacity:.55;" : "")">
                                            <td style="padding:6px 4px;text-align:center;">
                                                @if (r.IsShippable)
                                                {
                                                    <input type="checkbox" checked="@isSelected" disabled="@(!selectable && !isSelected)"
                                                           title="@(noBalance ? "Nothing left to ship on this line" : warehouseBlocked ? "Different warehouse — clear the selection to pick this one" : null)"
                                                           @onchange="() => ToggleScheduleRow(r)" />
                                                }
                                                else
                                                {
                                                    <span class="material-symbols-outlined" style="font-size:15px;color:var(--mer-ink-400);"
                                                          title="PO not confirmed — re-accept the PO before shipping this schedule">block</span>
                                                }
                                            </td>
                                            <td style="padding:6px 4px;font-family:Inter,monospace;font-weight:@(first ? "700" : "400");color:@(first ? "var(--mer-blue)" : "var(--mer-ink-300)");">@r.PoNumber</td>
                                            <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;color:var(--mer-ink-500);">@r.PositionNo</td>
                                            <td style="padding:6px 10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:280px;">
                                                <span style="font-weight:600;font-family:Inter,monospace;color:var(--mer-blue-darker);">@r.ItemCode</span>
                                                @if (!string.IsNullOrWhiteSpace(r.ItemDescription))
                                                {
                                                    <span style="color:var(--mer-ink-500);"> — @r.ItemDescription</span>
                                                }
                                            </td>
                                            <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@r.OrderQty.ToString("N2") <span style="color:var(--mer-ink-500);">@r.OrderUnit</span></td>
                                            <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;color:var(--mer-ink-500);">@r.ShippedQtyToDate.ToString("N2")</td>
                                            <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;font-weight:600;color:@(r.RemainingToShip > 0 ? "var(--mer-blue-darker)" : "var(--mer-ink-400)");">@r.RemainingToShip.ToString("N2")</td>
                                            <td style="padding:6px 10px;font-family:Inter,monospace;" title="@r.WarehouseAddressName">@(string.IsNullOrWhiteSpace(r.Warehouse) ? "—" : r.Warehouse)</td>
                                            <td style="padding:6px 4px;font-family:Inter,monospace;">@r.DeliveryDate.ToString("yyyy-MM-dd")</td>
                                            <td style="padding:6px 4px;"><span class="tlg-status tlg-status--active">@r.Status</span></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        @* Footer summary (Design 1a) — selection count · PO spread · locked warehouse. *@
                        <div style="display:flex;align-items:center;gap:10px;margin-top:10px;">
                            <span style="font-size:13px;font-weight:700;color:var(--mer-blue-darker);">
                                @(selectedSchedules.Count > 0 ? $"{selectedSchedules.Count} line(s) selected" : "No lines selected")
                            </span>
                            <span style="font-size:12px;color:var(--mer-ink-500);">
                                @(selectedSchedules.Count > 0
                                    ? $"across {selectedSchedules.Values.Select(s => s.PurchaseOrderId).Distinct().Count()} PO(s) · {lockedWarehouseLabel}"
                                    : "Select lines sharing one warehouse to continue")
                            </span>
                        </div>
                    }
                }
            }
            else if (currentStep == 2)
            {
                @* R15 — quantities for the SELECTED lines only (the step-1 grid owns add/remove; this step never
                   sweeps in other lines of the covered POs). *@
                <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--mer-blue-darker);">Quantities (@lines.Count line@(lines.Count == 1 ? "" : "s"))</h3>
                @if (linesLoading)
                {
                    <p style="color:var(--mer-ink-500);font-size:13px;">Loading lines…</p>
                }
                else if (lines.Count == 0)
                {
                    <p style="color:var(--mer-ink-500);font-size:13px;">Select at least one delivery-schedule line on step 1.</p>
                }
                else
                {
                    <table style="width:100%;font-size:12.5px;border-collapse:collapse;">
                        <thead>
                            <tr style="border-bottom:1px solid var(--mer-line);">
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">PO</th>
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Pos</th>
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Seq</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Item</th>
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Order Qty</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Delivery</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Balance / allowance</th>
                                <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Ship Qty</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Batch</th>
                                <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Expiry</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var ln in lines)
                        {
                            var full = FullyShipped(ln);     // ceiling reached (no over-ship headroom) → row read-only
                            var over = OverAllowance(ln);    // entered qty exceeds the order qty + tolerance ceiling → red border (no inline text; dialog carries the message)
                            <tr style="border-bottom:1px solid var(--mer-line-soft);@(full ? "background:var(--mer-ink-50);" : "")">
                                <td style="padding:6px 4px;font-family:Inter,monospace;">@ln.PoNumber</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;color:var(--mer-ink-500);">@ln.PositionNo</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;color:var(--mer-ink-500);">@(ln.SequenceNo?.ToString() ?? "—")</td>
                                <td style="padding:6px 4px;font-family:Inter,monospace;">@ln.ItemCode</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@ln.OrderQty.ToString("0.###")</td>
                                <td style="padding:6px 4px;font-family:Inter,monospace;" title="Schedule delivery date">@(ln.DeliveryDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td style="padding:6px 4px;">@BalanceCell(ln) @if (full) { <span class="tlg-status tlg-status--active" style="margin-left:6px;font-size:10px;">Fully shipped</span> }</td>
                                <td style="padding:6px 4px;text-align:right;">
                                    <input type="number" step="0.001" min="0" max="@ln.OverShipAllowance.ToString("0.###")" class="rz-textbox"
                                           style="width:90px;padding:4px 6px;font-family:Inter,monospace;text-align:right;@(over ? "border:1px solid var(--mer-red);" : "")"
                                           @bind="ln.ShippedQty" @bind:event="oninput" @onblur="() => OnShipQtyBlur(ln)" disabled="@full" title="@(full ? "Line fully shipped — no remaining ship capacity" : null)" />
                                </td>
                                <td style="padding:6px 4px;"><input type="text" class="rz-textbox" style="width:120px;padding:4px 6px;" @bind="ln.BatchNumber" disabled="@full" /></td>
                                <td style="padding:6px 4px;"><input type="date" class="rz-textbox" style="width:130px;padding:4px 6px;" @bind="ln.ExpiryDate" disabled="@full" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <p style="font-size:11px;color:var(--mer-ink-500);margin-top:8px;">Position &amp; sequence are snapshot from the PO line and cannot be edited.</p>

                    @* ---------------- Serial capture (serialized items) ---------------- *@
                    @if (SerialLines.Count > 0)
                    {
                        <div style="margin-top:22px;border-top:1px solid var(--mer-line);padding-top:16px;">
                            <h3 style="font-size:14px;font-weight:700;margin-bottom:4px;color:var(--mer-blue-darker);">Serial numbers</h3>
                            <p style="font-size:12px;color:var(--mer-ink-500);margin-bottom:14px;">Each serialized item needs exactly one serial per shipped unit. Serials must be unique across the whole ASN.</p>
                            @foreach (var sl in SerialLines)
                            {
                                var line = sl;
                                var need = (int)line.ShippedQty;
                                var filled = line.Serials.Count(s => !string.IsNullOrWhiteSpace(s.Serial));
                                var ok = SerialLineValid(line, out var serMsg);
                                <div style="border:1px solid var(--mer-line);border-radius:8px;padding:14px;margin-bottom:12px;background:var(--mer-surface);">
                                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
                                        <span style="font-size:13px;font-weight:700;color:var(--mer-blue-darker);font-family:Inter,monospace;">@line.ItemCode <span style="font-weight:400;color:var(--mer-ink-500);">· PO @line.PoNumber · pos @line.PositionNo</span></span>
                                        <span class="tlg-status @(ok ? "tlg-status--active" : "tlg-status--danger")" style="font-family:Inter,monospace;">@filled / @need captured</span>
                                    </div>

                                    @* R4 (2026-06-30) — bulk "expiry for all units": one click fills every serial's expiry (the common shared-expiry case). Per-row expiry below overrides for mixed batches. *@
                                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px;padding:8px 10px;background:var(--mer-ink-50);border:1px solid var(--mer-line);border-radius:6px;">
                                        <span class="material-symbols-outlined" style="font-size:16px;color:var(--mer-ink-500);">event</span>
                                        <span style="font-size:12px;color:var(--mer-ink-600);">Expiry for all units</span>
                                        <input type="date" class="rz-textbox" style="width:150px;padding:4px 6px;" @bind="line._bulkExpiry" />
                                        <button class="rz-button" style="padding:5px 10px;border-radius:6px;border:1px solid var(--mer-ink-300);background:var(--mer-surface);cursor:pointer;font-size:12px;" @onclick="() => ApplyBulkExpiry(line)">Apply to all</button>
                                        <button class="rz-button" style="padding:5px 10px;border-radius:6px;border:1px solid var(--mer-ink-300);background:var(--mer-surface);cursor:pointer;font-size:12px;" @onclick="() => ClearExpiries(line)">Clear</button>
                                    </div>

                                    @* Paste affordance — split on newline/comma, fill the N boxes, ignore extras (warn). *@
                                    <details style="margin-bottom:10px;">
                                        <summary style="font-size:12px;color:var(--mer-blue);cursor:pointer;">Paste serials</summary>
                                        <div style="margin-top:8px;">
                                            <textarea class="rz-textbox" rows="3" placeholder="Paste serials separated by new lines or commas" style="width:100%;padding:8px 10px;font-family:Inter,monospace;font-size:12px;" @bind="line._pasteBuffer"></textarea>
                                            <button class="rz-button" style="margin-top:6px;padding:6px 12px;border-radius:6px;border:1px solid var(--mer-ink-300);background:var(--mer-surface);cursor:pointer;font-size:12px;" @onclick="() => ApplyPaste(line)">
                                                <span class="material-symbols-outlined" style="font-size:14px;vertical-align:middle;">content_paste</span> Fill @need boxes
                                            </button>
                                            @if (!string.IsNullOrEmpty(line._pasteWarn))
                                            {
                                                <span style="font-size:11px;color:var(--mer-amber-800);margin-left:8px;">@line._pasteWarn</span>
                                            }
                                        </div>
                                    </details>

                                    @if (need > SerialBoxCap)
                                    {
                                        <div style="background:var(--mer-amber-50);color:var(--mer-amber-800);padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:10px;">
                                            Large quantity (@need units). Use <b>Paste serials</b> above. Only the first @SerialBoxCap boxes are rendered for editing; pasted serials beyond that are still captured.
                                        </div>
                                    }
                                    <div style="display:grid;grid-template-columns:26px 1fr 150px;gap:6px 8px;align-items:center;@(need > SerialBoxCap ? "max-height:320px;overflow:auto;" : "")">
                                        @{ var renderCount = Math.Min(need, SerialBoxCap); EnsureSerialSlots(line, need); }
                                        <span></span>
                                        <span style="font-size:10px;color:var(--mer-ink-400);text-transform:uppercase;letter-spacing:.4px;">Serial</span>
                                        <span style="font-size:10px;color:var(--mer-ink-400);text-transform:uppercase;letter-spacing:.4px;">Expiry · optional</span>
                                        @for (int si = 0; si < renderCount; si++)
                                        {
                                            var sIdx = si;
                                            <span style="font-size:10.5px;color:var(--mer-ink-400);font-family:Inter,monospace;text-align:right;">@(sIdx + 1)</span>
                                            <input class="rz-textbox" style="padding:5px 8px;font-family:Inter,monospace;font-size:12px;@(DuplicateSerial(line, sIdx) ? "border:1px solid var(--mer-red);" : "")" placeholder="Serial" @bind="line.Serials[sIdx].Serial" @bind:event="oninput" />
                                            <input type="date" class="rz-textbox" style="padding:5px 6px;font-size:12px;" @bind="line.Serials[sIdx].Expiry" />
                                        }
                                    </div>
                                    @if (!ok)
                                    {
                                        <div style="font-size:11.5px;color:var(--mer-red);margin-top:8px;">@serMsg</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* ---------------- Lot capture (lot-controlled items) ---------------- *@
                    @if (LotLines.Count > 0)
                    {
                        <div style="margin-top:22px;border-top:1px solid var(--mer-line);padding-top:16px;">
                            <h3 style="font-size:14px;font-weight:700;margin-bottom:4px;color:var(--mer-blue-darker);">Lots / batches</h3>
                            <p style="font-size:12px;color:var(--mer-ink-500);margin-bottom:14px;">Split each lot-controlled item into lots whose quantities sum to the shipped quantity. Lot numbers must be unique within the line.</p>
                            @foreach (var ll in LotLines)
                            {
                                var line = ll;
                                var sum = line.Lots.Sum(x => x.Qty ?? 0);
                                var ok = LotLineValid(line, out var lotMsg);
                                <div style="border:1px solid var(--mer-line);border-radius:8px;padding:14px;margin-bottom:12px;background:var(--mer-surface);">
                                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
                                        <span style="font-size:13px;font-weight:700;color:var(--mer-blue-darker);font-family:Inter,monospace;">@line.ItemCode <span style="font-weight:400;color:var(--mer-ink-500);">· PO @line.PoNumber · pos @line.PositionNo</span></span>
                                        <span class="tlg-status @(ok ? "tlg-status--active" : "tlg-status--danger")" style="font-family:Inter,monospace;">Σ @sum.ToString("0.###") / @line.ShippedQty.ToString("0.###")</span>
                                    </div>
                                    <table style="width:100%;font-size:12.5px;border-collapse:collapse;">
                                        <thead>
                                            <tr style="border-bottom:1px solid var(--mer-line);">
                                                <th style="text-align:left;padding:4px;color:var(--mer-ink-700);">Lot no.</th>
                                                <th style="text-align:right;padding:4px;color:var(--mer-ink-700);width:120px;">Qty</th>
                                                <th style="text-align:left;padding:4px;color:var(--mer-ink-700);width:150px;">Expiry</th>
                                                <th style="width:36px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var lot in line.Lots)
                                        {
                                            var lr = lot;
                                            var dupLot = DuplicateLot(line, lr);
                                            <tr style="border-bottom:1px solid var(--mer-line-soft);">
                                                <td style="padding:4px;"><input class="rz-textbox" style="width:100%;padding:5px 8px;font-family:Inter,monospace;font-size:12px;@(dupLot ? "border:1px solid var(--mer-red);" : "")" placeholder="Lot / batch" @bind="lr.LotNo" @bind:event="oninput" /></td>
                                                <td style="padding:4px;"><input type="number" step="0.001" class="rz-textbox" style="width:100%;padding:5px 8px;font-family:Inter,monospace;font-size:12px;text-align:right;" @bind="lr.Qty" /></td>
                                                <td style="padding:4px;"><input type="date" class="rz-textbox" style="width:100%;padding:5px 8px;font-size:12px;" @bind="lr.ExpiryDate" /></td>
                                                <td style="padding:4px;text-align:center;"><button type="button" title="Remove lot" @onclick="() => line.Lots.Remove(lr)" style="background:transparent;border:0;color:var(--mer-red);cursor:pointer;"><span class="material-symbols-outlined" style="font-size:16px;">delete</span></button></td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                    <button class="rz-button" style="margin-top:8px;padding:6px 12px;border-radius:6px;border:1px solid var(--mer-ink-300);background:var(--mer-surface);cursor:pointer;font-size:12px;" @onclick="() => line.Lots.Add(new LotRow())">
                                        <span class="material-symbols-outlined" style="font-size:14px;vertical-align:middle;">add</span> Add lot
                                    </button>
                                    @if (!ok)
                                    {
                                        <div style="font-size:11.5px;color:var(--mer-red);margin-top:8px;">@lotMsg</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            }
            else if (currentStep == 3)
            {
                <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--mer-blue-darker);">Shipment details</h3>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Expected delivery date *</label>
                        <input type="date" class="rz-textbox" style="width:100%;padding:8px 10px;" @bind="expectedDeliveryDate" />
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Time window</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;" placeholder="e.g., 09:00–11:00" @bind="timeWindow" />
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Carrier name</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;" @bind="carrierName" />
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Tracking number</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;font-family:Inter,monospace;" @bind="trackingNumber" />
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Vehicle number</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;font-family:Inter,monospace;" @bind="vehicleNumber" />
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Driver name</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;" @bind="driverName" />
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Driver phone</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;font-family:Inter,monospace;" @bind="driverPhone" />
                    </div>
                </div>
                @* R11 (D6/D7) — shipment references. Required to SEND, not to save a draft, so the labels carry
                   the * but the wizard's Next/Save are not gated on them; Send For Approval is (server-enforced). *@
                <h3 style="font-size:14px;font-weight:700;margin:18px 0 12px;color:var(--mer-blue-darker);">Shipment references</h3>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Invoice no. *</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;font-family:Inter,monospace;" maxlength="50" @bind="invoiceNo" />
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Bill of lading *</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;font-family:Inter,monospace;" maxlength="50" @bind="billOfLading" />
                    </div>
                    <div>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Packing list *</label>
                        <input type="text" class="rz-textbox" style="width:100%;padding:8px 10px;font-family:Inter,monospace;" maxlength="50" @bind="packingList" />
                    </div>
                </div>
                @if (ShipmentRefsMissing)
                {
                    <p style="font-size:12px;color:var(--mer-ink-500);margin:8px 0 0;">
                        You can save this draft now, but all three are required before it can be sent for approval.
                    </p>
                }

                @* R11 (D12) — derived, read-only. Warehouse comes from the covered PO(s); the shipment date is
                   stamped when the buyer approves, so it reads "—" until then. *@
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:16px;padding-top:12px;border-top:1px solid var(--mer-line);">
                    <div>
                        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--mer-ink-500);margin-bottom:4px;">Warehouse</div>
                        <div style="font-size:13px;font-family:Inter,monospace;">@(string.IsNullOrEmpty(asnWarehouse) ? "—" : asnWarehouse)</div>
                    </div>
                    <div>
                        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--mer-ink-500);margin-bottom:4px;">Created</div>
                        <div style="font-size:13px;font-family:Inter,monospace;">@(asnCreatedOn?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                    </div>
                    <div>
                        @* R14 — blank until the ASN is posted, because posting is what sets it. *@
                        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--mer-ink-500);margin-bottom:4px;">Shipping date</div>
                        <div style="font-size:13px;font-family:Inter,monospace;" title="Set when you post the ASN">@(asnShipmentDate?.ToString("yyyy-MM-dd HH:mm") ?? "on post")</div>
                    </div>
                </div>

                <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);margin-top:12px;display:block;">Notes</label>
                <textarea class="rz-textbox" rows="3" style="width:100%;padding:8px 10px;font-family:inherit;" @bind="notes"></textarea>

                @* R7 — the R5 §13 Attachment Panel that used to be embedded here (step 3 only) moved into the
                   DocumentRail beside the wizard, where it is reachable from EVERY step. All its semantics
                   (thin client, "save the draft to attach" hint, Draft/Rejected editability) are unchanged. *@
            }
            else if (currentStep == 4)
            {
                <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--mer-blue-darker);">Review &amp; submit</h3>
                <dl style="display:grid;grid-template-columns:180px 1fr;gap:6px 16px;font-size:13px;">
                    <dt style="color:var(--mer-ink-500);">Purchase order(s)</dt><dd style="font-family:Inter,monospace;">@string.Join(", ", SelectedPoNumbers)</dd>
                    <dt style="color:var(--mer-ink-500);">Expected delivery</dt><dd style="font-family:Inter,monospace;">@expectedDeliveryDate?.ToString("yyyy-MM-dd")</dd>
                    <dt style="color:var(--mer-ink-500);">Carrier</dt><dd>@(string.IsNullOrEmpty(carrierName) ? "—" : carrierName)</dd>
                    <dt style="color:var(--mer-ink-500);">Tracking</dt><dd style="font-family:Inter,monospace;">@(string.IsNullOrEmpty(trackingNumber) ? "—" : trackingNumber)</dd>
                    <dt style="color:var(--mer-ink-500);">Vehicle</dt><dd style="font-family:Inter,monospace;">@(string.IsNullOrEmpty(vehicleNumber) ? "—" : vehicleNumber)</dd>
                    <dt style="color:var(--mer-ink-500);">Lines</dt><dd>@lines.Count(l => l.ShippedQty > 0) of @lines.Count being shipped</dd>
                    <dt style="color:var(--mer-ink-500);">Attachments</dt><dd>@attachments.Count</dd>
                </dl>

                @if (IsNew)
                {
                    <div style="background:var(--mer-blue-50);color:var(--mer-blue-darker);padding:10px 12px;border-radius:6px;font-size:12px;margin-top:12px;">
                        This saves a <b>Draft</b> ASN. You can add attachments and send it for approval from the draft.
                    </div>
                }
                else
                {
                    @* R5 (§10.1/§10.2) — the supplier no longer submits directly. "Send for approval" moves the ASN to
                       PendingApproval (running the §10.3 attachment check here) for a buyer to Approve (which submits)
                       or Reject. The shipment is locked while it awaits the decision. *@
                    <div style="background:var(--mer-blue-50);color:var(--mer-blue-darker);padding:10px 12px;border-radius:6px;font-size:12px;margin-top:12px;">
                        Sending for approval locks this ASN (header, lines and attachments become read-only) and routes it to the PO buyer(s). On <b>Approve</b> the shipment is submitted and a draft invoice spanning its PO(s) is created.
                    </div>
                }

                @if (!string.IsNullOrEmpty(submitError))
                {
                    <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:12px;white-space:pre-wrap;">@submitError</div>
                }
            }

            @if (currentStep == 4 && !IsNew && detail?.ShipBlocked == true)
            {
                <div style="background:var(--mer-amber-50, #fff8e6);border:1px solid var(--mer-amber-200,#ffe2a8);color:var(--mer-ink-700);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:12px;">
                    <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;">block</span>
                    @detail?.ShipBlockReason
                </div>
            }

            <div style="display:flex;justify-content:space-between;margin-top:24px;padding-top:16px;border-top:1px solid var(--mer-line);">
                <button class="mbtn mbtn--outline" @onclick="PrevStep" disabled="@(currentStep == 1)">Back</button>
                <div style="display:flex;gap:8px;">
                    @if (currentStep == 4)
                    {
                        <button class="mbtn mbtn--outline" @onclick="SaveDraft" disabled="@(busy || (!IsNew && detail?.ShipBlocked == true))">@(busy && savingDraft ? "Saving…" : (IsNew ? "Save draft" : "Save changes"))</button>
                        @if (!IsNew && detail is not null)
                        {
                            @* R14 — which final action the supplier gets depends on the supplier's ASN-confirmation
                               mode and the ASN's state:
                                 • confirmation required + Draft/Rejected → Send for approval (buyer confirms first);
                                 • confirmation NOT required + Draft       → Post (no buyer in the loop at all);
                                 • Approved (either mode)                  → Post (the buyer has confirmed).
                               CanPost comes from the server and mirrors AsnLifecycle.AssertCanPost exactly. *@
                            @if (detail.CanPost)
                            {
                                <button class="mbtn mbtn--primary-success" @onclick="PostAsn" disabled="@(busy || detail.ShipBlocked)" title="@(detail.ShipBlocked ? detail.ShipBlockReason : "Posts the shipment to the ERP and records today as the shipping date")">
                                    <span class="material-symbols-outlined">local_shipping</span> @(busy && !savingDraft ? "Posting…" : "Post")
                                </button>
                            }
                            else if (detail.AsnConfirmationRequired)
                            {
                                @* R5 (§10.2) — Draft/Rejected → PendingApproval. No documents or shipment refs
                                   required at this point (R14); both are enforced at Post. *@
                                <button class="mbtn mbtn--primary-success" @onclick="SendForApproval" disabled="@(busy || detail.ShipBlocked)">
                                    <span class="material-symbols-outlined">send</span> @(busy && !savingDraft ? "Sending…" : "Send for approval")
                                </button>
                            }
                        }
                    }
                    else
                    {
                        <button class="mbtn mbtn--primary" @onclick="NextStep" disabled="@(!CanProceed)">Next</button>
                    }
                </div>
            </div>
        </div>

        </div>
        @* R7 — editable-host rail. Wiring is IDENTICAL to the old step-3 embed: EntityId=Guid.Empty for a
           brand-new ASN (policy slots + "save the draft" hint), attachSupplierId stamps the upload seccode,
           OnPanelChanged keeps the step-4 review count fresh. The "Choose a supplier first." pre-condition
           renders inside the rail body via GuardMessage (same condition as before). *@
        <DocumentRail EntityCode="Asn"
                      EntityId="@(Id ?? Guid.Empty)"
                      Editable="@(CanWrite)"
                      SupplierId="@attachSupplierId"
                      OnChanged="OnPanelChanged"
                      GuardMessage="@(IsNew && (selectedSupplierId is null || selectedSupplierId == Guid.Empty) ? "Choose a supplier first." : null)"
                      Open="@railOpen"
                      OpenChanged="OnRailOpenChanged"
                      OnSummaryChanged="OnRailSummary" />
        </div>
    }
</div>

@if (showCancel && detail != null)
{
    <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div class="merino-dialog" data-variant="danger" data-size="md" style="width:520px;">
            <div class="merino-dialog__accent"></div>
            <header class="merino-dialog__header">
                <div class="merino-dialog__icon merino-dialog__icon--danger"><span class="material-symbols-outlined">block</span></div>
                <div class="merino-dialog__head-text">
                    <div class="merino-dialog__eyebrow">ASN</div>
                    <h2 class="merino-dialog__title">Cancel @detail.AsnNumber?</h2>
                    <p class="merino-dialog__subtitle">This is terminal — the ASN can no longer be edited or submitted.</p>
                </div>
                <button class="merino-dialog__close" @onclick="() => showCancel = false"><span class="material-symbols-outlined">close</span></button>
            </header>
            <div class="merino-dialog__body">
                @if (!string.IsNullOrEmpty(dialogError)) { <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;">@dialogError</div> }
                else { <p style="font-size:13px;color:var(--mer-ink-700);">Are you sure you want to cancel this ASN?</p> }
            </div>
            <footer class="merino-dialog__footer">
                <div class="merino-dialog__actions">
                    <button class="merino-dialog__btn" data-intent="ghost" @onclick="() => showCancel = false">Keep ASN</button>
                    <button class="merino-dialog__btn" data-intent="danger" @onclick="DoCancel" disabled="@busy">@(busy ? "Cancelling…" : "Cancel ASN")</button>
                </div>
            </footer>
        </div>
    </div>
}

@* ---------------- Over-ship validation dialog (§7 — ship qty exceeds order qty + tolerance) ---------------- *@
@if (showOverShip)
{
    <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div class="merino-dialog" data-variant="warning" data-size="md" style="width:560px;">
            <div class="merino-dialog__accent"></div>
            <header class="merino-dialog__header">
                <div class="merino-dialog__icon merino-dialog__icon--warning"><span class="material-symbols-outlined">production_quantity_limits</span></div>
                <div class="merino-dialog__head-text">
                    <div class="merino-dialog__eyebrow">ASN · Over-ship</div>
                    <h2 class="merino-dialog__title">Ship quantity exceeds the allowance</h2>
                    <p class="merino-dialog__subtitle">Reduce these lines to within the order qty + over-ship tolerance before continuing.</p>
                </div>
                <button class="merino-dialog__close" @onclick="() => showOverShip = false"><span class="material-symbols-outlined">close</span></button>
            </header>
            <div class="merino-dialog__body">
                <ul style="margin:0;padding-left:18px;font-size:12.5px;color:var(--mer-ink-700);">
                    @foreach (var l in lines.Where(OverAllowance))
                    {
                        <li style="margin-bottom:4px;"><b style="font-family:Inter,monospace;">@l.ItemCode</b> (PO @l.PoNumber · pos @l.PositionNo) — entered <b style="color:var(--mer-red);">@l.ShippedQty.ToString("0.###")</b>, max allowed <b>@l.OverShipAllowance.ToString("0.###")</b></li>
                    }
                </ul>
            </div>
            <footer class="merino-dialog__footer">
                <div class="merino-dialog__actions">
                    <button class="merino-dialog__btn" data-intent="primary" @onclick="() => showOverShip = false">OK, I'll fix it</button>
                </div>
            </footer>
        </div>
    </div>
}

@* ---------------- PO confirmation-gate override dialog (§6.5 / UC-PO-09) ---------------- *@
@if (showGateOverride)
{
    <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div class="merino-dialog" data-variant="warning" data-size="md" style="width:560px;">
            <div class="merino-dialog__accent"></div>
            <header class="merino-dialog__header">
                <div class="merino-dialog__icon merino-dialog__icon--warning"><span class="material-symbols-outlined">gpp_maybe</span></div>
                <div class="merino-dialog__head-text">
                    <div class="merino-dialog__eyebrow">ASN · Gate override</div>
                    <h2 class="merino-dialog__title">PO not confirmed for shipping</h2>
                    <p class="merino-dialog__subtitle">The confirmation gate blocked this shipment.</p>
                </div>
                <button class="merino-dialog__close" @onclick="() => showGateOverride = false"><span class="material-symbols-outlined">close</span></button>
            </header>
            <div class="merino-dialog__body">
                <div style="background:var(--mer-amber-50);color:var(--mer-amber-800);padding:10px 12px;border-radius:6px;font-size:12.5px;margin-bottom:12px;white-space:pre-wrap;">@gateBlockMessage</div>
                @if (CanOverrideGate)
                {
                    <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Override reason (required)</label>
                    <textarea class="rz-textbox" rows="3" style="width:100%;padding:8px 10px;font-family:inherit;" placeholder="Why is this exceptional shipment authorised?" @bind="gateOverrideReason"></textarea>
                    <p style="font-size:11px;color:var(--mer-ink-500);margin-top:6px;">This bypasses the confirmation gate and is recorded on the PO history (who / when / reason).</p>
                }
                else
                {
                    <p style="font-size:12.5px;color:var(--mer-ink-700);">Ask the supplier to confirm the PO, or an authorised user to override the gate.</p>
                }
                @if (!string.IsNullOrEmpty(gateOverrideError)) { <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:8px;">@gateOverrideError</div> }
            </div>
            <footer class="merino-dialog__footer">
                <div class="merino-dialog__actions">
                    <button class="merino-dialog__btn" data-intent="ghost" @onclick="() => showGateOverride = false">Cancel</button>
                    @if (CanOverrideGate)
                    {
                        <button class="merino-dialog__btn" data-intent="primary" @onclick="ConfirmGateOverride" disabled="@busy">@(busy ? "Working…" : "Override &amp; proceed")</button>
                    }
                </div>
            </footer>
        </div>
    </div>
}

@* ---------------- Missing-attachment Warning confirm dialog (§8.3 / UC-ATT-03) ---------------- *@
@if (showAttachConfirm)
{
    <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div class="merino-dialog" data-variant="warning" data-size="md" style="width:560px;">
            <div class="merino-dialog__accent"></div>
            <header class="merino-dialog__header">
                <div class="merino-dialog__icon merino-dialog__icon--warning"><span class="material-symbols-outlined">rule</span></div>
                <div class="merino-dialog__head-text">
                    <div class="merino-dialog__eyebrow">ASN · Attachments</div>
                    <h2 class="merino-dialog__title">Proceed without all attachments?</h2>
                </div>
                <button class="merino-dialog__close" @onclick="() => showAttachConfirm = false"><span class="material-symbols-outlined">close</span></button>
            </header>
            <div class="merino-dialog__body">
                <p style="font-size:13px;color:var(--mer-ink-700);">@attachConfirmMessage</p>
                @if (attachMissing.Count > 0)
                {
                    <div style="margin-top:10px;border:1px solid var(--mer-line);border-radius:6px;padding:10px 12px;background:var(--mer-ink-50);">
                        <div style="font-size:11px;font-weight:700;color:var(--mer-ink-600);margin-bottom:6px;">Not uploaded</div>
                        <ul style="margin:0;padding-left:18px;font-size:12.5px;color:var(--mer-ink-700);">
                            @foreach (var m in attachMissing) { <li>@m</li> }
                        </ul>
                    </div>
                }
            </div>
            <footer class="merino-dialog__footer">
                <div class="merino-dialog__actions">
                    <button class="merino-dialog__btn" data-intent="ghost" @onclick="() => showAttachConfirm = false">Go back</button>
                    <button class="merino-dialog__btn" data-intent="primary" @onclick="ConfirmSubmitWithMissingAttachments" disabled="@busy">@(busy ? "Submitting…" : "Yes, proceed")</button>
                </div>
            </footer>
        </div>
    </div>
}

@* ---------------- R5 (§10.2) buyer Approve dialog ---------------- *@
@if (showApprove && detail != null)
{
    <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div class="merino-dialog" data-variant="success" data-size="md" style="width:540px;">
            <div class="merino-dialog__accent"></div>
            <header class="merino-dialog__header">
                <div class="merino-dialog__icon merino-dialog__icon--success"><span class="material-symbols-outlined">task_alt</span></div>
                <div class="merino-dialog__head-text">
                    <div class="merino-dialog__eyebrow">ASN · Confirmation</div>
                    <h2 class="merino-dialog__title">Confirm @detail.AsnNumber?</h2>
                    @* R14 — approval no longer submits anything. It confirms the shipment details and hands the ASN
                       back to the supplier to complete and post. *@
                    <p class="merino-dialog__subtitle">Confirming verifies the shipment details. The supplier then uploads the remaining documents and posts the ASN — posting is what sends it to the ERP and sets the shipping date.</p>
                </div>
                <button class="merino-dialog__close" @onclick="() => showApprove = false"><span class="material-symbols-outlined">close</span></button>
            </header>
            <div class="merino-dialog__body">
                <p style="font-size:13px;color:var(--mer-ink-700);">Confirm you have reviewed the lines and shipment details. No balances are consumed and nothing is sent to the ERP until the supplier posts.</p>
                @if (!string.IsNullOrEmpty(approveError)) { <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:10px;white-space:pre-wrap;">@approveError</div> }
            </div>
            <footer class="merino-dialog__footer">
                <div class="merino-dialog__actions">
                    <button class="merino-dialog__btn" data-intent="ghost" @onclick="() => showApprove = false">Cancel</button>
                    <button class="merino-dialog__btn" data-intent="primary" @onclick="DoApprove" disabled="@busy">@(busy ? "Approving…" : "Approve & submit")</button>
                </div>
            </footer>
        </div>
    </div>
}

@* ---------------- R5 (§10.2) buyer Reject dialog (reason required) ---------------- *@
@if (showReject && detail != null)
{
    <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div class="merino-dialog" data-variant="danger" data-size="md" style="width:540px;">
            <div class="merino-dialog__accent"></div>
            <header class="merino-dialog__header">
                <div class="merino-dialog__icon merino-dialog__icon--danger"><span class="material-symbols-outlined">cancel</span></div>
                <div class="merino-dialog__head-text">
                    <div class="merino-dialog__eyebrow">ASN · Approval</div>
                    <h2 class="merino-dialog__title">Reject @detail.AsnNumber</h2>
                    <p class="merino-dialog__subtitle">The ASN returns to the supplier to edit and re-send. No balance is consumed.</p>
                </div>
                <button class="merino-dialog__close" @onclick="() => showReject = false"><span class="material-symbols-outlined">close</span></button>
            </header>
            <div class="merino-dialog__body">
                <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Reason (required)</label>
                <textarea class="rz-textbox" rows="4" style="width:100%;padding:8px 10px;font-family:inherit;" placeholder="Tell the supplier what to fix" @bind="rejectReason"></textarea>
                @if (!string.IsNullOrEmpty(rejectError)) { <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:8px;">@rejectError</div> }
            </div>
            <footer class="merino-dialog__footer">
                <div class="merino-dialog__actions">
                    <button class="merino-dialog__btn" data-intent="ghost" @onclick="() => showReject = false">Cancel</button>
                    <button class="merino-dialog__btn" data-intent="danger" @onclick="DoReject" disabled="@busy">@(busy ? "Rejecting…" : "Reject ASN")</button>
                </div>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    // R15 — the delivery-schedules page deep-links here with ?supplier=<id>&schedules=id1,id2: the named supplier
    // is chosen, the listed schedule lines are pre-checked (warehouse auto-locked) and the wizard lands on
    // Quantities. NO server draft exists until Save — the instant-draft dialog on that page was retired.
    // (The dead R4 ?pos= PO-preselect path was removed with the PO-picker step.)
    [SupplyParameterFromQuery(Name = "supplier")] public Guid? PreselectSupplier { get; set; }
    [SupplyParameterFromQuery(Name = "schedules")] public string? PreselectSchedules { get; set; }
    // R5 (§9.2) — the delivery-schedule flow lands on /asns/{id}?step=2 so the supplier opens directly on Lines.
    // Also used by the save-draft create path (?step=4) to keep the supplier on Review after the save re-navigation.
    // Applied ONCE, only for an existing ASN with lines already present; a brand-new ASN always starts at step 1.
    [SupplyParameterFromQuery(Name = "step")] public int? StartStep { get; set; }
    private AsnDetailDto? detail;
    private bool loading = true;
    private bool busy = false;
    private bool savingDraft = false;
    private int currentStep = 1;
    private string submitError = string.Empty;

    // Supplier-first (chooser hidden at 1 supplier) — unchanged; what follows the supplier changed in R15.
    private List<SupplierListItemDto> suppliers = new();
    private Guid? selectedSupplierId;
    private string? selectedSupplierName;

    // R15 (Design 1a) — step 1 is a flat grid of the supplier's APPROVED delivery-schedule lines (hard filter, D2).
    // scheduleRows caches one status=Approved sweep per supplier; the grid filters it client-side. Selection is
    // keyed by DeliverySchedule.Id; the FIRST pick locks the warehouse (§9.1) and rows for other warehouses are
    // disabled until Clear — the server AsnWarehouseRules invariant stays the authoritative fallback.
    private List<DeliveryScheduleDto> scheduleRows = new();
    private bool schedulesLoading;
    private readonly Dictionary<Guid, DeliveryScheduleDto> selectedSchedules = new();
    private string lineSearch = string.Empty;
    private string gridWarehouseFilter = string.Empty;
    private DateTime? gridDateFrom;
    private DateTime? gridDateTo;
    // Per-supplier PO-detail cache for line enrichment (serial/lot flags + over-ship allowance come off the PO
    // line, not the schedule row). One fetch per covered PO, reused across selection changes.
    private readonly Dictionary<Guid, PurchaseOrderDetailDto> poDetailCache = new();

    private List<LineRow> lines = new();
    private bool linesLoading = false;
    private DateTime? expectedDeliveryDate;
    private string? timeWindow;
    private string? carrierName;
    private string? trackingNumber;
    private string? vehicleNumber;
    private string? driverName;
    private string? driverPhone;
    private string? notes;

    // R11 (D6) — supplier-entered shipment references. Optional to SAVE a draft, MANDATORY to send it for
    // approval (the server is the authority; ShipmentRefsMissing mirrors the rule so the button can explain
    // itself before the round-trip). Editable in Draft/Rejected only, like the rest of the header.
    private string? invoiceNo;
    private string? billOfLading;
    private string? packingList;

    // R11 (D4/D12) — derived, read-only. Warehouse is snapshotted from the covered PO; created/shipment dates
    // come off the ASN itself (shipment date is the buyer-approval instant, so it is null until approved).
    private string? asnWarehouse;
    private DateTime? asnCreatedOn;
    private DateTime? asnShipmentDate;

    // Attachments — R5 (§13): the reusable AttachmentPanel now OWNS upload/list/remove (slots from the policy
    // read-model, files via /api/document-uploads/attach + DELETE). The page keeps only a lightweight count of the
    // ASN's attachments (for the step-4 review summary), refreshed from the by-asn list endpoint on panel changes.
    private readonly List<DocumentAttachmentDto> attachments = new();
    private Guid attachSupplierId;

    // ---- R7 (§2) — document-rail state (shared by the pill in the header and the rail in either branch) ----
    // §2.3 default is host-derived: starts closed; the FIRST panel summary flips it open when this is the
    // editable host AND any Mandatory slot is empty. A manual toggle (pill / Escape / close / backdrop) wins
    // permanently — the auto-default never fights the user.
    private bool railOpen;
    private bool _railUserToggled;
    private AttachmentPanelSummary? railSummary;

    private void OnRailOpenChanged(bool open)
    {
        railOpen = open;
        _railUserToggled = true;
    }

    private void OnRailSummary(AttachmentPanelSummary summary)
    {
        railSummary = summary;
        // No policy slots (no master requirement) => no control: keep the rail collapsed; the header pill hides too.
        if (summary.TotalSlots == 0) { railOpen = false; return; }
        if (!_railUserToggled && !railOpen && !IsLocked && CanWrite && summary.AnyMandatoryEmpty)
            railOpen = true;
    }
    // R4 (2026-06-23) — deferred-upload staging key for create-mode attachments (rebound onto the ASN by CreateAsn).
    private Guid _stagingKey = Guid.NewGuid();

    private bool showCancel = false;
    private string dialogError = string.Empty;

    // R4 (2026-06-26) — §6.5 / UC-PO-09: PO confirmation-gate block + admin override. When create/submit returns the
    // gate message, surface it; a caller with PurchaseOrder.OverrideGate can supply a reason to re-submit past it.
    private bool showGateOverride = false;
    private string gateBlockMessage = string.Empty;
    private bool showOverShip = false;
    private string gateOverrideReason = string.Empty;
    private string gateOverrideError = string.Empty;

    // R4 (2026-06-26) — §8.3 / UC-ATT-03: missing-Warning-attachment confirm. The first submit returns a 200 with
    // ConfirmationRequired=true; on confirm we re-submit with AcknowledgeMissingAttachments=true.
    private bool showAttachConfirm = false;
    private string attachConfirmMessage = string.Empty;
    private List<string> attachMissing = new();
    // R14 — which action raised the two-step dialogs, so the confirm retries the right endpoint.
    private bool confirmingPost = false;
    private bool gateOverrideForPost = false;

    // R5 (§10.2) — buyer Approve / Reject dialog state.
    private bool showApprove = false;
    private bool showReject = false;
    private string rejectReason = string.Empty;
    private string approveError = string.Empty;
    private string rejectError = string.Empty;

    // R6 — Retry generation for a Blocked ASN (POST api/invoices/from-asn; idempotent). A still-blocked
    // generator returns 400 with the reason — surfaced inline in the Blocked banner, not a dialog.
    private bool invoiceRetryBusy = false;
    private string invoiceRetryError = string.Empty;

    private async Task RetryInvoiceGeneration()
    {
        if (detail == null) return;
        invoiceRetryBusy = true; invoiceRetryError = string.Empty;
        var resp = await Api.PostAsync<InvoiceDetailDto, CreateInvoiceFromAsnRequest>(
            "api/invoices/from-asn", new CreateInvoiceFromAsnRequest(detail.Id));
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Draft invoice(s) generated" });
            await Reload();
        }
        else
        {
            invoiceRetryError = resp?.Errors?.FirstOrDefault() ?? "Generation is still blocked.";
        }
        invoiceRetryBusy = false;
    }

    private bool IsNew => !Id.HasValue;
    private bool IsLocked => detail?.IsLocked == true;
    private bool CanWrite => Token.IsSupplier || Token.HasPermission("Asn.Write");
    private bool CanOverrideGate => Token.HasPermission("PurchaseOrder.OverrideGate");
    // R5 (§10.2) — buyer decision permission. Asn.Approve is seeded to SuperAdmin/Admin/Buyer (not Supplier). The
    // server AsnApprovalGate additionally asserts the caller is a MAPPED PO buyer; we only gate the affordance here.
    private bool CanApprove => Token.HasPermission("Asn.Approve");
    // Cancel is supplier-side and valid on any of the supplier's active states.
    // R14 — Approved joins them: a confirmed-but-unposted ASN has consumed nothing and dispatched nothing, so the
    // supplier must still be able to withdraw it (mirrors AsnLifecycle.Cancellable).
    // Submitted/InTransit/Delivered/Cancelled are terminal-for-cancel here (the read-only view hides it via this flag).
    private bool CanCancel => detail?.AsnStatus is "Draft" or "Rejected" or "PendingApproval" or "Approved";

    // The gate block message names the required action; the API stamps it under the "poStatus" error key. Match the
    // stable prefix so we route it to the override dialog rather than the generic error banner.
    private static bool IsGateBlock(string? msg) =>
        !string.IsNullOrEmpty(msg) && msg.Contains("before shipments can be created", StringComparison.OrdinalIgnoreCase);

    // R15 — the covered-PO summary derives from the working line set (there is no PO picker anymore).
    private IEnumerable<string> SelectedPoNumbers =>
        lines.Select(l => l.PoNumber).Distinct().OrderBy(x => x);

    private string PoSummaryText =>
        detail == null ? "" :
        detail.PurchaseOrders.Count > 0 ? string.Join(", ", detail.PurchaseOrders.Select(p => p.PoNumber))
        : (detail.PoNumber ?? "—");

    private string HeaderSubtitle =>
        IsNew ? "Submit a shipping notice for one or more purchase orders"
        : detail == null ? ""
        : $"ASN for PO {PoSummaryText}";

    // R15 — step-1 helper (Design 1a): pick approved schedule lines; the first pick locks the warehouse.
    private string Step1HelperText =>
        (suppliers.Count > 1 ? "Choose the supplier, then pick" : "Pick")
        + " the approved delivery-schedule lines to ship — one warehouse per ASN; the first line you pick locks it. Lines may span multiple POs.";

    // R11 (D6/D7) — true while any of the three shipment refs is blank. The SERVER is the authority (it hard-
    // blocks Send-For-Approval); this only lets the UI say so before the round-trip. Deliberately NOT wired into
    // CanProceed — a draft with blanks is still saveable, which is the whole point of D7.
    private bool ShipmentRefsMissing =>
        string.IsNullOrWhiteSpace(invoiceNo)
        || string.IsNullOrWhiteSpace(billOfLading)
        || string.IsNullOrWhiteSpace(packingList);

    // ======================= R15 (Design 1a) — step-1 schedule-grid derived state =======================

    // §9.1 warehouse lock — the first selected schedule fixes the warehouse; null address ids participate as a
    // legitimate lock value (legacy lines), so the lock is "has a selection", not "has a non-null id".
    private Guid? lockedWarehouseId => selectedSchedules.Values.Select(s => s.WarehouseAddressId).FirstOrDefault();
    private string? lockedWarehouseLabel
    {
        get
        {
            var s = selectedSchedules.Values.FirstOrDefault();
            if (s is null) return null;
            return string.IsNullOrWhiteSpace(s.WarehouseAddressName)
                ? (string.IsNullOrWhiteSpace(s.Warehouse) ? "—" : s.Warehouse)
                : $"{s.Warehouse} · {s.WarehouseAddressName}";
        }
    }

    // The selectable universe inside the locked warehouse (balance left + shippable), across the WHOLE cached
    // sweep — "Select all in this warehouse" deliberately ignores the client-side filters.
    private IEnumerable<DeliveryScheduleDto> LockedWarehousePool =>
        selectedSchedules.Count == 0
            ? Enumerable.Empty<DeliveryScheduleDto>()
            : scheduleRows.Where(r => r.WarehouseAddressId == lockedWarehouseId && r.RemainingToShip > 0 && r.IsShippable);

    private bool AllLockedSelected =>
        LockedWarehousePool.Any() && LockedWarehousePool.All(r => selectedSchedules.ContainsKey(r.Id));

    // Grid rows after the client-side filters, sorted PO → position → delivery date so the PO banding groups.
    private IEnumerable<DeliveryScheduleDto> VisibleScheduleRows
    {
        get
        {
            var q = scheduleRows.AsEnumerable();
            if (!string.IsNullOrEmpty(gridWarehouseFilter) && Guid.TryParse(gridWarehouseFilter, out var wid))
                q = q.Where(r => r.WarehouseAddressId == wid);
            if (!string.IsNullOrWhiteSpace(lineSearch))
            {
                var t = lineSearch.Trim();
                q = q.Where(r => r.PoNumber.Contains(t, StringComparison.OrdinalIgnoreCase)
                                 || r.ItemCode.Contains(t, StringComparison.OrdinalIgnoreCase)
                                 || (r.ItemDescription?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            if (gridDateFrom.HasValue) q = q.Where(r => r.DeliveryDate >= gridDateFrom.Value.Date);
            if (gridDateTo.HasValue) q = q.Where(r => r.DeliveryDate < gridDateTo.Value.Date.AddDays(1));
            return q.OrderBy(r => r.PoNumber).ThenBy(r => r.PositionNo).ThenBy(r => r.DeliveryDate);
        }
    }

    private sealed record GridWarehouseOption(Guid Id, string Name);
    private List<GridWarehouseOption> GridWarehouseOptions =>
        scheduleRows.Where(r => r.WarehouseAddressId.HasValue)
            .Select(r => new GridWarehouseOption(r.WarehouseAddressId!.Value,
                string.IsNullOrWhiteSpace(r.WarehouseAddressName) ? (r.Warehouse ?? "—") : r.WarehouseAddressName!))
            .DistinctBy(o => o.Id)
            .OrderBy(o => o.Name)
            .ToList();

    private bool CanProceed => currentStep switch
    {
        // Step 1 (R15) — ≥1 schedule line picked. Edit mode also passes on legacy lines that have no matching
        // schedule row (they live only in `lines`) so a pre-R15 draft is never stranded.
        1 => selectedSchedules.Count > 0 || lines.Count > 0,
        // Step 2 also gates on serial/lot capture: every serialized line must have N serials and every lot line
        // must have Σqty == ShippedQty (no dupes). The backend SubmitAsnCommand re-enforces; this blocks early.
        2 => lines.Any(l => l.ShippedQty > 0) && SerialLotCaptureValid,
        3 => expectedDeliveryDate.HasValue,
        _ => true
    };

    // R4 (2026-06-27) — client-side over-ship UX: restrict the supplier as soon as the entered ship qty exceeds the
    // order qty + over-ship tolerance ceiling (OverShipAllowance), instead of only failing at submit; and lock a row
    // that has no remaining ship capacity. The server atomic guard (behind Fulfilment.EnforceOverShipGuard) remains
    // the authoritative check.
    private static bool OverAllowance(LineRow l) => l.ShippedQty > l.OverShipAllowance;
    private static bool FullyShipped(LineRow l) => l.OverShipAllowance <= 0;

    // Surface the over-ship dialog the moment the Ship Qty field loses focus (not only on Next).
    private void OnShipQtyBlur(LineRow l) { if (OverAllowance(l)) showOverShip = true; }

    // Reload whenever the route id changes — Blazor REUSES this component across /asns/new -> /asns/{id}
    // (the save-draft navigation), so OnInitializedAsync (once-only) would leave detail=null => "ASN not found".
    private Guid? _loadedId;
    private bool _loadedNew;
    // R5 (§9.2) — one-shot guard so ?step= is honored on the FIRST existing-ASN load only (not on the save-draft
    // re-navigation or later re-renders). Once applied it stays true for the component's lifetime.
    private bool _startStepApplied;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Id || (IsNew && !_loadedNew))
        {
            _loadedId = Id;
            _loadedNew = IsNew;
            currentStep = 1;
            await Reload();
        }
    }

    // R5 (§13) — the AttachmentPanel raises this after every upload/remove. Refresh the lightweight count the
    // step-4 review summary shows from the by-asn list endpoint (the panel owns the actual files + their display).
    private async Task OnPanelChanged()
    {
        if (!Id.HasValue) return;
        var resp = await Api.GetAsync<List<DocumentAttachmentDto>>($"api/document-uploads/by-asn/{Id.Value}");
        attachments.Clear();
        if (resp?.Data is { } docs) attachments.AddRange(docs);
        StateHasChanged();
    }

    private async Task Reload()
    {
        loading = true;
        if (IsNew)
        {
            // Suppliers the signed-in user can act for (seccode-scoped). Supplier-first picker when >1.
            var sup = await Api.GetAsync<List<SupplierListItemDto>>("api/suppliers");
            suppliers = sup?.Data ?? new();
            if (!string.IsNullOrWhiteSpace(PreselectSchedules))
                await ApplySchedulePreselectAsync();
            else if (suppliers.Count == 1)
                await ChooseSupplierAsync(suppliers[0].Id);
            loading = false;
        }
        else
        {
            var resp = await Api.GetAsync<AsnDetailDto>($"api/asns/{Id}");
            detail = resp?.Data;
            if (detail != null)
            {
                attachSupplierId = detail.SupplierId;
                expectedDeliveryDate = detail.ExpectedDeliveryDate;
                timeWindow = detail.TimeWindow;
                carrierName = detail.CarrierName;
                trackingNumber = detail.TrackingNumber;
                vehicleNumber = detail.VehicleNumber;
                driverName = detail.DriverName;
                driverPhone = detail.DriverPhone;
                notes = detail.Notes;
                invoiceNo = detail.InvoiceNo;
                billOfLading = detail.BillOfLading;
                packingList = detail.PackingList;
                asnWarehouse = detail.Warehouse;
                asnCreatedOn = detail.CreatedOn;
                // R14 — the shipping date is the post date.
                asnShipmentDate = detail.PostedAt;

                attachments.Clear();
                attachments.AddRange(detail.Attachments);

                // R15 — reset the schedule-grid state for this ASN's supplier.
                selectedSchedules.Clear();
                scheduleRows = new();
                poDetailCache.Clear();
                selectedSupplierId = detail.SupplierId;
                selectedSupplierName = detail.SupplierName;
                // The supplier on an edited Draft is fixed to the ASN's supplier (single-entry list → no chooser).
                suppliers = new List<SupplierListItemDto> { new(detail.SupplierId, 0, "", detail.SupplierName, null, null, null, "", false, DateTime.UtcNow) };

                lines = detail.Lines.Select(l => new LineRow
                {
                    PurchaseOrderLineId = l.PurchaseOrderLineId,
                    PurchaseOrderId = l.PurchaseOrderId,
                    PoNumber = l.PoNumber,
                    PositionNo = l.PositionNo ?? l.PoPositionNo,
                    SequenceNo = l.SequenceNo,
                    ItemCode = l.ItemCode,
                    OrderQty = l.OrderQty,
                    ShippedQty = l.ShippedQty,
                    BatchNumber = l.BatchNumber,
                    ExpiryDate = l.ExpiryDate,
                    // R15 — schedule provenance (null on legacy PO-picked lines): drives the step-1 pre-check and
                    // the Quantities Delivery column.
                    DeliveryScheduleId = l.DeliveryScheduleId,
                    DeliveryDate = l.ScheduleDeliveryDate,
                    // AsnLineDto carries no Item flag — infer the line type from which capture collection is
                    // populated (serialized XOR lot-controlled). Re-merged with PO flags below for empty lines.
                    IsSerialized = l.Serials is { Count: > 0 },
                    IsLotControlled = l.Lots is { Count: > 0 },
                    Serials = l.Serials?.Select(s => new SerialRow { Serial = s.SerialNumber, Expiry = s.ExpiryDate }).ToList() ?? new(),
                    Lots = l.Lots?.Select(x => new LotRow { LotNo = x.LotNo, Qty = x.Qty, ExpiryDate = x.ExpiryDate }).ToList() ?? new(),
                    // R4 (2026-06-26) — §7.3 / DI-04: ship-tracking from the ASN line (EnrichLinesAsync re-merges the
                    // PO line's authoritative figures for editable drafts; the locked read-only view uses these).
                    ShippedQtyToDate = l.ShippedQtyToDate,
                    Balance = l.Balance,
                    OverShipAllowance = l.OverShipAllowance
                }).ToList();

                // R15 — an editable ASN shows ONLY its own lines (the old ReloadLines() PO sweep — which merged in
                // EVERY line of every covered PO — is gone; that was the "from-schedule ASN shows all PO lines" bug).
                // Load the supplier's approved schedule grid, pre-check the rows behind this ASN's lines so step 1
                // reflects the saved selection, then enrich only these lines with the PO-line flags/allowance.
                if (!IsLocked)
                {
                    await LoadSchedulesAsync();
                    PrecheckSchedulesFromLines();
                    await EnrichLinesAsync();
                }

                // R5 (§9.2) — honor ?step= ONCE: the delivery-schedule flow lands on /asns/{id}?step=2 to open
                // directly on Lines. Only for an EXISTING ASN that already has lines, and only on the first load
                // (guarded so the save-draft re-navigation / later re-renders never re-jump the wizard). An
                // IsLocked ASN renders the read-only view (no wizard) so the clamp is harmless there.
                if (!_startStepApplied && StartStep.HasValue && lines.Count > 0)
                {
                    currentStep = Math.Clamp(StartStep.Value, 1, 4);
                }
                _startStepApplied = true;
            }
            loading = false;
        }
    }

    private async Task OnSupplierSelect(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id)) { await ChooseSupplierAsync(id); }
        else
        {
            selectedSupplierId = null; selectedSupplierName = null;
            // Clearing the supplier also clears the schedule grid + selection.
            selectedSchedules.Clear(); lines.Clear(); scheduleRows = new(); poDetailCache.Clear();
        }
    }

    private async Task ChooseSupplierAsync(Guid supplierId)
    {
        selectedSupplierId = supplierId;
        attachSupplierId = supplierId;   // create-mode staging uploads stamp this supplier's seccode
        selectedSupplierName = suppliers.FirstOrDefault(s => s.Id == supplierId)?.LegalName;
        // Switching supplier resets the grid (an ASN ships from a single supplier).
        selectedSchedules.Clear(); lines.Clear(); poDetailCache.Clear();
        lineSearch = string.Empty; gridWarehouseFilter = string.Empty; gridDateFrom = null; gridDateTo = null;
        await LoadSchedulesAsync();
    }

    // R15 (D1/D2) — ONE Approved-only sweep per supplier (hard gate; pageSize 500 mirrors the delivery-schedules
    // page option sweep). The step-1 grid filters this cache client-side.
    private async Task LoadSchedulesAsync()
    {
        if (!selectedSupplierId.HasValue) { scheduleRows = new(); return; }
        schedulesLoading = true; StateHasChanged();
        var url = $"api/delivery-schedules?page=1&pageSize=500&supplierId={selectedSupplierId}&status=Approved";
        var resp = await Api.GetAsync<DeliveryScheduleGridDto>(url);
        scheduleRows = resp?.Data?.Page.Items.ToList() ?? new();
        schedulesLoading = false;
    }

    // Edit mode — reflect the ASN's saved lines in the step-1 grid: check each line's schedule row (by the
    // persisted back-link), and ASSOCIATE legacy lines (null back-link) with the first free schedule row of the
    // same PO line so re-saving starts carrying the provenance. A line with no schedule row at all stays only in
    // `lines` (still editable/shippable — never silently dropped).
    private void PrecheckSchedulesFromLines()
    {
        var byId = scheduleRows.ToDictionary(r => r.Id);
        foreach (var line in lines)
        {
            if (line.DeliveryScheduleId is { } sid && byId.TryGetValue(sid, out var row))
            {
                selectedSchedules[row.Id] = row;
                line.DeliveryDate ??= row.DeliveryDate;
                line.ScheduledQty = row.ScheduledQty;
                continue;
            }
            var fallback = scheduleRows.FirstOrDefault(r =>
                r.PurchaseOrderLineId == line.PurchaseOrderLineId && !selectedSchedules.ContainsKey(r.Id));
            if (fallback is not null)
            {
                line.DeliveryScheduleId = fallback.Id;
                line.DeliveryDate ??= fallback.DeliveryDate;
                line.ScheduledQty = fallback.ScheduledQty;
                selectedSchedules[fallback.Id] = fallback;
            }
        }
    }

    // R15 — ?supplier&schedules deep link from the delivery-schedules page: choose the supplier, load its grid,
    // check the listed schedule rows (ids not in the Approved sweep are skipped), and land on Quantities.
    private async Task ApplySchedulePreselectAsync()
    {
        var ids = (PreselectSchedules ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => Guid.TryParse(s, out var g) ? g : Guid.Empty).Where(g => g != Guid.Empty).Distinct().ToHashSet();
        if (ids.Count == 0) return;

        var supplierId = PreselectSupplier
            ?? (suppliers.Count == 1 ? suppliers[0].Id : (Guid?)null);
        if (!supplierId.HasValue || suppliers.All(s => s.Id != supplierId.Value)) return;

        await ChooseSupplierAsync(supplierId.Value);
        foreach (var row in scheduleRows.Where(r => ids.Contains(r.Id)))
        {
            // Respect the same rules as a manual pick (balance, shippable, single warehouse).
            if (row.RemainingToShip <= 0 || !row.IsShippable) continue;
            if (selectedSchedules.Count > 0 && row.WarehouseAddressId != lockedWarehouseId) continue;
            selectedSchedules[row.Id] = row;
        }
        if (selectedSchedules.Count > 0)
        {
            RebuildLinesFromSelection();
            await EnrichLinesAsync();
            currentStep = 2;   // land on Quantities — the selection is already made
        }
    }

    // ---- Step-1 selection ops (mirror the delivery-schedules page §9.1 rules) ----

    private async Task ToggleScheduleRow(DeliveryScheduleDto row)
    {
        if (!selectedSchedules.Remove(row.Id))
        {
            if (row.RemainingToShip <= 0 || !row.IsShippable) return;
            if (selectedSchedules.Count > 0 && row.WarehouseAddressId != lockedWarehouseId) return;   // cross-warehouse guard
            selectedSchedules[row.Id] = row;
        }
        RebuildLinesFromSelection();
        await EnrichLinesAsync();
    }

    private async Task SelectAllInLockedWarehouse()
    {
        foreach (var r in LockedWarehousePool) selectedSchedules[r.Id] = r;
        RebuildLinesFromSelection();
        await EnrichLinesAsync();
    }

    private async Task ToggleAllInLockedWarehouse()
    {
        if (selectedSchedules.Count == 0) return;
        if (AllLockedSelected)
        {
            ClearScheduleSelection();
            return;
        }
        await SelectAllInLockedWarehouse();
    }

    private void ClearScheduleSelection()
    {
        selectedSchedules.Clear();
        RebuildLinesFromSelection();
    }

    // Rebuild the working line set from the schedule selection. Rows keep their entered qty/batch/capture across
    // select/deselect (keyed by schedule id); LEGACY rows (no schedule link — pre-R15 drafts) are always kept.
    // D4 — a NEW row's ship qty defaults to min(ScheduledQty, remaining balance).
    private void RebuildLinesFromSelection()
    {
        var byScheduleId = lines.Where(l => l.DeliveryScheduleId.HasValue)
            .ToDictionary(l => l.DeliveryScheduleId!.Value);
        var keep = lines.Where(l => !l.DeliveryScheduleId.HasValue).ToList();

        foreach (var s in selectedSchedules.Values)
        {
            if (byScheduleId.TryGetValue(s.Id, out var prev)) { keep.Add(prev); continue; }
            keep.Add(new LineRow
            {
                DeliveryScheduleId = s.Id,
                PurchaseOrderLineId = s.PurchaseOrderLineId,
                PurchaseOrderId = s.PurchaseOrderId,
                PoNumber = s.PoNumber,
                PositionNo = s.PositionNo,
                ItemCode = s.ItemCode,
                OrderQty = s.OrderQty,
                DeliveryDate = s.DeliveryDate,
                ScheduledQty = s.ScheduledQty,
                ShippedQty = Math.Max(0m, Math.Min(s.ScheduledQty, s.RemainingToShip)),
                ShippedQtyToDate = s.ShippedQtyToDate,
                Balance = s.RemainingToShip,
                // Provisional until EnrichLinesAsync merges the tolerance-adjusted ceiling off the PO line.
                OverShipAllowance = s.RemainingToShip,
            });
        }

        lines = keep
            .OrderBy(l => l.PoNumber).ThenBy(l => l.PositionNo)
            .ThenBy(l => l.DeliveryDate ?? DateTime.MaxValue)
            .ToList();
    }

    // Enrich the working rows with the PO-LINE figures the schedule row doesn't carry: serial/lot capture flags,
    // the tolerance-adjusted OverShipAllowance, live Balance/ShippedQtyToDate and SequenceNo. One PO-detail fetch
    // per covered PO (cached per supplier session); merges onto the SELECTED rows only — never adds rows.
    private async Task EnrichLinesAsync()
    {
        if (lines.Count == 0) return;
        linesLoading = true;
        StateHasChanged();
        foreach (var poId in lines.Select(l => l.PurchaseOrderId).Distinct().ToList())
        {
            if (poDetailCache.ContainsKey(poId)) continue;
            var resp = await Api.GetAsync<PurchaseOrderDetailDto>($"api/purchase-orders/{poId}");
            if (resp?.Data != null) poDetailCache[poId] = resp.Data;
        }
        foreach (var line in lines)
        {
            if (!poDetailCache.TryGetValue(line.PurchaseOrderId, out var po)) continue;
            var pol = po.Lines.FirstOrDefault(x => x.Id == line.PurchaseOrderLineId);
            if (pol == null) continue;
            line.SequenceNo = pol.SequenceNo;
            line.OrderQty = pol.OrderQty;
            line.IsSerialized = pol.IsSerialized;
            line.IsLotControlled = pol.IsLotControlled;
            line.ShippedQtyToDate = pol.ShippedQtyToDate;
            line.Balance = pol.Balance;
            line.OverShipAllowance = pol.OverShipAllowance;
            line.IsOverShippedQtyReduced = pol.IsOverShippedQtyReduced;
        }
        linesLoading = false;
        StateHasChanged();
    }

    private void GoStep(int s) { if (s <= currentStep) currentStep = s; }
    private void PrevStep() { if (currentStep > 1) currentStep--; }
    private void NextStep()
    {
        // Over-ship: surface a dialog naming the offending lines rather than silently disabling Next (§7 guard).
        if (currentStep == 2 && lines.Any(OverAllowance)) { showOverShip = true; return; }
        if (currentStep < 4 && CanProceed) currentStep++;
    }
    private string StepLabel(int s) => s switch { 1 => "Lines", 2 => "Quantities", 3 => "Shipment", 4 => "Review", _ => "" };

    // ---- Save draft (create or update) ----
    private async Task SaveDraft()
    {
        if (lines.Count == 0 || !expectedDeliveryDate.HasValue) { submitError = "Select at least one line and an expected delivery date."; currentStep = lines.Count == 0 ? 1 : 3; return; }
        busy = true; savingDraft = true; submitError = string.Empty;

        var lineReqs = BuildLineRequests();
        if (lineReqs.Count == 0) { submitError = "Enter a ship quantity on at least one line."; busy = false; savingDraft = false; currentStep = 2; return; }

        if (IsNew)
        {
            await CreateDraftAsync(lineReqs, overrideReason: null);
        }
        else
        {
            var req = new UpdateAsnRequest(expectedDeliveryDate.Value, timeWindow, carrierName, trackingNumber, vehicleNumber, driverName, driverPhone, notes, lineReqs,
                InvoiceNo: invoiceNo, BillOfLading: billOfLading, PackingList: packingList);
            var resp = await Api.PutAsync<AsnDetailDto, UpdateAsnRequest>($"api/asns/{Id}", req);
            if (resp?.Success == true) { Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Draft saved" }); await Reload(); }
            else { submitError = resp?.Errors?.FirstOrDefault() ?? "Failed to save (the ASN may no longer be Draft)."; }
        }
        busy = false; savingDraft = false;
    }

    // ---- R5 (§10.2) Send for approval (Draft/Rejected -> PendingApproval) ----
    // R14 — the attachment-requirement check and the mandatory shipment references BOTH moved off this path to
    // Post, so a supplier can obtain buyer confirmation before the documents exist. This call now only has to get
    // past the PO ship gate.
    private async Task SendForApproval()
    {
        if (IsNew) { await SaveDraft(); return; }
        busy = true; savingDraft = false; submitError = string.Empty;

        // Block the obvious serial/lot failures before the round-trip (the backend re-enforces at Post).
        if (!SerialLotCaptureValid)
        {
            submitError = "Fix the serial/lot capture before sending: every serialized line needs one serial per unit, and every lot line's quantities must sum to the shipped quantity (no duplicates).";
            busy = false; currentStep = 2; return;
        }

        if (!await SavePendingEditsAsync("sending for approval")) { busy = false; return; }

        await SendForApprovalAsync(acknowledgeMissingAttachments: false);
        busy = false;
    }

    // ---- R14 Post (Approved -> Submitted, or Draft -> Submitted when the supplier needs no confirmation) ----
    // The ERP dispatch. Everything deferred from send-for-approval lands here server-side: the three mandatory
    // shipment references, the attachment policy (Mandatory blocks / Warning two-step), the PO confirmation gate
    // (with the §6.5 admin override), the over-ship balance guard, draft-invoice generation and the LN outbox.
    private async Task PostAsn()
    {
        if (IsNew) { await SaveDraft(); return; }
        busy = true; savingDraft = false; submitError = string.Empty;

        if (!SerialLotCaptureValid)
        {
            submitError = "Fix the serial/lot capture before posting: every serialized line needs one serial per unit, and every lot line's quantities must sum to the shipped quantity (no duplicates).";
            busy = false; currentStep = 2; return;
        }

        // Client-side pre-check on the three references so the supplier is sent straight to the field that is
        // missing rather than bouncing off a 400. The server enforces them regardless.
        var missingRefs = new List<string>();
        if (string.IsNullOrWhiteSpace(invoiceNo)) missingRefs.Add("invoice no.");
        if (string.IsNullOrWhiteSpace(billOfLading)) missingRefs.Add("bill of lading");
        if (string.IsNullOrWhiteSpace(packingList)) missingRefs.Add("packing list");
        if (missingRefs.Count > 0)
        {
            submitError = $"Fill in {string.Join(", ", missingRefs)} before posting the ASN.";
            busy = false; currentStep = 3; return;
        }

        if (!await SavePendingEditsAsync("posting")) { busy = false; return; }

        await PostAsnAsync(acknowledgeMissingAttachments: false, overrideReason: null);
        busy = false;
    }

    // Persist pending header/line edits before a final action. Both final actions validate the STORED ASN, and an
    // edit on a Rejected ASN flips it back to Draft server-side (an Approved one stays Approved).
    private async Task<bool> SavePendingEditsAsync(string actionLabel)
    {
        var lineReqs = BuildLineRequests();
        var upd = new UpdateAsnRequest(expectedDeliveryDate!.Value, timeWindow, carrierName, trackingNumber, vehicleNumber, driverName, driverPhone, notes, lineReqs,
                InvoiceNo: invoiceNo, BillOfLading: billOfLading, PackingList: packingList);
        var saveResp = await Api.PutAsync<AsnDetailDto, UpdateAsnRequest>($"api/asns/{Id}", upd);
        if (saveResp?.Success == true) return true;
        submitError = saveResp?.Errors?.FirstOrDefault() ?? $"Could not save before {actionLabel}.";
        return false;
    }

    // ---- Create draft (with optional gate override). On a gate block, route to the override dialog. ----
    private async Task CreateDraftAsync(List<CreateAsnLineRequest> lineReqs, string? overrideReason)
    {
        // R15 — the PO set derives from the lines actually being shipped (there is no PO picker anymore).
        var poList = lines.Where(l => l.ShippedQty > 0).Select(l => l.PurchaseOrderId).Distinct().ToList();
        var req = new CreateAsnRequest(
            poList.Count == 1 ? poList[0] : (Guid?)null,
            poList.Count > 1 ? poList : null,
            expectedDeliveryDate!.Value, timeWindow, carrierName, trackingNumber, vehicleNumber, driverName, driverPhone, notes, lineReqs,
            StagingKey: _stagingKey,
            OverrideReason: string.IsNullOrWhiteSpace(overrideReason) ? null : overrideReason.Trim(),
            InvoiceNo: invoiceNo, BillOfLading: billOfLading, PackingList: packingList);
        var resp = await Api.PostAsync<AsnDetailDto, CreateAsnRequest>("api/asns", req);
        if (resp?.Success == true && resp.Data != null)
        {
            showGateOverride = false;
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Draft ASN created" });
            // Navigate to the saved draft so attachments (ownerEntityType='Asn') become available + submit is enabled.
            // ?step=4 keeps the reused component on Review instead of resetting to step 1 (PO select) — it reuses the
            // one-shot StartStep machinery, so saving a draft leaves the supplier on the review page.
            NavMgr.NavigateToRoute($"/asns/{resp.Data.Id}?step=4");
            return;
        }
        var err = resp?.Errors?.FirstOrDefault();
        if (IsGateBlock(err)) { OpenGateOverride(err!); }
        else { submitError = err ?? "Failed to create ASN."; }
    }

    // ---- R5 (§10.2) Send-for-approval. ----
    // R14 — with the attachment guard moved to Post, this path can no longer return ConfirmationRequired and can
    // no longer be blocked by a missing document. Only the PO ship gate can stop it.
    private async Task SendForApprovalAsync(bool acknowledgeMissingAttachments)
    {
        var body = new SendForApprovalRequest(acknowledgeMissingAttachments);
        var resp = await Api.PostAsync<AsnDetailDto, SendForApprovalRequest>($"api/asns/{Id}/send-for-approval", body);

        // (1) Success — now PendingApproval.
        if (resp?.Success == true && resp.Data != null)
        {
            showAttachConfirm = false;
            detail = resp.Data;
            attachments.Clear();
            attachments.AddRange(resp.Data.Attachments);
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Sent for approval", Detail = "The buyer will review and confirm this ASN. You can upload the shipping documents once it is confirmed." });
            await Reload();   // re-render in the locked/read-only PendingApproval view
            return;
        }

        // (2) Blocking error — PO gate, wrong state, or a supplier that needs no confirmation at all.
        submitError = resp?.Errors?.FirstOrDefault()
            ?? "Could not send for approval (the ASN may no longer be Draft/Rejected).";
    }

    // ---- R14 Post — carries BOTH two-steps: the Warning-attachment confirm and the §6.5 PO gate override. ----
    private async Task PostAsnAsync(bool acknowledgeMissingAttachments, string? overrideReason)
    {
        var body = new PostAsnRequest(acknowledgeMissingAttachments,
            string.IsNullOrWhiteSpace(overrideReason) ? null : overrideReason.Trim());
        var resp = await Api.PostAsync<AsnDetailDto, PostAsnRequest>($"api/asns/{Id}/post", body);

        // (1) Success — Submitted, dispatched to the ERP, shipping date stamped.
        if (resp?.Success == true && resp.Data != null)
        {
            showAttachConfirm = false;
            showGateOverride = false;
            detail = resp.Data;
            attachments.Clear();
            attachments.AddRange(resp.Data.Attachments);
            Notif.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "ASN posted",
                Detail = resp.Data.PostedAt is { } p
                    ? $"Sent to the ERP. Shipping date recorded as {p:dd MMM yyyy}."
                    : "Sent to the ERP.",
            });
            await Reload();   // re-render read-only (Submitted)
            return;
        }

        // (2) Warning attachments missing — 200 ConfirmationRequired, nothing committed.
        if (resp?.ConfirmationRequired == true)
        {
            attachConfirmMessage = string.IsNullOrEmpty(resp.ConfirmationMessage)
                ? "One or more required attachments were not uploaded, do you wish to proceed?"
                : resp.ConfirmationMessage!;
            attachMissing = resp.MissingAttachments ?? new();
            confirmingPost = true;
            showAttachConfirm = true;
            return;
        }

        // (3) PO confirmation gate — offer the §6.5 override to a caller who holds PurchaseOrder.OverrideGate.
        var err = resp?.Errors?.FirstOrDefault();
        if (IsGateBlock(err)) { gateOverrideForPost = true; OpenGateOverride(err!); return; }

        // (4) Blocking error — mandatory attachment, missing refs, over-ship, wrong state.
        submitError = err ?? "Could not post the ASN (a mandatory attachment or shipment reference may be missing).";
    }

    // The PO confirmation-gate override dialog fires on CREATE and — R14 — on POST, which is where the submit-time
    // gate now lives. gateOverrideForPost records which one so ConfirmGateOverride retries the right call.
    private void OpenGateOverride(string message)
    {
        gateBlockMessage = message;
        gateOverrideReason = string.Empty;
        gateOverrideError = string.Empty;
        showAttachConfirm = false;
        showGateOverride = true;
    }

    private async Task ConfirmGateOverride()
    {
        if (string.IsNullOrWhiteSpace(gateOverrideReason)) { gateOverrideError = "A reason is required to override the gate."; return; }
        busy = true; gateOverrideError = string.Empty; submitError = string.Empty;
        // R14 — two paths can reach the gate: CREATE (§6.5) and POST (the submit-time gate, moved here from the
        // buyer's Approve). Retry whichever one raised it.
        if (gateOverrideForPost)
        {
            await PostAsnAsync(acknowledgeMissingAttachments: false, overrideReason: gateOverrideReason);
        }
        else
        {
            var lineReqs = BuildLineRequests();
            await CreateDraftAsync(lineReqs, gateOverrideReason);
        }
        busy = false;
    }

    // Re-send acknowledging the missing Warning attachments (§13.6 two-step).
    // R14 — only the Post path can raise this now, but the flag keeps the dialog honest if that ever changes.
    private async Task ConfirmSubmitWithMissingAttachments()
    {
        busy = true; submitError = string.Empty;
        if (confirmingPost)
            await PostAsnAsync(acknowledgeMissingAttachments: true, overrideReason: null);
        else
            await SendForApprovalAsync(acknowledgeMissingAttachments: true);
        busy = false;
    }

    // ============================ R5 (§10.2) buyer Approve / Reject ============================
    private void OpenApproveDialog() { approveError = string.Empty; showApprove = true; }
    private void OpenRejectDialog() { rejectReason = string.Empty; rejectError = string.Empty; showReject = true; }

    // Approve runs the SUBMIT path server-side: the over-ship atomic guard consumes balance, the ASN flips to
    // Submitted and a draft invoice is created. If the balance was lost after approval (UC-AP-05) Submit fails and the
    // ASN stays PendingApproval — we surface that message in the dialog.
    private async Task DoApprove()
    {
        busy = true; approveError = string.Empty;
        var resp = await Api.PostAsync<AsnDetailDto, ApproveAsnRequest>($"api/asns/{Id}/approve", new ApproveAsnRequest());
        if (resp?.Success == true && resp.Data != null)
        {
            showApprove = false;
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "ASN approved", Detail = resp.Data.DraftInvoiceId.HasValue ? "The shipment was submitted and a draft invoice created." : "The shipment was submitted." });
            await Reload();
        }
        else
        {
            approveError = resp?.Errors?.FirstOrDefault() ?? "Could not approve (the shipment balance may have changed, or you are not a mapped buyer for this ASN).";
        }
        busy = false;
    }

    // Reject needs a mandatory reason; no balance was consumed so there is no reversal. The ASN returns to Rejected and
    // the supplier is notified (best-effort, server-side).
    private async Task DoReject()
    {
        if (string.IsNullOrWhiteSpace(rejectReason)) { rejectError = "A reason is required to reject."; return; }
        busy = true; rejectError = string.Empty;
        var resp = await Api.PostAsync<AsnDetailDto, RejectAsnRequest>($"api/asns/{Id}/reject", new RejectAsnRequest(rejectReason.Trim()));
        if (resp?.Success == true)
        {
            showReject = false;
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "ASN rejected", Detail = "The supplier can edit and re-send it for approval." });
            await Reload();
        }
        else
        {
            rejectError = resp?.Errors?.FirstOrDefault() ?? "Could not reject (it may no longer be PendingApproval, or you are not a mapped buyer).";
        }
        busy = false;
    }

    // ---- Cancel ----
    private void OpenCancelDialog() { dialogError = string.Empty; showCancel = true; }

    private async Task DoCancel()
    {
        busy = true; dialogError = string.Empty;
        var resp = await Api.PostAsync<object>($"api/asns/{Id}/cancel", new { });
        if (resp?.Success == true) { Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "ASN cancelled" }); showCancel = false; await Reload(); }
        else { dialogError = resp?.Errors?.FirstOrDefault() ?? "Could not cancel (it may already be Cancelled)."; }
        busy = false;
    }

    // R5 (§13) — attachment upload/list/remove moved into the reusable AttachmentPanel (Components/Shared).
    // OnPanelChanged (above) keeps the page's review-summary count in sync; the panel handles the rest.

    // R4 (2026-06-26) — §7.3 / §5.3 / DI-04: render the nominal balance + the over-ship allowance SEPARATELY, plus
    // the "qty reduced below shipped" exception flag. Shared shape for the wizard (LineRow) and the locked view
    // (AsnLineDto) via the two thin wrappers below.
    private static RenderFragment RenderBalance(decimal balance, decimal overShipAllowance, bool overShippedReduced) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style", "display:flex;flex-direction:column;gap:2px;font-family:Inter,monospace;");

        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, $"Balance {balance.ToString("0.###")}");
        builder.CloseElement();

        if (overShipAllowance - balance > 0)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "font-size:10.5px;color:var(--mer-ink-500);");
            builder.AddContent(seq++, $"over-ship allowance up to {overShipAllowance.ToString("0.###")}");
            builder.CloseElement();
        }

        if (overShippedReduced)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "tlg-status tlg-status--danger");
            builder.AddAttribute(seq++, "title", "Order qty was revised below the quantity already shipped");
            builder.AddAttribute(seq++, "style", "font-family:'Plus Jakarta Sans',sans-serif;width:fit-content;margin-top:2px;");
            builder.AddContent(seq++, "qty reduced below shipped");
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment BalanceCell(LineRow l) => RenderBalance(l.Balance, l.OverShipAllowance, l.IsOverShippedQtyReduced);
    // AsnLineDto carries no IsOverShippedQtyReduced (it's a PO-line concept) — pass false in the locked view.
    private RenderFragment DetailBalanceCell(AsnLineDto l) => RenderBalance(l.Balance, l.OverShipAllowance, false);

    private void BackToList() => NavMgr.NavigateToRoute("/asns");

    private string StatusClass(string status) => status switch
    {
        // R14 — Approved reads as a positive milestone (the buyer confirmed), distinct from the in-flight
        // "waiting on someone" states; it still needs the supplier's Post to become Submitted.
        "Delivered" or "Approved" => "tlg-status--active",
        // R5 (§10.1) — PendingApproval sits between Draft and Approved; treated like the other in-flight states.
        "Submitted" or "InTransit" or "PendingApproval" => "tlg-status--pending",
        "Cancelled" or "Rejected" => "tlg-status--danger",
        _ => "tlg-status--info"
    };

    // Build the line request set from the grid, mapping captured serials/lots onto each line. Only the
    // collection matching the line's type is populated (serialized XOR lot-controlled); the other stays null.
    private List<CreateAsnLineRequest> BuildLineRequests() =>
        lines.Where(l => l.ShippedQty > 0).Select(l =>
        {
            List<AsnLineSerialInput>? serials = null;
            List<AsnLineLotInput>? lots = null;
            if (l.IsSerialized)
                serials = l.Serials.Where(s => !string.IsNullOrWhiteSpace(s.Serial))
                    .Select(s => new AsnLineSerialInput(s.Serial.Trim(), s.Expiry)).ToList();
            else if (l.IsLotControlled)
                lots = l.Lots.Where(x => !string.IsNullOrWhiteSpace(x.LotNo) && (x.Qty ?? 0) > 0)
                    .Select(x => new AsnLineLotInput(x.LotNo.Trim(), x.Qty ?? 0, x.ExpiryDate)).ToList();
            // R15 — carry the schedule back-link so create AND update preserve provenance (null for legacy lines).
            return new CreateAsnLineRequest(l.PurchaseOrderLineId, l.ShippedQty, l.BatchNumber, l.ExpiryDate, serials, lots, l.DeliveryScheduleId);
        }).ToList();

    // ---- Serial / lot capture helpers (R4 2026-06-23) ----
    // Don't render thousands of textboxes for huge qty: render up to this many; the paste box still fills the rest.
    private const int SerialBoxCap = 200;

    // The step-2 capture sections render only for VALID shipped lines — qty within the over-ship allowance. An
    // over-shipped line generates NO serial/lot boxes (capturing N serials against an invalid qty makes no sense);
    // it shows the red border + over-ship dialog, and NextStep blocks advancing until the qty is corrected.
    private List<LineRow> SerialLines => lines.Where(l => l.IsSerialized && l.ShippedQty > 0 && !OverAllowance(l)).ToList();
    private List<LineRow> LotLines => lines.Where(l => l.IsLotControlled && l.ShippedQty > 0 && !OverAllowance(l)).ToList();

    // Grow the per-line serial slot list to N so the indexed @bind targets exist. New rows inherit the line's bulk
    // expiry (so "set expiry for all" then grow, or grow then "apply to all", both land the shared date).
    private static void EnsureSerialSlots(LineRow line, int need)
    {
        while (line.Serials.Count < need) line.Serials.Add(new SerialRow { Expiry = line._bulkExpiry });
        // Trim trailing extras only if the user reduced ShippedQty (keep what fits N).
        if (line.Serials.Count > need) line.Serials.RemoveRange(need, line.Serials.Count - need);
    }

    // R4 (2026-06-30) — bulk expiry: copy the line's _bulkExpiry onto every serial row (overwrites per-row edits —
    // the common case is one shared expiry). "Clear" nulls them all.
    private static void ApplyBulkExpiry(LineRow line)
    {
        EnsureSerialSlots(line, (int)line.ShippedQty);
        foreach (var s in line.Serials) s.Expiry = line._bulkExpiry;
    }

    private static void ClearExpiries(LineRow line)
    {
        line._bulkExpiry = null;
        foreach (var s in line.Serials) s.Expiry = null;
    }

    private static bool DuplicateSerial(LineRow line, int idx)
    {
        var v = line.Serials[idx].Serial?.Trim();
        if (string.IsNullOrEmpty(v)) return false;
        for (int j = 0; j < line.Serials.Count; j++)
            if (j != idx && string.Equals(line.Serials[j].Serial?.Trim(), v, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private static bool DuplicateLot(LineRow line, LotRow lot)
    {
        var v = lot.LotNo?.Trim();
        if (string.IsNullOrEmpty(v)) return false;
        return line.Lots.Count(x => string.Equals(x.LotNo?.Trim(), v, StringComparison.OrdinalIgnoreCase)) > 1;
    }

    // Paste → split on newline/comma → fill exactly N boxes; extras are ignored (warned). Cleaned non-empty.
    private static void ApplyPaste(LineRow line)
    {
        var need = (int)line.ShippedQty;
        var tokens = (line._pasteBuffer ?? string.Empty)
            .Split(new[] { '\n', '\r', ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        EnsureSerialSlots(line, need);
        var take = Math.Min(tokens.Count, need);
        for (int i = 0; i < take; i++) line.Serials[i].Serial = tokens[i];
        line._pasteWarn = tokens.Count > need ? $"{tokens.Count - need} extra serial(s) ignored (need {need})." : null;
        line._pasteBuffer = string.Empty;
    }

    // A serialized line is valid when exactly N non-empty serials are captured with no case-insensitive dupes.
    private static bool SerialLineValid(LineRow line, out string message)
    {
        var need = (int)line.ShippedQty;
        var vals = line.Serials.Select(s => s.Serial?.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();
        if (vals.Count != need) { message = $"Captured {vals.Count} of {need} required serial(s)."; return false; }
        var distinct = vals.Select(s => s!.ToLowerInvariant()).Distinct().Count();
        if (distinct != vals.Count) { message = "Duplicate serial numbers on this line."; return false; }
        message = string.Empty; return true;
    }

    // A lot line is valid when Σqty == ShippedQty, every lot has a non-empty unique lotNo and a qty > 0.
    private static bool LotLineValid(LineRow line, out string message)
    {
        if (line.Lots.Count == 0) { message = "Add at least one lot."; return false; }
        if (line.Lots.Any(l => string.IsNullOrWhiteSpace(l.LotNo))) { message = "Every lot needs a lot number."; return false; }
        if (line.Lots.Any(l => (l.Qty ?? 0) <= 0)) { message = "Every lot needs a quantity greater than zero."; return false; }
        var dupes = line.Lots.GroupBy(l => l.LotNo!.Trim().ToLowerInvariant()).Any(g => g.Count() > 1);
        if (dupes) { message = "Duplicate lot numbers on this line."; return false; }
        if (line.Lots.Sum(l => l.Qty ?? 0) != line.ShippedQty) { message = $"Lot quantities must sum to {line.ShippedQty:0.###}."; return false; }
        message = string.Empty; return true;
    }

    // True only if EVERY serialized/lot line currently passes — gates Next on step 2 and the final submit.
    private bool SerialLotCaptureValid =>
        SerialLines.All(l => SerialLineValid(l, out _))
        && LotLines.All(l => LotLineValid(l, out _));

    private class LineRow
    {
        public Guid PurchaseOrderLineId { get; set; }
        public Guid PurchaseOrderId { get; set; }
        public string PoNumber { get; set; } = string.Empty;
        public int PositionNo { get; set; }
        public int? SequenceNo { get; set; }
        public string ItemCode { get; set; } = string.Empty;
        public decimal OrderQty { get; set; }
        public decimal ShippedQty { get; set; }
        public string? BatchNumber { get; set; }
        public DateTime? ExpiryDate { get; set; }

        // R15 — schedule provenance: the originating delivery schedule (null for legacy PO-picked lines), its
        // delivery date (Quantities column) and its scheduled qty (the D4 default: min(scheduled, balance)).
        public Guid? DeliveryScheduleId { get; set; }
        public DateTime? DeliveryDate { get; set; }
        public decimal ScheduledQty { get; set; }

        // R4 (2026-06-23) — Serial/Lot capture. Item flags (serialized XOR lot-controlled) drive which capture
        // section the line gets; Serials/Lots hold the captured values. ShippedQty is the required count/Σ.
        public bool IsSerialized { get; set; }
        public bool IsLotControlled { get; set; }
        public List<SerialRow> Serials { get; set; } = new();
        public List<LotRow> Lots { get; set; } = new();
        // R4 (2026-06-30) — bulk "expiry for all units" picker value (transient; copied onto each SerialRow.Expiry).
        public DateOnly? _bulkExpiry { get; set; }

        // R4 (2026-06-26) — §7.3 / §5.3 / DI-04: the PO-line ship-tracking figures shown on the ASN wizard. Balance
        // is nominal (MAX(0, orderQty − shippedQtyToDate)); OverShipAllowance is the tolerance-adjusted ceiling
        // headroom — shown SEPARATELY. IsOverShippedQtyReduced flags a line whose orderQty was revised below the
        // already-shipped cumulative (UC-ASN-10).
        public decimal ShippedQtyToDate { get; set; }
        public decimal Balance { get; set; }
        public decimal OverShipAllowance { get; set; }
        public bool IsOverShippedQtyReduced { get; set; }

        // Transient UI state (not persisted): the paste textarea buffer + the last paste warning for this line.
        public string? _pasteBuffer { get; set; }
        public string? _pasteWarn { get; set; }
    }

    // One captured serial row (serialized line): one physical unit = one serial + optional expiry. (R4 2026-06-30)
    private class SerialRow
    {
        public string Serial { get; set; } = string.Empty;
        public DateOnly? Expiry { get; set; }
    }

    // One captured lot row (lot-controlled line): lotNo + qty + optional expiry.
    private class LotRow
    {
        public string LotNo { get; set; } = string.Empty;
        public decimal? Qty { get; set; }
        public DateOnly? ExpiryDate { get; set; }
    }
}
