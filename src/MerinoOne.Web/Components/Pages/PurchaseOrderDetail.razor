@page "/purchase-orders/{Id:guid}"
@inject ApiClient Api
@inject TokenAccessor Token
@inject NavigationManager Nav
@inject NotificationService Notif

<PageTitle>@detail?.PoNumber</PageTitle>

@* Design 1a — PO detail header compaction. A <style> block rather than this page's usual inline styles: the
   layout needs sibling selectors, :hover, :focus-within and a stacking media query. Prefixed podt- (PO detail)
   so nothing can collide with merino.css. *@
<style>
    .podt-head { display:flex; align-items:center; gap:8px; min-height:46px; padding:4px 0 8px;
                 border-bottom:1px solid var(--mer-line); flex-wrap:wrap; }
    .podt-back { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px;
                 border-radius:6px; color:var(--mer-ink-600); text-decoration:none; flex:none; }
    .podt-back:hover { background:var(--mer-ink-100); color:var(--mer-ink-900); }
    .podt-title { margin:0; font:800 18px/1 'Plus Jakarta Sans', sans-serif; color:var(--mer-blue-darker);
                  letter-spacing:-.01em; }
    .podt-actions { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }

    .podt-tabs { display:flex; align-items:center; gap:0; height:36px;
                 border-bottom:1px solid var(--mer-line); }
    .podt-tab { padding:0 14px; height:36px; background:transparent; border:0; border-bottom:2px solid transparent;
                cursor:pointer; font:600 13px/1 'Plus Jakarta Sans', sans-serif; color:var(--mer-ink-700); }
    .podt-tab:hover { color:var(--mer-blue); }
    .podt-tab--on { border-bottom-color:var(--mer-blue); color:var(--mer-blue); }
    .podt-tabs__sub { font:400 12px/1 'Plus Jakarta Sans', sans-serif; color:var(--mer-ink-500);
                      white-space:nowrap; overflow:hidden; text-overflow:ellipsis; padding-left:12px; }

    .podt-summary { background:var(--mer-surface); border:1px solid var(--mer-line); border-top:0;
                    border-radius:0 0 8px 8px; }
    .podt-summary__row { display:flex; align-items:center; gap:12px; min-height:42px; padding:4px 14px; }
    .podt-summary__right { display:flex; align-items:center; gap:12px; flex:none; padding-left:14px; }
    .podt-cells { display:flex; align-items:center; flex:1; min-width:0; overflow:hidden; }
    .podt-cell { display:flex; flex-direction:column; gap:1px; padding:0 14px; min-width:0; }
    .podt-cell:first-child { padding-left:0; }
    .podt-cell--grow { flex:1; min-width:0; }
    .podt-cell--end { align-items:flex-end; padding:0; }
    .podt-cell__label { font:600 9.5px/1 'Plus Jakarta Sans', sans-serif; letter-spacing:.06em;
                        text-transform:uppercase; color:var(--mer-ink-400); }
    .podt-cell__value { font:500 12px/1.25 'Plus Jakarta Sans', sans-serif; color:var(--mer-ink-900); }
    .podt-div { width:1px; height:22px; background:var(--mer-line-soft); flex:none; }
    .podt-muted { color:var(--mer-ink-500); font-weight:400; }
    .podt-mono { font-family:Inter, ui-monospace, monospace; }
    .podt-ellipsis { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .podt-total { font:800 13px/1.2 Inter, ui-monospace, monospace; font-variant-numeric:tabular-nums;
                  color:var(--mer-blue-darker); }
    .podt-more { height:28px; padding:0 10px; border-radius:6px; border:1px solid var(--mer-ink-300);
                 background:var(--mer-surface); color:var(--mer-ink-800); cursor:pointer;
                 font:600 12px/1 'Plus Jakarta Sans', sans-serif; display:inline-flex; align-items:center; gap:5px; }
    .podt-more:hover { background:var(--mer-ink-50); border-color:var(--mer-ink-400); }
    .podt-more .material-symbols-outlined { font-size:16px; }

    .podt-meta { border-top:1px solid var(--mer-line-soft); padding:14px; background:var(--mer-ink-50);
                 display:grid; grid-template-columns:1.4fr 1fr 1fr; gap:20px; border-radius:0 0 8px 8px; }
    .podt-meta__head { font:700 11px/1 'Plus Jakarta Sans', sans-serif; text-transform:uppercase;
                       letter-spacing:.05em; color:var(--mer-ink-600); margin-bottom:8px; }
    .podt-kv { display:grid; grid-template-columns:120px 1fr; gap:5px 14px; font-size:12.5px; margin:0; }
    .podt-kv dt { color:var(--mer-ink-500); }
    .podt-kv dd { margin:0; color:var(--mer-ink-900); overflow-wrap:anywhere; }
    .podt-addr { font-size:12.5px; line-height:1.5; color:var(--mer-ink-800); }
    .podt-addr__name { font-weight:600; color:var(--mer-blue-darker); }
    .podt-notes { font-size:12.5px; color:var(--mer-ink-700); white-space:pre-wrap; }
    .podt-empty { font-size:12.5px; color:var(--mer-ink-500); margin:0; }
    .podt-reject { display:inline-block; background:var(--mer-red-50); color:var(--mer-red);
                   padding:4px 8px; border-radius:4px; }

    .podt-lines { padding:0; margin-top:12px; overflow:hidden; }
    .podt-lines__head { display:flex; align-items:center; gap:8px; min-height:38px; padding:6px 14px;
                        border-bottom:1px solid var(--mer-line); }
    .podt-lines__title { font:700 13px/1 'Plus Jakarta Sans', sans-serif; color:var(--mer-blue-darker); }
    .podt-search { display:inline-flex; align-items:center; gap:6px; height:28px; padding:0 8px;
                   border:1px solid var(--mer-ink-300); border-radius:6px; background:var(--mer-surface); }
    .podt-search:focus-within { border-color:var(--mer-blue); }
    .podt-search .material-symbols-outlined { font-size:16px; color:var(--mer-ink-400); }
    .podt-search input { border:0; outline:0; background:transparent; width:190px;
                         font:400 12px/1 'Plus Jakarta Sans', sans-serif; color:var(--mer-ink-900); }
    .podt-search__clear { cursor:pointer; }
    .podt-search__clear:hover { color:var(--mer-ink-700); }

    .podt-table { width:100%; font-size:12.5px; border-collapse:collapse; }
    /* The header row sticks to the top of the page's scroll while the 15 columns run past it. */
    .podt-table thead th { position:sticky; top:0; z-index:1; background:var(--mer-ink-50);
                           border-bottom:1px solid var(--mer-line); padding:7px 8px;
                           font:700 11px/1.4 'Plus Jakarta Sans', sans-serif; text-transform:uppercase;
                           letter-spacing:.04em; color:var(--mer-ink-800); }
    .podt-table tbody tr:hover { background:var(--mer-ink-50); }

    /* Below ~1100px the six summary cells stop fitting on one row: wrap them and drop the dividers, which
       would otherwise land mid-wrap as stray marks. The detail panel stacks at the same point. */
    @@media (max-width: 1100px) {
        .podt-cells { flex-wrap:wrap; gap:8px 0; }
        .podt-div { display:none; }
        .podt-cell:first-child { padding-left:0; }
        .podt-meta { grid-template-columns:1fr; gap:14px; }
        .podt-search input { width:130px; }
    }
</style>

@if (loading)
{
    <div class="tl-empty">Loading…</div>
}
else if (detail == null)
{
    <div class="tl-empty">Purchase order not found.</div>
}
else
{
    <div class="tl-page">
        @* ── Design 1a (claude.ai/design "Header space optimization", 2026-08-12) ────────────────────────
           The back link, title block, tabs and three stacked cards cost ~515px before the first line — 61% of
           the page region. 1a compresses them to one 46px header, a 36px tab strip and a single 42px summary
           row whose cells expand on demand, so lines start ~124px in.
           Deviations, by decision: ship-to is REPLACED by the customer address (R13 retired ship-to, which the
           mock still drew); the mock's header warehouse pill is dropped (warehouse is per LINE since R13 and a
           PO may span several, so a header pill could state something false — it stays a Lines column); the
           page keeps its natural scroll rather than pinning the shell; no column chooser. ─────────────────── *@
        <div class="podt-head">
            <a href="purchase-orders" class="podt-back" title="Back to list">
                <span class="material-symbols-outlined">chevron_left</span>
            </a>
            <h1 class="podt-title">@detail.PoNumber</h1>
            <span class="tlg-status @StatusClass(detail.PoStatus)">@detail.PoStatus</span>
            <span class="tl-count-chip">v@detail.Version</span>
            <div style="flex:1;"></div>
            <div class="podt-actions">
                @* PO response actions are shown only when the supplier is in MANUAL response mode.
                   In AUTO mode the PO is acknowledged + accepted automatically at release, so the
                   manual Ack/Accept/Reject affordances are hidden (req 3 / §0 Q8). *@
                @if (ManualResponse && Token.HasPermission("PurchaseOrder.Acknowledge") && detail.PoStatus == "Released")
                {
                    <button class="mbtn mbtn--outline" @onclick="OpenAcknowledge" disabled="@busy">
                        <span class="material-symbols-outlined">check_circle</span> Acknowledge
                    </button>
                }
                @if (ManualResponse && Token.HasPermission("PurchaseOrder.Accept") && (detail.PoStatus == "Released" || detail.PoStatus == "Acknowledged"))
                {
                    <button class="mbtn mbtn--primary-success" @onclick="OpenAccept" disabled="@busy">
                        <span class="material-symbols-outlined">task_alt</span> Accept
                    </button>
                    @* R4 (2026-06-26) — D1 / §3.4: Reject/Decline is hidden when the supplier config has AllowReject=false. *@
                    @if (detail.AllowReject)
                    {
                        <button class="mbtn mbtn--danger" @onclick="OpenReject" disabled="@busy">
                            <span class="material-symbols-outlined">cancel</span> Reject
                        </button>
                    }
                }
                @* PO Negotiation (req 1) — supplier proposes revised qty / price / delivery dates. Peer of Accept/Reject,
                   gated on the negotiate permission + an eligible status + the supplier's AllowNegotiate toggle (R4 D1).
                   Hidden once a negotiation is open (PoStatus == "Negotiation") so only "Cancel Negotiation" shows. *@
                @if (detail.AllowNegotiate && Token.HasPermission("PurchaseOrder.Negotiate") && (detail.PoStatus == "Released" || detail.PoStatus == "Acknowledged"))
                {
                    <button class="mbtn mbtn--accent" @onclick="EnterNegotiation" disabled="@busy">
                        <span class="material-symbols-outlined">handshake</span> Negotiation
                    </button>
                }
                @* While a negotiation is open the PO is locked in "Negotiation" — Ack/Accept/Reject/Negotiation
                   are all hidden (their status guards above already exclude "Negotiation"); the supplier may
                   only withdraw it (req 3 / state machine §2). *@
                @if (Token.HasPermission("PurchaseOrder.Negotiate") && detail.PoStatus == "Negotiation")
                {
                    <button class="mbtn mbtn--danger" @onclick="CancelNegotiation" disabled="@busy">
                        <span class="material-symbols-outlined">undo</span> Cancel Negotiation
                    </button>
                }
                @if (!ManualResponse && (detail.PoStatus == "Released" || detail.PoStatus == "Acknowledged"))
                {
                    <span class="tlg-status tlg-status--info" title="Supplier is in AutoAccept confirmation mode" style="align-self:center;">
                        <span class="material-symbols-outlined" style="font-size:14px;vertical-align:middle;">bolt</span> Auto accept
                    </span>
                }
                @* R4 (2026-06-26) — D2: the date-only "Approve Proposal" buyer action is retired; counter-proposals
                   now resolve through PO negotiation. *@
            </div>
        </div>

        @* The old <p class="tl-sub"> line moved here: it is orientation, not a heading, so it rides the tab
           strip's spare width instead of costing a row of its own. *@
        <div class="podt-tabs">
            <button class="podt-tab @(tab == "overview" ? "podt-tab--on" : "")" @onclick="TabOverview">Overview</button>
            <button class="podt-tab @(tab == "history" ? "podt-tab--on" : "")" @onclick="TabHistory">History</button>
            <div style="flex:1;"></div>
            <span class="podt-tabs__sub">@detail.SupplierName · @detail.PoType · @detail.PoDate.ToString("yyyy-MM-dd")</span>
        </div>

        @if (tab == "history")
        {
            @* PO-scoped history endpoint (PurchaseOrder.Read) so the supplier sees their own PO's history —
               incl. negotiation qty/delivery changes — not just admins (the generic audit API needs Settings.Read). *@
            <AuditHistoryTab EntityName="PurchaseOrder" EntityId="@Id" ApiPath="@($"api/purchase-orders/{Id}/history")" />
        }
        else
        {
        @* One summary row replacing the Order-details + Notes cards. Every fact they carried is still here:
           the frequently-scanned ones inline, the rest one click away under "All details". *@
        <div class="podt-summary">
            <div class="podt-summary__row">
                <div class="podt-cells">
                    @* R5/R13 — CustomerName + the customer BASE address are DERIVED live (PO.tenantEntityId → the
                       company + its single base CompanyAddress), display-only and reflect later edits. *@
                    <div class="podt-cell">
                        <span class="podt-cell__label">Customer</span>
                        <span class="podt-cell__value">@Dash(detail.CustomerName)</span>
                    </div>
                    <span class="podt-div"></span>
                    <div class="podt-cell">
                        <span class="podt-cell__label">Supplier</span>
                        <span class="podt-cell__value">@detail.SupplierName <span class="podt-muted">(@detail.SupplierCode)</span></span>
                    </div>
                    <span class="podt-div"></span>
                    <div class="podt-cell">
                        <span class="podt-cell__label">PO date</span>
                        <span class="podt-cell__value podt-mono">@detail.PoDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <span class="podt-div"></span>
                    <div class="podt-cell">
                        <span class="podt-cell__label">Terms</span>
                        <span class="podt-cell__value podt-muted">Pay @Dash(detail.PaymentTerms) · Del @Dash(detail.DeliveryTerms)</span>
                    </div>
                    @* The mock's Ship-to cell: ship-to was retired in R13, so this is the CUSTOMER's base address —
                       the nearest live equivalent, and the only address a PO header still has. *@
                    @if (HasCustomerAddress)
                    {
                        <span class="podt-div"></span>
                        <div class="podt-cell podt-cell--grow">
                            <span class="podt-cell__label">Customer address</span>
                            <span class="podt-cell__value podt-ellipsis" title="@CustomerAddressOneLine">@CustomerAddressOneLine</span>
                        </div>
                    }
                </div>
                <div class="podt-summary__right">
                    <div class="podt-cell podt-cell--end">
                        <span class="podt-cell__label">Total</span>
                        <span class="podt-total">@(string.IsNullOrEmpty(detail.CurrencyCode) ? "" : detail.CurrencyCode + " ")@detail.TotalAmount.ToString("0.00")</span>
                    </div>
                    <button class="podt-more" @onclick="() => metaOpen = !metaOpen">
                        All details
                        <span class="material-symbols-outlined">@(metaOpen ? "expand_less" : "expand_more")</span>
                    </button>
                </div>
            </div>

            @if (metaOpen)
            {
                <div class="podt-meta">
                    <div>
                        <div class="podt-meta__head">Order details</div>
                        <dl class="podt-kv">
                            <dt>Payment terms</dt><dd>@Dash(detail.PaymentTerms)</dd>
                            <dt>Delivery terms</dt><dd>@Dash(detail.DeliveryTerms)</dd>
                            <dt>Currency</dt><dd>@Dash(detail.CurrencyCode)</dd>
                            <dt>Acknowledged</dt><dd class="podt-mono">@(detail.AcknowledgmentAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                            <dt>Accepted</dt><dd class="podt-mono">@(detail.AcceptedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                            @if (!string.IsNullOrEmpty(detail.RejectionReason))
                            {
                                <dt>Rejection reason</dt>
                                <dd><span class="podt-reject">@detail.RejectionReason</span></dd>
                            }
                        </dl>
                    </div>
                    <div>
                        <div class="podt-meta__head">Customer address</div>
                        @if (HasCustomerAddress)
                        {
                            <div class="podt-addr">
                                @if (!string.IsNullOrWhiteSpace(detail.CustomerAddressName))
                                {
                                    <div class="podt-addr__name">@detail.CustomerAddressName</div>
                                }
                                @foreach (var part in CustomerAddressLines)
                                {
                                    <div>@part</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="podt-empty">No address on the customer company.</div>
                        }
                    </div>
                    <div>
                        <div class="podt-meta__head">Notes</div>
                        <div class="@(string.IsNullOrEmpty(detail.Notes) ? "podt-empty" : "podt-notes")">@(string.IsNullOrEmpty(detail.Notes) ? "No notes." : detail.Notes)</div>
                    </div>
                </div>
            }
        </div>

        @* ---------------- Negotiation edit bar (req 3) ---------------- *@
        @if (negotiating)
        {
            <div class="rz-card" style="padding:16px 20px;margin-top:16px;border:1px solid var(--mer-blue);background:var(--mer-blue-50);">
                <div style="display:flex;align-items:flex-start;gap:10px;">
                    <span class="material-symbols-outlined" style="font-size:20px;color:var(--mer-blue);">handshake</span>
                    <div style="flex:1;">
                        <div style="font-size:13px;font-weight:700;color:var(--mer-blue-darker);">Negotiation mode</div>
                        <p style="font-size:12px;color:var(--mer-ink-700);margin:2px 0 10px;">Edit the <b>Qty</b> and <b>Delivery Date</b> on the lines you want to renegotiate. Only changed lines are submitted.</p>
                        <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);display:block;margin-bottom:4px;">Notes for the buyer (optional)</label>
                        <textarea class="rz-textbox" rows="2" style="width:100%;max-width:560px;padding:8px 10px;font-family:inherit;" @bind="negotiationNotes"></textarea>
                        @if (!string.IsNullOrEmpty(negotiationError))
                        {
                            <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:8px;max-width:560px;">@negotiationError</div>
                        }
                    </div>
                    <div style="display:flex;gap:8px;flex-shrink:0;">
                        <button class="rz-button" style="padding:8px 14px;border-radius:6px;border:1px solid var(--mer-ink-300);background:var(--mer-surface);color:var(--mer-ink-700);cursor:pointer;" @onclick="CancelEdit" disabled="@busy">Cancel</button>
                        <button class="rz-button rz-primary" style="padding:8px 14px;border-radius:6px;border:0;color:#fff;cursor:pointer;" @onclick="SubmitNegotiation" disabled="@busy">
                            <span class="material-symbols-outlined" style="font-size:16px;vertical-align:middle;">send</span> @(busy ? "Submitting…" : "Submit Negotiation")
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="rz-card podt-lines">
            @* 1a's Lines header: title + count pill + a search box. The mock's column chooser is not built. *@
            <div class="podt-lines__head">
                <span class="podt-lines__title">Lines</span>
                <span class="tl-count-chip">@detail.Lines.Count</span>
                @if (detail.Lines.Count > 0)
                {
                    <div style="flex:1;"></div>
                    <label class="podt-search">
                        <span class="material-symbols-outlined">search</span>
                        <input placeholder="Search item or description…" @bind="lineSearch" @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(lineSearch))
                        {
                            <span class="material-symbols-outlined podt-search__clear" title="Clear" @onclick="() => lineSearch = string.Empty">close</span>
                        }
                    </label>
                }
            </div>
            @if (detail.Lines.Count == 0)
            {
                <p class="podt-empty" style="padding:16px 18px;">No lines on this PO.</p>
            }
            else if (VisibleLines.Count == 0)
            {
                <p class="podt-empty" style="padding:16px 18px;">No line matches “@lineSearch”.</p>
            }
            else
            {
                <table class="podt-table">
                    <thead>
                        <tr style="border-bottom:1px solid var(--mer-line);">
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Pos</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Seq</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Item</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Description</th>
                            <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Qty</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Unit</th>
                            <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Price Unit</th>
                            <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Net Amount</th>
                            <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Disc %</th>
                            <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Disc Amt</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Tax</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Delivery</th>
                            <th style="text-align:right;padding:6px 4px;color:var(--mer-ink-700);">Shipped</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Balance / allowance</th>
                            <th style="text-align:left;padding:6px 4px;color:var(--mer-ink-700);">Warehouse</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ln in VisibleLines)
                    {
                        var line = ln;
                        <tr style="border-bottom:1px solid var(--mer-line-soft);">
                            <td style="padding:6px 4px;font-family:Inter,monospace;">@line.PositionNo</td>
                            <td style="padding:6px 4px;font-family:Inter,monospace;">@line.SequenceNo</td>
                            <td style="padding:6px 4px;font-family:Inter,monospace;">@line.ItemCode</td>
                            <td style="padding:6px 4px;">@line.ItemDescription</td>
                            @if (negotiating && edits.TryGetValue(line.Id, out var edit))
                            {
                                @* Editable Qty + Price Unit (req 3 + price addendum) — all other columns stay read-only. *@
                                <td style="padding:6px 4px;text-align:right;">
                                    <input type="number" step="0.001" min="0" class="rz-textbox" style="width:90px;padding:4px 6px;text-align:right;font-family:Inter,monospace;" @bind="edit.Qty" />
                                </td>
                                <td style="padding:6px 4px;">@line.OrderUnit</td>
                                <td style="padding:6px 4px;text-align:right;">
                                    <input type="number" step="0.01" min="0" class="rz-textbox" style="width:100px;padding:4px 6px;text-align:right;font-family:Inter,monospace;" @bind="edit.Price" />
                                </td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@line.NetAmount.ToString("0.00")</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@(line.DiscountPct == 0 ? "—" : line.DiscountPct.ToString("0.##"))</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@(line.DiscountAmount == 0 ? "—" : line.DiscountAmount.ToString("0.00"))</td>
                                <td style="padding:6px 4px;" title="@line.TaxCode">@(string.IsNullOrEmpty(line.TaxDescription) ? (string.IsNullOrEmpty(line.TaxCode) ? "—" : line.TaxCode) : line.TaxDescription)</td>
                                @* Editable Delivery Date (req 3). *@
                                <td style="padding:6px 4px;">
                                    <input type="date" class="rz-textbox" style="padding:4px 6px;font-family:Inter,monospace;" @bind="edit.DeliveryDate" />
                                </td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@line.ShippedQtyToDate.ToString("0.###")</td>
                                <td style="padding:6px 4px;">@BalanceCell(line)</td>
                                <td style="padding:6px 4px;">@WarehouseCell(line)</td>
                            }
                            else
                            {
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@line.OrderQty.ToString("0.###")</td>
                                <td style="padding:6px 4px;">@line.OrderUnit</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@line.PriceUnit.ToString("0.00")</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@line.NetAmount.ToString("0.00")</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@(line.DiscountPct == 0 ? "—" : line.DiscountPct.ToString("0.##"))</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@(line.DiscountAmount == 0 ? "—" : line.DiscountAmount.ToString("0.00"))</td>
                                <td style="padding:6px 4px;" title="@line.TaxCode">@(string.IsNullOrEmpty(line.TaxDescription) ? (string.IsNullOrEmpty(line.TaxCode) ? "—" : line.TaxCode) : line.TaxDescription)</td>
                                <td style="padding:6px 4px;font-family:Inter,monospace;">@(line.DeliveryDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td style="padding:6px 4px;text-align:right;font-family:Inter,monospace;">@line.ShippedQtyToDate.ToString("0.###")</td>
                                <td style="padding:6px 4px;">@BalanceCell(line)</td>
                                <td style="padding:6px 4px;">@WarehouseCell(line)</td>
                            }
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        @* 1a's footer bar. The total is the PO's, NOT the sum of what is on screen — so when a
                           search narrows the table the left note says how many rows are showing, or the figure
                           would read as the total of the visible ones. *@
                        @* Column budget (15): 1 Pos · 2 Seq · 3 Item · 4 Description · 5 Qty · 6 Unit · 7 Price Unit ·
                           8 Net Amount · 9 Disc % · 10 Disc Amt · 11 Tax · 12 Delivery · 13 Shipped · 14 Balance ·
                           15 Warehouse. The figure must land in column 8 so it reads as a sum of Net Amount, which
                           is what it is — so the note takes 1-6, the label sits in 7, and 9-15 are filled by one
                           spanning cell. Change any span here and re-count, or the total drifts under Disc %. *@
                        <tr style="border-top:2px solid var(--mer-line);font-weight:700;">
                            <td colspan="6" style="padding:8px 4px;text-align:left;color:var(--mer-ink-500);font-weight:600;">
                                @if (VisibleLines.Count != detail.Lines.Count)
                                {
                                    <text>Showing @VisibleLines.Count of @detail.Lines.Count lines · total below is for the whole PO</text>
                                }
                            </td>
                            <td style="padding:8px 4px;text-align:right;color:var(--mer-ink-700);white-space:nowrap;">Total@(string.IsNullOrEmpty(detail.CurrencyCode) ? "" : " (" + detail.CurrencyCode + ")")</td>
                            <td style="padding:8px 4px;text-align:right;font-family:Inter,monospace;color:var(--mer-blue-darker);">@detail.TotalAmount.ToString("0.00")</td>
                            <td colspan="7"></td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
        }
    </div>

    @if (showAcknowledge)
    {
        <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
            <div class="merino-dialog" data-variant="info" style="width:540px;">
                <div class="merino-dialog__accent"></div>
                <header class="merino-dialog__header">
                    <div class="merino-dialog__icon merino-dialog__icon--info"><span class="material-symbols-outlined">check_circle</span></div>
                    <div class="merino-dialog__head-text">
                        <div class="merino-dialog__eyebrow">Purchase Order</div>
                        <h2 class="merino-dialog__title">Acknowledge @detail.PoNumber?</h2>
                        <p class="merino-dialog__subtitle">Confirms you've seen the PO. Add any notes for the buyer.</p>
                    </div>
                    <button class="merino-dialog__close" @onclick="() => showAcknowledge = false"><span class="material-symbols-outlined">close</span></button>
                </header>
                <div class="merino-dialog__body">
                    <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Notes (optional)</label>
                    <textarea class="rz-textbox" rows="3" style="width:100%;padding:8px 10px;font-family:inherit;" @bind="dialogNotes"></textarea>
                    @if (!string.IsNullOrEmpty(dialogError)) { <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:8px;">@dialogError</div> }
                </div>
                <footer class="merino-dialog__footer">
                    <div class="merino-dialog__actions">
                        <button class="merino-dialog__btn" data-intent="ghost" @onclick="() => showAcknowledge = false">Cancel</button>
                        <button class="merino-dialog__btn" data-intent="primary" @onclick="DoAcknowledge" disabled="@busy">@(busy ? "Working…" : "Acknowledge")</button>
                    </div>
                </footer>
            </div>
        </div>
    }

    @if (showAccept)
    {
        <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
            <div class="merino-dialog" data-variant="success" style="width:540px;">
                <div class="merino-dialog__accent"></div>
                <header class="merino-dialog__header">
                    <div class="merino-dialog__icon merino-dialog__icon--success"><span class="material-symbols-outlined">task_alt</span></div>
                    <div class="merino-dialog__head-text">
                        <div class="merino-dialog__eyebrow">Purchase Order</div>
                        <h2 class="merino-dialog__title">Accept @detail.PoNumber</h2>
                        <p class="merino-dialog__subtitle">Accept the PO as ordered. To counter-propose qty / price / dates, use Negotiation instead.</p>
                    </div>
                    <button class="merino-dialog__close" @onclick="() => showAccept = false"><span class="material-symbols-outlined">close</span></button>
                </header>
                <div class="merino-dialog__body">
                    @* R4 (2026-06-26) — D2: Accept is accept-only now. To counter-propose qty/price/date the supplier
                       uses PO negotiation (the "Negotiation" action), not an accept-with-alternate-date. *@
                    <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);margin-top:8px;display:block;">Notes (optional)</label>
                    <textarea class="rz-textbox" rows="3" style="width:100%;padding:8px 10px;font-family:inherit;" @bind="dialogNotes"></textarea>
                    @* Confirmation step (req 2) — the supplier must explicitly confirm before the Accept POSTs.
                       This commits to the PO terms and cannot be undone. *@
                    <label style="display:flex;align-items:flex-start;gap:8px;font-size:12.5px;color:var(--mer-ink-700);margin-top:12px;background:var(--mer-amber-50, var(--mer-blue-50));padding:10px 12px;border-radius:6px;">
                        <input type="checkbox" checked="@acceptConfirmed" @onchange="e => acceptConfirmed = (bool)(e.Value ?? false)" style="margin-top:2px;" />
                        <span>I confirm I am accepting <b>@detail.PoNumber</b> as ordered. This commits the order and cannot be undone.</span>
                    </label>
                    @if (!string.IsNullOrEmpty(dialogError)) { <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:8px;">@dialogError</div> }
                </div>
                <footer class="merino-dialog__footer">
                    <div class="merino-dialog__actions">
                        <button class="merino-dialog__btn" data-intent="ghost" @onclick="() => showAccept = false">Cancel</button>
                        <button class="merino-dialog__btn" data-intent="primary" @onclick="DoAccept" disabled="@(busy || !acceptConfirmed)">@(busy ? "Working…" : "Confirm Accept")</button>
                    </div>
                </footer>
            </div>
        </div>
    }

    @if (showReject)
    {
        <div style="position:fixed;inset:0;background:var(--mer-modal-backdrop);display:flex;align-items:center;justify-content:center;z-index:1000;">
            <div class="merino-dialog" data-variant="danger" style="width:540px;">
                <div class="merino-dialog__accent"></div>
                <header class="merino-dialog__header">
                    <div class="merino-dialog__icon merino-dialog__icon--danger"><span class="material-symbols-outlined">cancel</span></div>
                    <div class="merino-dialog__head-text">
                        <div class="merino-dialog__eyebrow">Purchase Order</div>
                        <h2 class="merino-dialog__title">Reject @detail.PoNumber</h2>
                        <p class="merino-dialog__subtitle">Provide a reason for rejection.</p>
                    </div>
                    <button class="merino-dialog__close" @onclick="() => showReject = false"><span class="material-symbols-outlined">close</span></button>
                </header>
                <div class="merino-dialog__body">
                    <label style="font-size:12px;font-weight:600;color:var(--mer-ink-700);">Reason (required)</label>
                    <textarea class="rz-textbox" rows="4" style="width:100%;padding:8px 10px;font-family:inherit;" @bind="rejectionReason"></textarea>
                    @if (!string.IsNullOrEmpty(dialogError)) { <div style="background:var(--mer-red-50);color:var(--mer-red);padding:8px 12px;border-radius:6px;font-size:12px;margin-top:8px;">@dialogError</div> }
                </div>
                <footer class="merino-dialog__footer">
                    <div class="merino-dialog__actions">
                        <button class="merino-dialog__btn" data-intent="ghost" @onclick="() => showReject = false">Cancel</button>
                        <button class="merino-dialog__btn" data-intent="danger" @onclick="DoReject" disabled="@busy">@(busy ? "Working…" : "Reject")</button>
                    </div>
                </footer>
            </div>
        </div>
    }

    @* R4 (2026-06-26) — D2: the date-only "Approve proposed date" buyer dialog is retired (PO negotiation replaces it). *@
}

@code {
    [Parameter] public Guid Id { get; set; }
    private PurchaseOrderDetailDto? detail;
    private bool loading = true;
    private bool busy = false;
    private string tab = "overview";

    // ===================== Design 1a — compacted header (2026-08-12) =====================

    /// <summary>"All details" disclosure under the summary row. Closed by default — that is the whole point of
    /// the compaction; the facts behind it are the ones nobody scans on every visit.</summary>
    private bool metaOpen;

    /// <summary>Client-side line filter (1a's Lines-header search). Filters only what is already loaded.</summary>
    private string lineSearch = string.Empty;

    private static string Dash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    /// <summary>Lines in display order, narrowed by the search box. Sort is unchanged: position then sequence.</summary>
    private List<PurchaseOrderLineDto> VisibleLines
    {
        get
        {
            var q = (detail?.Lines ?? new List<PurchaseOrderLineDto>()).AsEnumerable();
            if (!string.IsNullOrWhiteSpace(lineSearch))
            {
                var t = lineSearch.Trim();
                q = q.Where(l => (l.ItemCode?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
                                 || (l.ItemDescription?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
                                 || l.PositionNo.ToString().Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            return q.OrderBy(l => l.PositionNo).ThenBy(l => l.SequenceNo).ToList();
        }
    }

    // The customer's BASE address (R13). It fills the slot the mock drew as "Ship-to" — ship-to was retired, and
    // this is the only address a PO header still carries.
    private bool HasCustomerAddress =>
        !string.IsNullOrWhiteSpace(detail?.CustomerAddressName)
        || !string.IsNullOrWhiteSpace(detail?.CustomerAddressLine1)
        || !string.IsNullOrWhiteSpace(detail?.CustomerAddressCity)
        || !string.IsNullOrWhiteSpace(detail?.CustomerAddressCountry);

    /// <summary>Address body lines for the expanded panel — name is rendered separately, above these.</summary>
    private IEnumerable<string> CustomerAddressLines
    {
        get
        {
            if (detail is null) yield break;
            if (!string.IsNullOrWhiteSpace(detail.CustomerAddressLine1)) yield return detail.CustomerAddressLine1!;
            if (!string.IsNullOrWhiteSpace(detail.CustomerAddressLine2)) yield return detail.CustomerAddressLine2!;
            var locality = string.Join(" ",
                new[] { Join(", ", detail.CustomerAddressCity, detail.CustomerAddressState), detail.CustomerAddressPincode }
                    .Where(x => !string.IsNullOrWhiteSpace(x)));
            if (!string.IsNullOrWhiteSpace(locality)) yield return locality;
            if (!string.IsNullOrWhiteSpace(detail.CustomerAddressCountry)) yield return detail.CustomerAddressCountry!;
        }
    }

    /// <summary>The one-line form for the 42px summary cell (name + city + country), ellipsised by CSS.</summary>
    private string CustomerAddressOneLine =>
        Join(", ", detail?.CustomerAddressName, detail?.CustomerAddressCity, detail?.CustomerAddressCountry) is { Length: > 0 } s
            ? s
            : "—";

    private static string Join(string sep, params string?[] parts) =>
        string.Join(sep, parts.Where(p => !string.IsNullOrWhiteSpace(p)));

    // R4 (2026-06-26) — D1: the supplier's PO-confirmation mode travels on PurchaseOrderDetailDto.PoResponseMode
    // (joined from Supplier.PoConfirmationMode by the API; field name kept stable). "Manual" here means NOT
    // AutoAccept (AcceptToShip / AcknowledgeToShip both require a manual Ack/Accept/Reject affordance). Defaults to
    // the non-AutoAccept branch so a missing/empty value never hides the manual actions.
    private bool ManualResponse => !string.Equals(detail?.PoResponseMode, "AutoAccept", StringComparison.OrdinalIgnoreCase);

    // R13 — the has-address test and the "City, State Pincode" assembly moved into AddressCard, which now owns
    // both the customer base address and the per-line warehouse rendering.

    // R13 — per-line warehouse: the ERP code as a chip, with the full snapshotted receiving address behind the
    // shared AddressCard disclosure (was a hover title, which showed only the name and was unreachable by
    // keyboard/touch). Aligned to the End edge because Warehouse is the last column.
    private RenderFragment WarehouseCell(PurchaseOrderLineDto line) => builder =>
    {
        if (string.IsNullOrEmpty(line.Warehouse))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "style", "color:var(--mer-ink-500);");
            builder.AddContent(2, "—");
            builder.CloseElement();
            return;
        }

        builder.OpenComponent<AddressCard>(0);
        builder.AddComponentParameter(1, nameof(AddressCard.Title), "Warehouse address");
        builder.AddComponentParameter(2, nameof(AddressCard.TriggerText), line.Warehouse);
        builder.AddComponentParameter(3, nameof(AddressCard.Chip), true);
        builder.AddComponentParameter(4, nameof(AddressCard.Align), AddressCard.AddressAlign.End);
        builder.AddComponentParameter(5, nameof(AddressCard.Name), line.WarehouseAddressName);
        builder.AddComponentParameter(6, nameof(AddressCard.Code), line.WarehouseErpCode);
        builder.AddComponentParameter(7, nameof(AddressCard.Line1), line.WarehouseLine1);
        builder.AddComponentParameter(8, nameof(AddressCard.Line2), line.WarehouseLine2);
        builder.AddComponentParameter(9, nameof(AddressCard.City), line.WarehouseCity);
        builder.AddComponentParameter(10, nameof(AddressCard.State), line.WarehouseState);
        builder.AddComponentParameter(11, nameof(AddressCard.Pincode), line.WarehousePincode);
        builder.AddComponentParameter(12, nameof(AddressCard.Country), line.WarehouseCountry);
        builder.CloseComponent();
    };

    private void TabOverview() => tab = "overview";
    private void TabHistory() => tab = "history";

    private bool showAcknowledge = false;
    private bool showAccept = false;
    private bool showReject = false;
    private bool acceptConfirmed = false;   // req 2 — explicit confirm gate on the Accept dialog
    private string dialogNotes = string.Empty;
    private string rejectionReason = string.Empty;
    private string dialogError = string.Empty;

    // ---------------- Negotiation (req 1 + 3 + 4) ----------------
    // Inline editable line grid state. `edits` is keyed by PurchaseOrderLineId and seeded from the live PO
    // line (OrderQty / DeliveryDate); on submit we POST only the lines whose Qty OR DeliveryDate changed.
    private sealed class LineEdit
    {
        public decimal OriginalQty;
        public DateTime? OriginalDate;
        public decimal OriginalPrice;
        public decimal Qty;
        public DateTime? DeliveryDate;
        public decimal Price;
        public bool Changed => Qty != OriginalQty || DeliveryDate != OriginalDate || Price != OriginalPrice;
    }
    private bool negotiating = false;
    private string negotiationNotes = string.Empty;
    private string negotiationError = string.Empty;
    private Dictionary<Guid, LineEdit> edits = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        var resp = await Api.GetAsync<PurchaseOrderDetailDto>($"api/purchase-orders/{Id}");
        detail = resp?.Data;
        loading = false;
        // PoResponseMode is read straight off `detail` (see ManualResponse) — no supplier round-trip.
    }

    private void OpenAcknowledge() { dialogNotes = string.Empty; dialogError = string.Empty; showAcknowledge = true; }
    private void OpenAccept() { dialogNotes = string.Empty; dialogError = string.Empty; acceptConfirmed = false; showAccept = true; }
    private void OpenReject() { rejectionReason = string.Empty; dialogError = string.Empty; showReject = true; }

    // ---------------- Negotiation handlers ----------------
    // Enter inline edit mode (req 3): snapshot each line's qty/date so we can diff on submit and discard on cancel.
    private void EnterNegotiation()
    {
        if (detail is null) return;
        negotiationError = string.Empty;
        negotiationNotes = string.Empty;
        edits = detail.Lines.ToDictionary(
            l => l.Id,
            l => new LineEdit { OriginalQty = l.OrderQty, OriginalDate = l.DeliveryDate, OriginalPrice = l.PriceUnit, Qty = l.OrderQty, DeliveryDate = l.DeliveryDate, Price = l.PriceUnit });
        negotiating = true;
    }

    // Discard local edits, no API call (req 3).
    private void CancelEdit()
    {
        negotiating = false;
        edits = new();
        negotiationNotes = string.Empty;
        negotiationError = string.Empty;
    }

    private async Task SubmitNegotiation()
    {
        if (detail is null) return;
        var changed = edits
            .Where(kv => kv.Value.Changed)
            .Select(kv => new PoNegotiationLineInput(kv.Key, kv.Value.Qty, kv.Value.DeliveryDate, kv.Value.Price))
            .ToList();

        if (changed.Count == 0) { negotiationError = "Change at least one line's quantity, delivery date or price before submitting."; return; }
        if (changed.Any(l => l.NegotiatedQty <= 0)) { negotiationError = "Negotiated quantity must be greater than zero."; return; }
        if (changed.Any(l => l.NegotiatedPrice < 0)) { negotiationError = "Negotiated price cannot be negative."; return; }

        busy = true; negotiationError = string.Empty;
        var req = new CreatePoNegotiationRequest(detail.Id, string.IsNullOrWhiteSpace(negotiationNotes) ? null : negotiationNotes.Trim(), changed);
        var resp = await Api.PostAsync<PoNegotiationDto, CreatePoNegotiationRequest>("api/purchase-orders/negotiations", req);
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Negotiation submitted", Detail = "The buyer will review your proposed changes." });
            CancelEdit();
            await Load();   // PO now shows "Negotiation"
        }
        else
        {
            negotiationError = resp?.Errors?.FirstOrDefault() ?? "Failed to submit negotiation.";
        }
        busy = false;
    }

    // Withdraw the open negotiation (req 3 / state machine). Needs the open negotiation's id, which we look up
    // from the supplier's own Submitted list filtered to this PO, then POST .../{id}/cancel.
    private async Task CancelNegotiation()
    {
        if (detail is null) return;
        busy = true;
        var list = await Api.GetAsync<List<PoNegotiationListItemDto>>("api/purchase-orders/negotiations?status=Submitted");
        var open = list?.Data?.FirstOrDefault(n => string.Equals(n.PoNumber, detail.PoNumber, StringComparison.OrdinalIgnoreCase));
        if (open is null)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Could not cancel", Detail = "No open negotiation found for this PO.", Duration = 6000 });
            await Load();
            busy = false;
            return;
        }
        var resp = await Api.PostAsync<object?>($"api/purchase-orders/negotiations/{open.Id}/cancel", new { });
        if (resp?.Success == true)
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Negotiation cancelled", Detail = "The PO reverted to its previous status." });
        }
        else
        {
            Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Could not cancel", Detail = resp?.Errors?.FirstOrDefault() ?? "Cancel failed.", Duration = 6000 });
        }
        await Load();
        busy = false;
    }

    private async Task DoAcknowledge()
    {
        busy = true; dialogError = string.Empty;
        var resp = await Api.PostAsync<PurchaseOrderDetailDto, AcknowledgePoRequest>($"api/purchase-orders/{Id}/acknowledge", new AcknowledgePoRequest(string.IsNullOrWhiteSpace(dialogNotes) ? null : dialogNotes));
        if (resp?.Success == true) { Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Acknowledged" }); showAcknowledge = false; await Load(); }
        else { dialogError = resp?.Errors?.FirstOrDefault() ?? "Failed."; }
        busy = false;
    }

    private async Task DoAccept()
    {
        busy = true; dialogError = string.Empty;
        // R4 (2026-06-26) — D2: accept is accept-only (no proposed date).
        var req = new AcceptPoRequest(string.IsNullOrWhiteSpace(dialogNotes) ? null : dialogNotes);
        var resp = await Api.PostAsync<PurchaseOrderDetailDto, AcceptPoRequest>($"api/purchase-orders/{Id}/accept", req);
        if (resp?.Success == true) { Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Accepted" }); showAccept = false; await Load(); }
        else { dialogError = resp?.Errors?.FirstOrDefault() ?? "Failed."; }
        busy = false;
    }

    private async Task DoReject()
    {
        if (string.IsNullOrWhiteSpace(rejectionReason)) { dialogError = "Reason is required."; return; }
        busy = true; dialogError = string.Empty;
        var resp = await Api.PostAsync<PurchaseOrderDetailDto, RejectPoRequest>($"api/purchase-orders/{Id}/reject", new RejectPoRequest(rejectionReason));
        if (resp?.Success == true) { Notif.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Rejected" }); showReject = false; await Load(); }
        else { dialogError = resp?.Errors?.FirstOrDefault() ?? "Failed."; }
        busy = false;
    }

    private string StatusClass(string status) => status switch
    {
        "Accepted" or "Delivered" or "Closed" or "Approved" => "tlg-status--active",
        "Released" or "Acknowledged" or "PartiallyDelivered" or "Negotiation" => "tlg-status--pending",
        "Rejected" or "Cancelled" => "tlg-status--danger",
        _ => "tlg-status--info"
    };

    // R4 (2026-06-26) — Phase 5b / §7.3 + §5.3 / DI-04: render the NOMINAL balance and the over-ship ALLOWANCE
    // separately (so a 0 balance with an accepted over-ship headroom never reads inconsistent), plus the
    // "qty reduced below shipped" exception flag (UC-ASN-10).
    private RenderFragment BalanceCell(PurchaseOrderLineDto line) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style", "display:flex;flex-direction:column;gap:2px;font-family:Inter,monospace;");

        builder.OpenElement(seq++, "span");
        builder.AddContent(seq++, $"Balance {line.Balance.ToString("0.###")}");
        builder.CloseElement();

        var extra = line.OverShipAllowance - line.Balance;
        if (extra > 0)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "font-size:10.5px;color:var(--mer-ink-500);");
            builder.AddContent(seq++, $"over-ship allowance up to {line.OverShipAllowance.ToString("0.###")}");
            builder.CloseElement();
        }

        if (line.IsOverShippedQtyReduced)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "tlg-status tlg-status--danger");
            builder.AddAttribute(seq++, "title", "Order qty was revised below the quantity already shipped");
            builder.AddAttribute(seq++, "style", "font-family:'Plus Jakarta Sans',sans-serif;width:fit-content;margin-top:2px;");
            builder.AddContent(seq++, "qty reduced below shipped");
            builder.CloseElement();
        }

        builder.CloseElement();
    };
}
