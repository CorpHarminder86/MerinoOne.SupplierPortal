@page "/delivery-schedules"
@inject ApiClient Api
@inject TokenAccessor Token
@inject NavigationManager Nav

@* R5 (TSD R5 Addendum §7 / §8.3 — Component 4, Delivery Schedule grid). The supplier's ASN-creation surface:
   one row per open PO line, showing PO number + position + item + order qty + warehouse + remaining-to-ship.
   R15 — sorted CreatedOn DESC (newest schedules first; server-side).
   Permission: DeliverySchedule.Read (supplier-facing). All hex via var(--mer-*) tokens; Merino .tl-page shell.

   R13 — ship-to is retired; the PO line's warehouse (resolving to a CompanyAddress) is the receiving address AND the
   ASN grouping key. Filters (§7): supplier, warehouse, PO, delivery-date range, status. The Warehouse filter AUTO-HIDES
   when only one warehouse is present — the backend computes DistinctWarehouseCount + ShowWarehouseFilter across the
   supplier's visible schedules (BEFORE the warehouse filter), mirroring the single-supplier filter auto-hide.

   R15 (D3) — "Create ASN" no longer raises an instant server Draft via api/asns/from-schedule: it deep-links to
   /asns/new?supplier=<id>&schedules=<ids> where the same lines arrive PRE-CHECKED in the wizard's step-1 grid
   (warehouse auto-locked) and nothing exists server-side until the supplier saves. One code path for both flows. *@

<PageTitle>Delivery Schedules</PageTitle>

<div class="tl-page">
    <header class="tl-header">
        <div>
            <div class="tl-title-row">
                <h1 class="tl-title">Delivery Schedules</h1>
                <span class="tl-count-chip">@(grid?.Page.TotalCount ?? 0)</span>
            </div>
            <p class="tl-sub">Open PO lines ready to ship — pick lines here to raise an ASN</p>
        </div>
        <div class="tl-header__actions">
            @* R5 Phase 4 (§9.1) — multi-select → Create ASN. Enabled once ≥1 line is selected. Selection is constrained
               to a SINGLE warehouse in the UI (§9.1 / UC-AS-02): the first selected line fixes the warehouse and rows for
               other warehouses are disabled; the server invariant (§9.3) is the authoritative fallback. *@
            @if (CanCreateAsn)
            {
                <button class="mbtn mbtn--primary"
                        disabled="@(selected.Count == 0)"
                        title="@(selected.Count == 0 ? "Select one or more lines sharing a single warehouse" : $"Create an ASN from {selected.Count} selected line(s)")"
                        @onclick="OpenCreateAsn">
                    <span class="material-symbols-outlined">local_shipping</span> Create ASN@(selected.Count > 0 ? $" ({selected.Count})" : "")
                </button>
            }
        </div>
    </header>

    <div class="tl-filter-bar" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        @* Supplier filter — only when the signed-in user can act for more than one supplier (multi-mapped
           supplier login / internal user). Single-supplier users don't need it; the grid is seccode-scoped. *@
        @if (suppliers.Count > 1)
        {
            <select class="rz-dropdown" style="padding:8px 12px;border:1px solid var(--mer-ink-300);border-radius:6px;background:var(--mer-surface);min-width:220px;" @bind="supplierFilter" @bind:after="OnSupplierChanged">
                <option value="">All suppliers</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s.Id">@s.LegalName (@s.SupplierCode)</option>
                }
            </select>
        }

        @* Warehouse filter — AUTO-HIDDEN when only one warehouse is present (backend ShowWarehouseFilter /
           DistinctWarehouseCount ≤ 1). Mirrors the single-supplier auto-hide above: render only when >1 to pick. *@
        @if (showWarehouseFilter && warehouseOptions.Count > 1)
        {
            <select class="rz-dropdown" style="padding:8px 12px;border:1px solid var(--mer-ink-300);border-radius:6px;background:var(--mer-surface);min-width:200px;" @bind="warehouseFilter" @bind:after="OnFilterChanged">
                <option value="">All warehouses</option>
                @foreach (var wh in warehouseOptions)
                {
                    <option value="@wh.Id">@wh.Name</option>
                }
            </select>
        }

        @* PO filter — the backend accepts a PO id (purchaseOrderId), not free text, so this is a dropdown built
           from the visible POs (collected in the same unfiltered sweep as the warehouse options). *@
        @if (poOptions.Count > 1)
        {
            <select class="rz-dropdown" style="padding:8px 12px;border:1px solid var(--mer-ink-300);border-radius:6px;background:var(--mer-surface);min-width:160px;" @bind="poFilter" @bind:after="OnFilterChanged">
                <option value="">All POs</option>
                @foreach (var po in poOptions)
                {
                    <option value="@po.Id">@po.Number</option>
                }
            </select>
        }

        <label style="font-size:12px;color:var(--mer-ink-600);display:inline-flex;align-items:center;gap:6px;">
            From
            <input type="date" class="rz-textbox" style="padding:7px 10px;" @bind="dateFrom" @bind:after="OnFilterChanged" />
        </label>
        <label style="font-size:12px;color:var(--mer-ink-600);display:inline-flex;align-items:center;gap:6px;">
            To
            <input type="date" class="rz-textbox" style="padding:7px 10px;" @bind="dateTo" @bind:after="OnFilterChanged" />
        </label>

        <select class="rz-dropdown" style="padding:8px 12px;border:1px solid var(--mer-ink-300);border-radius:6px;background:var(--mer-surface);" @bind="statusFilter" @bind:after="OnFilterChanged">
            <option value="">All statuses</option>
            <option value="Approved">Approved</option>
        </select>

        @* 2026-08-11 — balance filter, DEFAULT ON: a fully-shipped line cannot be put on an ASN, so it is noise on
           the ASN-creation surface. Server-side (the grid is paged) — see DeliveryScheduleFilterRequest. *@
        <label style="font-size:12px;color:var(--mer-ink-600);display:inline-flex;align-items:center;gap:6px;cursor:pointer;"
               title="Hide lines with nothing left to ship">
            <input type="checkbox" @bind="onlyWithBalance" @bind:after="OnBalanceFilterChanged" />
            Only with balance
        </label>

        @if (HasActiveFilter)
        {
            <button type="button" @onclick="ClearFilters"
                    style="display:inline-flex;align-items:center;gap:5px;background:transparent;border:1px solid var(--mer-ink-300);border-radius:6px;padding:7px 12px;color:var(--mer-ink-600);cursor:pointer;font-size:12px;">
                <span class="material-symbols-outlined" style="font-size:15px;">close</span> Clear
            </button>
        }
    </div>

    @* R5 Phase 4 (§9.1) — single-warehouse selection banner. Once a line is selected the warehouse is locked and rows
       for other warehouses are disabled, so the supplier can only build a single-warehouse ASN. The banner names the
       locked warehouse + the selection count, and offers a quick Clear. *@
    @if (CanCreateAsn && selected.Count > 0)
    {
        <div class="rz-card" style="padding:10px 14px;margin-bottom:12px;display:flex;align-items:center;gap:12px;background:var(--mer-blue-50);border:1px solid var(--mer-blue);">
            <span class="material-symbols-outlined" style="font-size:20px;color:var(--mer-blue);">checklist</span>
            <div style="flex:1;font-size:12.5px;color:var(--mer-blue-darker);">
                <b>@selected.Count</b> line(s) selected · warehouse <b>@(selectedWarehouseName ?? "—")</b>
                <span style="color:var(--mer-ink-500);"> — rows with a different warehouse are locked until you clear the selection.</span>
            </div>
            <button type="button" @onclick="ClearSelection"
                    style="display:inline-flex;align-items:center;gap:5px;background:transparent;border:1px solid var(--mer-blue);border-radius:6px;padding:6px 10px;color:var(--mer-blue);cursor:pointer;font-size:12px;">
                <span class="material-symbols-outlined" style="font-size:15px;">close</span> Clear
            </button>
        </div>
    }

    @if (loading)
    {
        <div class="tl-empty">Loading…</div>
    }
    else if (grid == null || grid.Page.Items.Count == 0)
    {
        <div class="tl-empty">
            <span class="material-symbols-outlined" style="font-size:32px;">event</span>
            <div>No delivery schedules match.</div>
        </div>
    }
    else
    {
        var gridStyle = $"--tl-cols: {(CanCreateAsn ? "44px " : "")}140px 70px 1.4fr 130px 100px 110px 110px 1fr 130px 110px; --tl-min-width: {(CanCreateAsn ? "1324px" : "1280px")};";
        <div class="tl-grid-wrapper" style="@gridStyle">
            <div class="tlg-header">
                @if (CanCreateAsn)
                {
                    <div class="tlg-col" style="display:flex;align-items:center;justify-content:center;">
                        <input type="checkbox" title="Select all selectable rows on this page" checked="@AllSelectableSelected"
                               @onchange="ToggleSelectAll" />
                    </div>
                }
                <div class="tlg-col">PO #</div>
                <div class="tlg-col tlg-col--num">Line</div>
                <div class="tlg-col">Item</div>
                <div class="tlg-col">Supplier</div>
                <div class="tlg-col tlg-col--num">Order qty</div>
                <div class="tlg-col tlg-col--num">Shipped</div>
                <div class="tlg-col tlg-col--num">Remaining</div>
                @* R13 — warehouse is now the sole receiving-address + ASN grouping key (ship-to retired). *@
                <div class="tlg-col">Warehouse</div>
                <div class="tlg-col">Delivery date</div>
                <div class="tlg-col">Status</div>
            </div>
            @foreach (var r in grid.Page.Items)
            {
                var row = r;
                var isSelected = selected.ContainsKey(row.Id);
                // Row is selectable when it has remaining balance to ship AND (no selection yet OR it matches the
                // locked warehouse). §9.1: cross-warehouse rows are disabled, not silently dropped.
                var warehouseBlocked = selectedWarehouseId.HasValue && row.WarehouseAddressId != selectedWarehouseId.Value;
                // R15 — the deep-linked wizard is supplier-scoped, so a selection also locks the supplier.
                var supplierBlocked = selected.Count > 0 && row.SupplierId != selected.Values.First().SupplierId;
                var noBalance = row.RemainingToShip <= 0;
                // §6.2 — a schedule whose PO is no longer shippable (e.g. reset to Released by an ERP Modify) is not
                // selectable for an ASN; the checkbox is hidden for it (see below).
                var selectable = CanCreateAsn && !noBalance && !warehouseBlocked && !supplierBlocked && row.IsShippable;
                var rowStyle = (isSelected ? "background:var(--mer-blue-50);" : "")
                    + (CanCreateAsn && !selectable && !isSelected ? "opacity:.55;" : "");
                <div class="tlg-row" style="@rowStyle">
                    @if (CanCreateAsn)
                    {
                        <div class="tlg-col" style="display:flex;align-items:center;justify-content:center;">
                            @if (row.IsShippable)
                            {
                                <input type="checkbox" checked="@isSelected" disabled="@(!selectable && !isSelected)"
                                       title="@(noBalance ? "Nothing left to ship on this line" : warehouseBlocked ? "Different warehouse — clear the selection to pick this one" : supplierBlocked ? "Different supplier — an ASN ships from one supplier" : null)"
                                       @onchange="() => ToggleRow(row)" />
                            }
                            else
                            {
                                @* §6.2 — PO not shippable (unconfirmed / reset to Released): no ASN checkbox. *@
                                <span class="material-symbols-outlined" style="font-size:15px;color:var(--mer-ink-400);"
                                      title="PO not confirmed — re-accept the PO before shipping this schedule">block</span>
                            }
                        </div>
                    }
                    <div class="tlg-col tlg-code">@row.PoNumber</div>
                    <div class="tlg-col tlg-col--num">@row.PositionNo</div>
                    <div class="tlg-col tlg-name">
                        <span style="font-weight:600;color:var(--mer-blue-darker);">@row.ItemCode</span>
                        @if (!string.IsNullOrWhiteSpace(row.ItemDescription))
                        {
                            <span style="color:var(--mer-ink-500);"> — @row.ItemDescription</span>
                        }
                    </div>
                    <div class="tlg-col tlg-name">@(string.IsNullOrEmpty(row.SupplierName) ? "—" : row.SupplierName)</div>
                    <div class="tlg-col tlg-col--num tlg-code">@row.OrderQty.ToString("N2") <span style="color:var(--mer-ink-500);">@row.OrderUnit</span></div>
                    <div class="tlg-col tlg-col--num tlg-code">@row.ShippedQtyToDate.ToString("N2")</div>
                    <div class="tlg-col tlg-col--num tlg-code" style="font-weight:600;color:@(row.RemainingToShip > 0 ? "var(--mer-blue-darker)" : "var(--mer-ink-400)");">@row.RemainingToShip.ToString("N2")</div>
                    <div class="tlg-col tlg-code" title="@row.WarehouseAddressName">@(string.IsNullOrWhiteSpace(row.Warehouse) ? "—" : row.Warehouse)</div>
                    <div class="tlg-col tlg-code">@AppTime.Date(row.DeliveryDate)</div>
                    <div class="tlg-col"><span class="tlg-status @StatusClass(row.Status)">@row.Status</span></div>
                </div>
            }
        </div>

        <Pager Page="page" PageSize="PageSize" TotalCount="grid.Page.TotalCount" PageChanged="OnPageChanged" />
    }
</div>

@* R15 (D3) — the §9.2 instant-draft dialog is retired; Create ASN deep-links into the wizard (see OpenCreateAsn). *@

@code {
    private DeliveryScheduleGridDto? grid;
    private List<SupplierListItemDto> suppliers = new();
    private bool loading = true;

    // Filters (§7).
    private string supplierFilter = string.Empty;
    private string warehouseFilter = string.Empty;
    private string poFilter = string.Empty;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string statusFilter = string.Empty;
    // 2026-08-11 — defaults ON, so "active filter" means the user turned it OFF (else Clear would always show).
    private bool onlyWithBalance = true;

    private int page = 1;
    private const int PageSize = 50;

    // Warehouse auto-hide state. The backend's ShowWarehouseFilter / DistinctWarehouseCount is the authoritative signal
    // (it counts distinct warehouses across the supplier's visible schedules BEFORE the warehouse filter). We still
    // need the option list to populate the dropdown; we collect it from an unfiltered sweep on init/supplier-change.
    private bool showWarehouseFilter;
    private readonly List<WarehouseOption> warehouseOptions = new();
    private sealed record WarehouseOption(Guid Id, string Name);

    // PO option set (the backend filters by PO id, not free text). Built in the same unfiltered sweep.
    private readonly List<PoOption> poOptions = new();
    private sealed record PoOption(Guid Id, string Number);

    private bool HasActiveFilter =>
        !string.IsNullOrEmpty(supplierFilter) || !string.IsNullOrEmpty(warehouseFilter)
        || !string.IsNullOrWhiteSpace(poFilter) || dateFrom.HasValue || dateTo.HasValue
        || !string.IsNullOrEmpty(statusFilter) || !onlyWithBalance;

    protected override async Task OnInitializedAsync()
    {
        // Seccode-scoped: a supplier login mapped to several suppliers gets them all; an internal user gets the
        // visible set. Drives the optional supplier filter (rendered only when >1) — same source as PurchaseOrderList.
        var sup = await Api.GetAsync<List<SupplierListItemDto>>("api/suppliers");
        suppliers = sup?.Data ?? new();

        await LoadFilterOptions();
        await Reload();
    }

    /// <summary>
    /// Build the Warehouse + PO dropdown option sets. The grid query returns WarehouseAddressName / PoNumber per row but
    /// pages the data, so a single page may not surface every distinct value. We sweep one unfiltered (apart from the
    /// supplier filter) large page to collect the distinct pairs, then let the backend's ShowWarehouseFilter flag drive
    /// the warehouse auto-hide. Re-run whenever the supplier filter changes (a different supplier may ship elsewhere).
    /// </summary>
    private async Task LoadFilterOptions()
    {
        warehouseOptions.Clear();
        poOptions.Clear();
        var url = $"api/delivery-schedules?page=1&pageSize=500";
        if (!string.IsNullOrEmpty(supplierFilter)) url += $"&supplierId={Uri.EscapeDataString(supplierFilter)}";
        // The balance filter rides along: a warehouse or PO whose every line is fully shipped would otherwise sit in
        // the dropdowns and return an empty grid when picked.
        if (onlyWithBalance) url += "&onlyWithBalance=true";
        var resp = await Api.GetAsync<DeliveryScheduleGridDto>(url);
        var data = resp?.Data;

        // Authoritative auto-hide signal from the backend (§7): hide the Warehouse filter when ≤ 1 warehouse exists.
        showWarehouseFilter = data?.ShowWarehouseFilter ?? false;

        if (data is not null)
        {
            foreach (var pair in data.Page.Items
                         .Where(i => i.WarehouseAddressId.HasValue && !string.IsNullOrEmpty(i.WarehouseAddressName))
                         .Select(i => new WarehouseOption(i.WarehouseAddressId!.Value, i.WarehouseAddressName!))
                         .DistinctBy(o => o.Id)
                         .OrderBy(o => o.Name))
            {
                warehouseOptions.Add(pair);
            }

            foreach (var po in data.Page.Items
                         .Select(i => new PoOption(i.PurchaseOrderId, i.PoNumber))
                         .DistinctBy(o => o.Id)
                         .OrderBy(o => o.Number))
            {
                poOptions.Add(po);
            }
        }
    }

    private async Task Reload()
    {
        loading = true;
        var url = $"api/delivery-schedules?page={page}&pageSize={PageSize}";
        if (!string.IsNullOrEmpty(supplierFilter)) url += $"&supplierId={Uri.EscapeDataString(supplierFilter)}";
        if (!string.IsNullOrEmpty(warehouseFilter)) url += $"&warehouseAddressId={Uri.EscapeDataString(warehouseFilter)}";
        if (!string.IsNullOrEmpty(poFilter)) url += $"&purchaseOrderId={Uri.EscapeDataString(poFilter)}";
        if (dateFrom.HasValue) url += $"&deliveryDateFrom={dateFrom.Value:yyyy-MM-dd}";
        if (dateTo.HasValue) url += $"&deliveryDateTo={dateTo.Value:yyyy-MM-dd}";
        if (!string.IsNullOrEmpty(statusFilter)) url += $"&status={Uri.EscapeDataString(statusFilter)}";
        if (onlyWithBalance) url += "&onlyWithBalance=true";
        var resp = await Api.GetAsync<DeliveryScheduleGridDto>(url);
        grid = resp?.Data;
        loading = false;
    }

    private async Task OnFilterChanged()
    {
        page = 1;
        await Reload();
    }

    // The balance filter changes the option UNIVERSE too (a PO whose every line is shipped drops out of the
    // dropdown), so it refreshes the option sweep as well — unlike the other filters, which only narrow the grid.
    private async Task OnBalanceFilterChanged()
    {
        page = 1;
        await LoadFilterOptions();
        await Reload();
    }

    // Supplier change can change the warehouse universe → refresh the option set + re-evaluate the auto-hide,
    // and reset a now-irrelevant warehouse selection before reloading.
    private async Task OnSupplierChanged()
    {
        page = 1;
        warehouseFilter = string.Empty;
        poFilter = string.Empty;
        await LoadFilterOptions();
        await Reload();
    }

    private async Task ClearFilters()
    {
        supplierFilter = string.Empty;
        warehouseFilter = string.Empty;
        poFilter = string.Empty;
        dateFrom = null;
        dateTo = null;
        statusFilter = string.Empty;
        onlyWithBalance = true;   // Clear resets to the DEFAULT, which is on — not to "unfiltered".
        page = 1;
        await LoadFilterOptions();
        await Reload();
    }

    private async Task OnPageChanged(int newPage) { page = newPage; await Reload(); }

    // ============================ R5 Phase 4 (§9) — multi-select → Create ASN ============================

    // Only the ASN-creating actors get the selection column at all. Same gate as the "New ASN" affordance on the
    // ASN list (supplier acts for themselves; an internal Buyer/Admin has Asn.Write). A read-only user sees no
    // checkboxes — the grid stays a pure read surface for them.
    private bool CanCreateAsn => Token.IsSupplier || Token.HasPermission("Asn.Write");

    // Selected schedule rows, keyed by DeliverySchedule.Id (the id CreateAsnFromScheduleCommand consumes). We keep the
    // whole DTO so the dialog can show the warehouse label + count without a re-fetch, and so a selection survives
    // paging (the checkbox reflects membership in this map, not a per-page list).
    private readonly Dictionary<Guid, DeliveryScheduleDto> selected = new();

    // §9.1 single-warehouse lock: the first selected line fixes the warehouse; every other row for a different
    // warehouse is disabled until the selection is cleared. Null when nothing is selected.
    private Guid? selectedWarehouseId => selected.Values.Select(s => s.WarehouseAddressId).FirstOrDefault();
    private string? selectedWarehouseName => selected.Values.Select(s => s.WarehouseAddressName).FirstOrDefault();

    // "Select all" reflects only the rows on THIS page that are currently selectable (have balance + shippable +
    // match the locked warehouse/supplier) plus those already selected — so the header box never claims to cover
    // disabled rows. (R15 — IsShippable + the supplier lock joined the filter so select-all mirrors the row rule.)
    private IEnumerable<DeliveryScheduleDto> SelectablePageRows =>
        grid?.Page.Items.Where(r => r.RemainingToShip > 0
            && r.IsShippable
            && (!selectedWarehouseId.HasValue || r.WarehouseAddressId == selectedWarehouseId.Value)
            && (selected.Count == 0 || r.SupplierId == selected.Values.First().SupplierId)) ?? Enumerable.Empty<DeliveryScheduleDto>();

    private bool AllSelectableSelected =>
        SelectablePageRows.Any() && SelectablePageRows.All(r => selected.ContainsKey(r.Id));

    private void ToggleRow(DeliveryScheduleDto row)
    {
        if (selected.Remove(row.Id)) return;                 // deselect
        if (row.RemainingToShip <= 0) return;                // nothing to ship
        if (selectedWarehouseId.HasValue && row.WarehouseAddressId != selectedWarehouseId.Value) return; // cross-warehouse guard
        // R15 — one ASN ships from ONE supplier; the deep-linked wizard is supplier-scoped, so the first pick
        // locks the supplier too (an internal user's grid can mix suppliers within one warehouse name).
        if (selected.Count > 0 && row.SupplierId != selected.Values.First().SupplierId) return;
        selected[row.Id] = row;
    }

    private void ToggleSelectAll()
    {
        var pageRows = SelectablePageRows.ToList();
        if (pageRows.All(r => selected.ContainsKey(r.Id)))
            foreach (var r in pageRows) selected.Remove(r.Id);     // all selected → clear this page
        else
            foreach (var r in pageRows) selected[r.Id] = r;        // else select the selectable page rows
    }

    private void ClearSelection() => selected.Clear();

    // ---- R15 (D3) — Create ASN: deep-link into the wizard, no instant server draft ----
    // The wizard (/asns/new) re-loads the supplier's Approved schedules, pre-checks these ids (its own guards
    // re-apply: balance, shippable, single warehouse) and lands on Quantities. Nothing is persisted until Save,
    // so backing out of the wizard leaves no orphan Draft — and both creation flows share one code path.
    private void OpenCreateAsn()
    {
        if (selected.Count == 0) return;
        var supplierId = selected.Values.First().SupplierId;
        var ids = string.Join(",", selected.Keys);
        Nav.NavigateToRoute($"/asns/new?supplier={supplierId}&schedules={ids}");
    }

    private string StatusClass(string status) => status switch
    {
        "Approved" => "tlg-status--active",
        "Proposed" => "tlg-status--pending",
        "Rejected" or "Cancelled" => "tlg-status--danger",
        _ => "tlg-status--info"
    };
}
